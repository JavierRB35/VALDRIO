  </ItemGroup>
  <ItemGroup>
    <Content Include="../../Synthetic Projects/**/*.csv"
             Link="Synthetic Projects/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
