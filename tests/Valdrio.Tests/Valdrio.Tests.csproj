    <Compile Include="../../src/Valdrio.Desktop/EditableGridTabOrder.cs" Link="Desktop/EditableGridTabOrder.cs" />
    <Content Include="../../docs/help/help-map.json" Link="help/help-map.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/help/*.md" Link="help/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/help/en/*.md" Link="help/en/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
