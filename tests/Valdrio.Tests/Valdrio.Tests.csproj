             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../reference/t02a-fx-cases.json"
             Link="reference/t02a-fx-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../specification/v0.4/casos/casos_metodologicos.json"
             Link="reference/t10-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/t04-upgraded-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t07-v8.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t04-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t05-v3.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-period-v4.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06a-v7.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06a-v6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-v5.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-v4.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t03-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-csv-es-v1.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-xlsx-1900-v1.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-xlsx-1904-v1.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep subprocess tests on the same build configuration, including Visual Studio Debug. -->
  <Target Name="CopyRunnerForTests" AfterTargets="Build">
    <ItemGroup>
      <RunnerOutput Include="../../src/Valdrio.Runner/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerOutput)" DestinationFiles="@(RunnerOutput->'$(OutDir)runner/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
