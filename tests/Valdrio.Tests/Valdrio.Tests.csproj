<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="../../src/Valdrio.Desktop/WorkspaceGuidance.cs" Link="Desktop/WorkspaceGuidance.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Valdrio.Desktop/CompanyFileViewModel.cs" Link="Desktop/CompanyFileViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/CompanyFileDialogs.cs" Link="Desktop/CompanyFileDialogs.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ModelWorkspaceViewModel.StudyNodes.cs" Link="Desktop/ModelWorkspaceViewModel.StudyNodes.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ModelWorkspaceViewModel.cs" Link="Desktop/ModelWorkspaceViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/StudyWorkspaceViewModel.cs" Link="Desktop/StudyWorkspaceViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/MainWindowViewModel.cs" Link="Desktop/MainWindowViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ImportColumnMappingViewModel.cs" Link="Desktop/ImportColumnMappingViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ImportColumnMappingViewModel.Confirmation.cs" Link="Desktop/ImportColumnMappingViewModel.Confirmation.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ImportColumnMappingViewModel.Conversion.cs" Link="Desktop/ImportColumnMappingViewModel.Conversion.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ImportColumnMappingViewModel.Accounts.cs" Link="Desktop/ImportColumnMappingViewModel.Accounts.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ResourceEditorForm.cs" Link="Desktop/ResourceEditorForm.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.cs" Link="Desktop/AllocationWorkspaceViewModel.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.Primary.cs" Link="Desktop/AllocationWorkspaceViewModel.Primary.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.PrimaryExplain.cs" Link="Desktop/AllocationWorkspaceViewModel.PrimaryExplain.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.PrincipalOrigins.cs" Link="Desktop/AllocationWorkspaceViewModel.PrincipalOrigins.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.Batch.cs" Link="Desktop/AllocationWorkspaceViewModel.Batch.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.Reciprocal.cs" Link="Desktop/AllocationWorkspaceViewModel.Reciprocal.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.Secondary.cs" Link="Desktop/AllocationWorkspaceViewModel.Secondary.cs" />
    <Compile Include="../../src/Valdrio.Desktop/SecondaryResultPresentation.cs" Link="Desktop/SecondaryResultPresentation.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationCurrencyDisplay.cs" Link="Desktop/AllocationCurrencyDisplay.cs" />
    <Compile Include="../../src/Valdrio.Desktop/AllocationWorkspaceViewModel.Composition.cs" Link="Desktop/AllocationWorkspaceViewModel.Composition.cs" />
    <Compile Include="../../src/Valdrio.Desktop/ResourceWorkspaceViewModel*.cs" Link="Desktop/%(Filename)%(Extension)" />
    <Compile Include="../../src/Valdrio.Desktop/WorkspaceDialogContracts.cs" Link="Desktop/WorkspaceDialogContracts.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Valdrio.Runner/Valdrio.Runner.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Valdrio.Domain/Valdrio.Domain.csproj" />
    <ProjectReference Include="../../src/Valdrio.Calculation/Valdrio.Calculation.csproj" />
    <ProjectReference Include="../../src/Valdrio.Application/Valdrio.Application.csproj" />
    <ProjectReference Include="../../src/Valdrio.Infrastructure/Valdrio.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Valdrio.Localization/Valdrio.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../Synthetic Projects/**/*.csv"
             Link="Synthetic Projects/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Synthetic Projects/**/*.json"
             Link="Synthetic Projects/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../reference/t02-rounding-cases.json"
             Link="reference/t02-rounding-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../reference/currency-catalog-example.json"
             Link="reference/currency-catalog-example.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../reference/t02a-fx-cases.json"
             Link="reference/t02a-fx-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../specification/v0.4/casos/casos_metodologicos.json"
             Link="reference/t10-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/t04-upgraded-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t07-v8.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t04-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t05-v3.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-period-v4.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06a-v7.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06a-v6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-v5.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-v4.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t03-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-csv-es-v1.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-xlsx-1900-v1.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/t06-xlsx-1904-v1.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep subprocess tests on the same build configuration, including Visual Studio Debug. -->
  <Target Name="CopyRunnerForTests" AfterTargets="Build">
    <ItemGroup>
      <RunnerOutput Include="../../src/Valdrio.Runner/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerOutput)" DestinationFiles="@(RunnerOutput->'$(OutDir)runner/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
