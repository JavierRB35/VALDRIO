<Application x:Class="Valdrio.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Valdrio.Desktop"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ValdrioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="local:StickyTableHeaders.Enabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
