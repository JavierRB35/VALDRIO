<local:IntegratedWorkspaceWindow xmlns:local="clr-namespace:Valdrio.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Valdrio.Desktop.PhysicalActivityWindow"
        Title="{Binding Title}" Height="780" Width="1180" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <local:IntegratedWorkspaceWindow.Resources>
  <Style x:Key="ActivityCell" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6,4"/>
  </Style>
  <Style x:Key="ActivityNumber" TargetType="TextBlock" BasedOn="{StaticResource ActivityCell}">
   <Setter Property="TextAlignment" Value="Right"/>
  </Style>
 </local:IntegratedWorkspaceWindow.Resources>
 <Grid Margin="16,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <ScrollViewer x:Name="PageScroll" Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
  <StackPanel Margin="0,0,0,6">
   <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <Border Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Soft}"
           BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,6,0,2">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="{Binding ProjectLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="12,0">
      <TextBlock Text="{Binding StudyLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding StudyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="{Binding PeriodLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding StudyPeriod}" FontWeight="SemiBold"/>
     </StackPanel>
    </Grid>
   </Border>
   <DockPanel Margin="0,4,0,2" LastChildFill="False">
    <TextBlock DockPanel.Dock="Left" Text="{Binding StudyLabel}" VerticalAlignment="Center"
               Margin="0,0,12,0"/>
    <ComboBox x:Name="StudySelector" DockPanel.Dock="Left" Width="425"
              ItemsSource="{Binding StudyChoices}" DisplayMemberPath="Label"
              SelectionChanged="StudySelectionChanged" IsTextSearchEnabled="True"
              TextSearch.TextPath="Label" AutomationProperties.Name="{Binding StudyLabel}"/>
   </DockPanel>
   <TextBlock Text="{Binding AnalysisContext}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding PendingRowsSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>

  <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="ActivityTable" ItemsSource="{Binding Rows}"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
            HeadersVisibility="Column" RowHeaderWidth="0"
            IsReadOnly="True" SelectionMode="Single"
            HorizontalScrollBarVisibility="Auto"
            AutomationProperties.Name="{Binding Title}">
   <DataGrid.Columns>
    <DataGridTextColumn x:Name="NodeColumn" Binding="{Binding Node}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource ActivityCell}"/>
    <DataGridTextColumn x:Name="UnitColumn" Binding="{Binding Unit}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource ActivityCell}"/>
    <DataGridTextColumn x:Name="NormalColumn" Binding="{Binding NormalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource ActivityNumber}"/>
    <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Button AutomationProperties.Name="{Binding DataContext.CalculatorLabel,RelativeSource={RelativeSource AncestorType=DataGrid}}"
              ToolTip="{Binding DataContext.NormalMethodLabel,RelativeSource={RelativeSource AncestorType=DataGrid}}"
              IsEnabled="{Binding DataContext.IsWritable,RelativeSource={RelativeSource AncestorType=DataGrid}}"
              Click="AssistNormal" Padding="6,4" Margin="2" MinWidth="32" Width="32">
       <Path Width="16" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
             StrokeThickness="1.4" Data="M2,1 L14,1 14,19 2,19 Z M5,4 L11,4 11,7 5,7 Z M5,10 L7,10 M9,10 L11,10 M5,13 L7,13 M9,13 L11,13 M5,16 L7,16 M9,16 L11,16"/>
      </Button>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn x:Name="RealColumn" Binding="{Binding RealText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource ActivityNumber}"/>
    <DataGridTextColumn x:Name="UtilizationColumn" Binding="{Binding Utilization}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource ActivityNumber}"/>
    <DataGridTextColumn x:Name="CostColumn" Binding="{Binding Cost}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource ActivityCell}"/>
    <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Status}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource ActivityCell}"/>
   </DataGrid.Columns>
  </DataGrid>
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3">
   <TextBlock Text="{Binding SelectionHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Feedback}"
              TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
   <WrapPanel>
    <Button Content="{Binding PhysicalImportLabel}" Click="OpenPhysicalImport" Margin="0,0,8,0" IsEnabled="{Binding IsWritable}"/>
    <Button Content="{Binding SaveDraftLabel}" Click="SaveDraft" IsEnabled="{Binding CanSaveDraft}" Margin="0,0,8,0"/>
    <Button Content="{Binding ConfirmLabel}" Click="Confirm" IsEnabled="{Binding CanConfirm}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="{Binding AnnulLabel}" Click="Annul" IsEnabled="{Binding IsWritable}" Margin="0,0,8,0"/>
    <Button Content="{Binding HistoryLabel}" Click="History" Margin="0,0,8,0"/>
    <Button Content="{Binding CloseLabel}" IsCancel="True" Click="CloseWindow"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</local:IntegratedWorkspaceWindow>
