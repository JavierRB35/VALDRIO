<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Valdrio.Desktop.PhysicalActivityWindow"
        Title="{Binding Title}" Height="780" Width="1180" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <Border Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Soft}"
           BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,6">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="{Binding ProjectLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="12,0">
      <TextBlock Text="{Binding StudyLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding StudyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="{Binding PeriodLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
      <TextBlock Text="{Binding StudyPeriod}" FontWeight="SemiBold"/>
     </StackPanel>
    </Grid>
   </Border>
   <DockPanel Margin="0,7,0,4" LastChildFill="False">
    <TextBlock DockPanel.Dock="Left" Text="{Binding StudyLabel}" VerticalAlignment="Center"
               Margin="0,0,12,0"/>
    <ComboBox x:Name="StudySelector" DockPanel.Dock="Left" Width="425"
              ItemsSource="{Binding StudyChoices}" DisplayMemberPath="Label"
              SelectionChanged="StudySelectionChanged" IsTextSearchEnabled="True"
              TextSearch.TextPath="Label" AutomationProperties.Name="{Binding StudyLabel}"/>
   </DockPanel>
   <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <DataGrid x:Name="ActivityTable" Grid.Row="1" ItemsSource="{Binding Rows}"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
            HeadersVisibility="Column" RowHeaderWidth="0"
            IsReadOnly="{Binding IsReadOnly}" SelectionMode="Single"
            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="{Binding Title}">
   <DataGrid.Columns>
    <DataGridTextColumn x:Name="NodeColumn" Binding="{Binding Node}" IsReadOnly="True" Width="2*"/>
    <DataGridTextColumn x:Name="UnitColumn" Binding="{Binding Unit}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn x:Name="NormalColumn" Binding="{Binding NormalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridTextColumn x:Name="RealColumn" Binding="{Binding RealText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    <DataGridTextColumn x:Name="UtilizationColumn" Binding="{Binding Utilization}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn x:Name="CostColumn" Binding="{Binding Cost}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <ScrollViewer Grid.Row="2" Height="252" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
   <StackPanel IsEnabled="{Binding IsWritable}">
    <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,12,0">
      <TextBlock Text="{Binding NormalLabel}"/>
      <TextBox Text="{Binding SelectedRow.NormalSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding SourceLabel}"/>
      <ComboBox ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding SelectedRow.NormalQuality, Mode=TwoWay}" Margin="0,5,0,4"/>
      <TextBox Text="{Binding SelectedRow.NormalDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap" MinHeight="42" AcceptsReturn="True"/>
      <TextBlock Text="{Binding ZeroReasonLabel}"/>
      <TextBox Text="{Binding SelectedRow.NormalZeroReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding RealLabel}"/>
      <TextBox Text="{Binding SelectedRow.RealSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding SourceLabel}"/>
      <ComboBox ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding SelectedRow.RealQuality, Mode=TwoWay}" Margin="0,5,0,4"/>
      <TextBox Text="{Binding SelectedRow.RealDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap" MinHeight="42" AcceptsReturn="True"/>
      <TextBlock Text="{Binding ExceptionLabel}"/>
      <TextBox Text="{Binding SelectedRow.ExceptionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
     </StackPanel>
    </Grid>
    <Expander Header="{Binding AdvancedCapacityLabel}">
      <WrapPanel>
       <StackPanel Margin="0,6,16,6"><TextBlock Text="{Binding TheoreticalLabel}"/>
        <TextBox Width="180" Text="{Binding SelectedRow.TheoreticalText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Margin="0,6,16,6"><TextBlock Text="{Binding PracticalLabel}"/>
        <TextBox Width="180" Text="{Binding SelectedRow.PracticalText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </WrapPanel>
     </Expander>
    <TextBlock Text="{Binding CorrectionLabel}" Margin="0,8,0,2"/>
    <TextBox Text="{Binding SelectedRow.CorrectionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             MaxLength="4000"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3">
   <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource Brand.Red}"
              TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
   <WrapPanel>
    <Button Content="{Binding NormalMethodLabel}" Click="AssistNormal" Margin="0,0,8,0" IsEnabled="{Binding IsWritable}"/>
    <Button Content="{Binding SaveDraftLabel}" Click="SaveDraft" IsEnabled="{Binding IsWritable}" Margin="0,0,8,0"/>
    <Button Content="{Binding ConfirmLabel}" Click="Confirm" IsEnabled="{Binding IsWritable}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="{Binding AnnulLabel}" Click="Annul" IsEnabled="{Binding IsWritable}" Margin="0,0,8,0"/>
    <Button Content="{Binding HistoryLabel}" Click="History" Margin="0,0,8,0"/>
    <Button Content="{Binding CloseLabel}" IsCancel="True" Click="CloseWindow"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
