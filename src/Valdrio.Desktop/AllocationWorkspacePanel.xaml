<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Valdrio.Desktop" x:Class="Valdrio.Desktop.AllocationWorkspacePanel">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="KeyStateCell" TargetType="TextBlock" BasedOn="{StaticResource Text.TableText}"><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"><EventSetter Event="GotKeyboardFocus" Handler="SelectNumber"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}"><Setter Property="DisplayMemberPath" Value="Label"/><Setter Property="SelectedValuePath" Value="Value"/></Style>
 </UserControl.Resources>
 <StackPanel local:FieldHelp.Key="AllocationInput">
  <Border Style="{StaticResource Diagnostic}" Margin="0,0,0,16"><TextBlock x:Name="ActionStatus" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><DockPanel LastChildFill="True"><Button x:Name="TogglePrimaryButton" DockPanel.Dock="Right" Content="{Binding PrimaryToggleLabel}" Command="{Binding TogglePrimaryCommand}"/><TextBlock Text="{Binding PrimaryState}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="320"/><ColumnDefinition Width="5*" MinWidth="460"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,12,16" VerticalAlignment="Top">
    <Expander x:Name="LibrarySection" Header="{Binding [Library]}" IsExpanded="True"><StackPanel Margin="0,8,0,0">
     <WrapPanel><Button Content="{Binding [NewKey]}" Command="{Binding NewKeyCommand}" x:Name="NewKeyButton"/><Button Content="{Binding [DeleteKey]}" Command="{Binding DeleteKeyCommand}" x:Name="DeleteKeyButton"/><Button Content="{Binding [Refresh]}" Command="{Binding RefreshCommand}" x:Name="RefreshButton"/></WrapPanel>
     <DataGrid x:Name="KeyGrid" MouseDoubleClick="OpenKeyDoubleClick" KeyDown="OpenKeyKeyDown" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}" AutoGenerateColumns="False" IsReadOnly="True" Height="190" SelectionMode="Single" Margin="0,12,0,8">
      <DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Name}" Width="*" MinWidth="130"/>
       <DataGridTextColumn ElementStyle="{StaticResource KeyStateCell}" Binding="{Binding State}" Width="120" MinWidth="120"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel><Button Content="{Binding [OpenKey]}" Command="{Binding LoadKeyCommand}" x:Name="LoadKeyButton"/></WrapPanel>
     <TextBlock Text="{Binding KeyState}" Margin="0,12,0,0"/>
    </StackPanel></Expander>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16" VerticalAlignment="Top">
    <Expander x:Name="DefinitionSection" Header="{Binding [Definition]}" IsExpanded="True"><StackPanel Margin="0,8,0,0">
     <DockPanel LastChildFill="False" Margin="0,0,0,8"><Button Style="{StaticResource Button.Primary}" Content="{Binding [SaveKey]}" Command="{Binding SaveKeyCommand}" x:Name="SaveKeyButton" DockPanel.Dock="Right"/></DockPanel>
     <StackPanel IsEnabled="{Binding CanEditKey}">
      <TextBlock Text="{Binding [Name]}"/><TextBox x:Name="KeyNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Name]}"/>
      <StackPanel IsEnabled="{Binding CanEditComposition}"><TextBlock Text="{Binding [Stage]}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Stages}" SelectedValue="{Binding Stage}" AutomationProperties.Name="{Binding [Stage]}"/><TextBlock Text="{Binding [Criterion]}" Margin="0,8,0,0"/><ComboBox x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}" AutomationProperties.Name="{Binding [Criterion]}"/>
      <StackPanel Visibility="{Binding IsDriver, Converter={StaticResource Visible}}"><TextBlock Text="{Binding [Unit]}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Units}" SelectedValue="{Binding Unit}" AutomationProperties.Name="{Binding [Unit]}" x:Name="UnitBox"/></StackPanel></StackPanel>
     </StackPanel>
     <TextBlock Text="{Binding NumberFormatHelp}" Margin="0,12,0,8"/>
     <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="190" IsEnabled="{Binding CanEditComposition}">
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="56" MinWidth="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Label}" IsReadOnly="True" Width="*" MinWidth="150"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Unit}" IsReadOnly="True" Width="70" MinWidth="60"/>
       <DataGridTemplateColumn Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" IsEnabled="{Binding DataContext.CanEditWeights, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Margin="0,8,0,0"><TextBlock Text="{Binding [Total]}" Margin="0,0,8,0"/><TextBlock Text="{Binding Total}" FontWeight="Bold"/></WrapPanel>
     <TextBlock Text="{Binding Validation}" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Expander>
   </Border>
</Grid>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="AccountsSection" Header="{Binding [Coverage]}" IsExpanded="True"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding CoverageSummary}" Margin="0,0,0,8"/>
    <DataGrid x:Name="CoverageGrid" ItemsSource="{Binding Coverage}" IsReadOnly="True" AutoGenerateColumns="False" Height="420" MinRowHeight="32">
     <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/><DataGridTextColumn Binding="{Binding Amount}" ElementStyle="{StaticResource Text.TableNumber}" Width="110"/><DataGridTemplateColumn Width="2*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PublishedPrimary, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedValue="{Binding SelectedKeyId, Mode=OneWay}" IsEnabled="{Binding DataContext.CanAssignCoverage, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionChanged="CoverageKeyChanged" AutomationProperties.Name="{Binding Source}" ToolTip="{Binding Key}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource {x:Type TextBlock}}"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel></Expander>
  </Border>
  <Expander x:Name="RulesSection" Header="{Binding [RulesAndAssignments]}" IsExpanded="False" Margin="0,0,0,16"><TabControl x:Name="RuleTabs" SelectionChanged="RuleTabChanged" Margin="0,0,0,16">
   <TabItem Header="{Binding [Rules]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16">
     <TextBlock Text="{Binding [RuleHelp]}" Margin="0,0,0,12"/>
     <DataGrid x:Name="PrimaryGrid" ItemsSource="{Binding PrimaryRules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True" Height="150"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Account}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Binding="{Binding State}" Width="150" ElementStyle="{StaticResource Text.TableText}"/></DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,8,0,12"><Button Content="{Binding [EditRule]}" Command="{Binding LoadRuleCommand}" x:Name="LoadRuleButton"/><Button Content="{Binding [NewRule]}" Command="{Binding NewRuleCommand}" x:Name="NewRuleButton"/><Button Content="{Binding [RemoveRule]}" Command="{Binding RemoveRuleCommand}" x:Name="RemoveRuleButton"/></WrapPanel>
     <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,8">
      <StackPanel Width="175" Margin="0,0,8,0"><TextBlock Text="{Binding [SelectAccounts]}"/><ComboBox ItemsSource="{Binding Selectors}" SelectedValue="{Binding SelectorKind}" x:Name="SelectorKindBox"/></StackPanel>
      <StackPanel Width="280" Margin="0,0,8,0"><TextBlock Text="{Binding [Account]}"/><ComboBox x:Name="RuleAccountBox" ItemsSource="{Binding Accounts}" SelectedValue="{Binding RuleAccount}" Visibility="{Binding IsExact, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding [Account]}"/><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPrefix, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding [Prefix]}"/></StackPanel>
      <StackPanel Width="260"><TextBlock Text="{Binding [PublishedKey]}"/><ComboBox ItemsSource="{Binding PublishedPrimary}" SelectedValue="{Binding RuleKey}" AutomationProperties.Name="{Binding [PublishedKey]}" x:Name="RuleKeyBox"/></StackPanel>
     </WrapPanel>
     <WrapPanel><Button Content="{Binding [SaveRule]}" Command="{Binding SaveRuleCommand}" x:Name="SaveRuleButton"/><Button Style="{StaticResource Button.Primary}" Content="{Binding [ApplyRule]}" Command="{Binding ApplyRuleCommand}" x:Name="ApplyRuleButton"/></WrapPanel>
    </StackPanel>
   </TabItem>
       <TabItem Header="{Binding [SecondaryRules]}" IsEnabled="{Binding CanEditSecondaryConfiguration}">
     <StackPanel Margin="16">
      <TextBlock Text="{Binding [SecondaryRouteHelp]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DataGrid x:Name="SecondaryRulesGrid" ItemsSource="{Binding SecondaryRules}" SelectedItem="{Binding SelectedSecondary}" IsReadOnly="True" AutoGenerateColumns="False" Height="155">
       <DataGrid.Columns>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="*"/>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Key}" Width="2*"/>
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,8,0,12">
       <Button x:Name="LoadSecondaryButton" Content="{Binding [EditRule]}" Command="{Binding LoadSecondaryCommand}"/>
       <Button x:Name="NewSecondaryButton" Content="{Binding [NewRule]}" Command="{Binding NewSecondaryCommand}"/>
       <Button x:Name="RemoveSecondaryButton" Content="{Binding [RemoveRule]}" Command="{Binding RemoveSecondaryCommand}"/>
      </WrapPanel>
      <TextBlock Text="{Binding [Auxiliary]}"/>
      <ComboBox ItemsSource="{Binding Auxiliaries}" SelectedValue="{Binding Auxiliary}" AutomationProperties.Name="{Binding [Auxiliary]}"/>
      <TextBlock Text="{Binding [PublishedKey]}" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{Binding PublishedSecondary}" SelectedValue="{Binding SecondaryKey}" AutomationProperties.Name="{Binding [PublishedKey]}"/>
      <TextBlock Text="{Binding [ReciprocalGroup]}" Margin="0,8,0,0"/>
      <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [ReciprocalGroup]}"/>
      <Button Style="{StaticResource Button.Primary}" x:Name="SaveSecondaryButton" Content="{Binding [SaveRule]}" Command="{Binding SaveSecondaryCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <Expander Header="{Binding [SecondarySourceGroupsTitle]}" Margin="0,16,0,0">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding [SecondarySourceGroupsHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DataGrid x:Name="SecondaryGroupAssignmentsGrid" ItemsSource="{Binding SecondaryGroupAssignments}" AutoGenerateColumns="False" IsReadOnly="True" Height="135">
         <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
          <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding [SecondarySourcePart]}" Margin="0,8,0,0"/>
        <ComboBox ItemsSource="{Binding Parts}" SelectedValue="{Binding SecondaryGroupPart}" AutomationProperties.Name="{Binding [SecondarySourcePart]}"/>
        <TextBlock Text="{Binding [SecondarySelectedGroup]}" Margin="0,8,0,0"/>
        <ComboBox ItemsSource="{Binding SecondaryGroupChoices}" SelectedValue="{Binding SecondaryGroupName}" AutomationProperties.Name="{Binding [SecondarySelectedGroup]}"/>
        <Button Style="{StaticResource Button.Primary}" Content="{Binding [SecondaryAssignGroup]}" Command="{Binding SaveSecondaryGroupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </TabItem>
    <TabItem Header="{Binding [Exceptions]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16">
     <Button Content="{Binding [ClearObsolete]}" Command="{Binding ClearObsoleteCommand}" Visibility="{Binding HasObsolete, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding [ExceptionsHelp]}" Margin="0,0,0,12"/>
     <ComboBox x:Name="PartBox" ItemsSource="{Binding Parts}" SelectedValue="{Binding Part}" AutomationProperties.Name="{Binding [Part]}"/>
     <TextBlock Text="{Binding [PublishedKey]}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding PublishedPrimary}" SelectedValue="{Binding PartKey}" IsEnabled="{Binding CanEdit}" x:Name="PartKeyBox"/>
     <WrapPanel Margin="0,8,0,12"><Button Content="{Binding [Assign]}" Command="{Binding AssignCommand}" Style="{StaticResource Button.Primary}" x:Name="AssignButton"/><Button Content="{Binding [Automatic]}" Command="{Binding AutomaticCommand}" x:Name="AutomaticButton"/></WrapPanel>
     <Expander Header="{Binding [Absolute]}"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding [AbsoluteHelp]}"/><TextBlock Text="{Binding Currency}" FontWeight="Bold" Margin="0,4,0,8"/>
      <DataGrid x:Name="AbsoluteGrid" ItemsSource="{Binding AbsoluteLines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="220" IsEnabled="{Binding CanEdit}"><DataGrid.Columns><DataGridTemplateColumn Width="56" MinWidth="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Label}" Width="*" MinWidth="180" IsReadOnly="True"/><DataGridTemplateColumn Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
      <Button Content="{Binding [SaveAbsolute]}" Command="{Binding SaveAbsoluteCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" x:Name="SaveAbsoluteButton"/></StackPanel></Expander>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding [Names]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16"><TextBlock Text="{Binding [NamesHelp]}" Margin="0,0,0,12"/><TextBlock Text="{Binding [Account]}"/><ComboBox x:Name="NameAccountBox" ItemsSource="{Binding Accounts}" SelectedValue="{Binding Account}" AutomationProperties.Name="{Binding [Account]}"/><TextBlock Text="{Binding [VisibleName]}" Margin="0,8,0,0"/><ComboBox x:Name="DescriptionBox" ItemsSource="{Binding DescriptionOptions}" SelectedItem="{Binding ChosenDescription}" DisplayMemberPath="" SelectedValuePath="" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [VisibleName]}"/><Button Content="{Binding [ChooseName]}" Command="{Binding ChooseDescriptionCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" x:Name="ChooseDescriptionButton"/><TextBlock Text="{Binding [Provenance]}" FontWeight="SemiBold"/><TextBlock Text="{Binding DescriptionProvenance}"/></StackPanel>
   </TabItem>
  </TabControl></Expander>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="ResultsSection" Header="{Binding [PrimaryTitle]}" IsExpanded="False"><StackPanel Margin="0,8,0,0">
    <TextBlock Text="{Binding PrimarySummary}" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
    <DataGrid x:Name="PrimaryResultsGrid" ItemsSource="{Binding PrimaryResults}" IsReadOnly="True" AutoGenerateColumns="False" Height="210"
              SelectionMode="Single" AutomationProperties.Name="{Binding [PrimaryTitle]}">
     <DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
      <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Destination}" Width="2*"/>
      <DataGridTextColumn Binding="{Binding Amount}" ElementStyle="{StaticResource Text.TableNumber}" Width="120"/>
      <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding AppliedRule}" Width="2*"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="{Binding PrimaryDiagnostic}" Margin="0,8,0,0" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></Expander>
  </Border>

  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="SecondaryResultsSection" Header="{Binding [SecondaryTitle]}" IsExpanded="True">
    <StackPanel Margin="0,8,0,0">
     <TextBlock Text="{Binding [SecondaryHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <DockPanel LastChildFill="True" Margin="0,0,0,8">
      <Button x:Name="ToggleSecondaryButton" DockPanel.Dock="Right" Command="{Binding ToggleSecondaryCommand}" Content="{Binding SecondaryToggleLabel}"/>
      <TextBlock Text="{Binding SecondaryState}" VerticalAlignment="Center"/>
     </DockPanel>
     <Button x:Name="CalculateSecondaryButton" Style="{StaticResource Button.Primary}" Content="{Binding [CalculateSecondary]}" Command="{Binding CalculateSecondaryCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{Binding SecondarySummary}" Margin="0,8,0,4" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding SecondaryDiagnostic}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
     <DataGrid x:Name="SecondaryResultsGrid" ItemsSource="{Binding SecondaryResults}" SelectedItem="{Binding SelectedSecondaryResultRow}" IsReadOnly="True" AutoGenerateColumns="False" Height="215">
      <DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Destination}" Width="2*"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Amount}" Width="*"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Behavior}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <Button x:Name="ExplainSecondaryButton" Content="{Binding [SecondaryExplain]}" Command="{Binding ExplainSecondaryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     <Expander Header="{Binding [SecondaryExplain]}" Margin="0,8,0,0"><TextBlock Text="{Binding SecondaryExplanation}" TextWrapping="Wrap" Margin="8"/></Expander>
     <Expander Header="{Binding [SecondaryBridgeTitle]}" Margin="0,8,0,0">
      <StackPanel Margin="0,8,0,0">
       <TextBlock Text="{Binding [SecondaryBridgeHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <DataGrid x:Name="SecondaryBridgesGrid" ItemsSource="{Binding SecondaryBridges}" IsReadOnly="True" AutoGenerateColumns="False" Height="155" CanUserAddRows="False">
        <DataGrid.Columns>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Resource}" Width="2*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Effective}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Direct}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Excluded}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Terminal}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Difference}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Expander>
     <Expander Header="{Binding [SecondaryGross]}" Margin="0,8,0,0">
      <DataGrid x:Name="SecondaryCirculationGrid" ItemsSource="{Binding SecondaryCirculation}" IsReadOnly="True" AutoGenerateColumns="False" Height="135">
       <DataGrid.Columns>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="2*"/>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Detail}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Expander>
    </StackPanel>
   </Expander>
  </Border>

  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="ReciprocalSection" Header="{Binding [ReciprocalTitle]}" IsExpanded="False">
    <StackPanel Margin="0,8,0,0">
     <TextBlock Text="{Binding [ReciprocalHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <WrapPanel><Button x:Name="CheckReciprocalButton" Content="{Binding [CheckReciprocal]}" Command="{Binding CheckReciprocalCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel>
     <TextBlock Text="{Binding ReciprocalSummary}" Margin="0,8,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <DataGrid x:Name="ReciprocalGrid" ItemsSource="{Binding ReciprocalChecks}" IsReadOnly="True"
               AutoGenerateColumns="False" Height="165" MinRowHeight="32"
               AutomationProperties.Name="{Binding [ReciprocalTitle]}">
      <DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="2*"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding State}" Width="*"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Detail}" Width="3*"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{Binding [ReciprocalNoPosting]}" TextWrapping="Wrap" Margin="0,8,0,0"
                Foreground="{DynamicResource Text.Primary}"/>
    </StackPanel>
   </Expander>
  </Border>
  <WrapPanel><Button Content="{Binding [Discard]}" Command="{Binding DiscardCommand}" x:Name="DiscardButton"/></WrapPanel>
  <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
