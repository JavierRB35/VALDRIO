<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Valdrio.Desktop" x:Class="Valdrio.Desktop.AllocationWorkspacePanel">
 <UserControl.Resources>
  <local:DistinctStatusVisibilityConverter x:Key="DistinctStatusVisibility"/>
  <local:KeyWorkspaceHeightConverter x:Key="KeyWorkspaceHeight"/>
  <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="12,8"/></Style>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ContributionNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.TableNumber}"><Setter Property="ToolTip" Value="{Binding TechnicalDetail}"/></Style>
  <Style x:Key="PrimaryBehavior" TargetType="TextBlock" BasedOn="{StaticResource Text.TableText}"><Setter Property="ToolTip" Value="{Binding AppliedRule}"/></Style>
  <Style x:Key="ViabilityText" TargetType="TextBlock" BasedOn="{StaticResource Text.TableText}"><Setter Property="ToolTip" Value="{Binding TechnicalDetail}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="KeyStateCell" TargetType="TextBlock" BasedOn="{StaticResource Text.TableText}">
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsInvalid}" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/>
     <Setter Property="Background" Value="{DynamicResource Status.ErrorBg}"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"><EventSetter Event="GotKeyboardFocus" Handler="SelectNumber"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}"><Setter Property="DisplayMemberPath" Value="Label"/><Setter Property="SelectedValuePath" Value="Value"/></Style>
 </UserControl.Resources>
 <StackPanel x:Name="WorkspaceBody" local:FieldHelp.Key="AllocationInput">
  <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Cursor" Value="Wait"/></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
  <!-- Activity feedback belongs to MainWindow.GlobalActivityBar, shared by all pages. -->
  <Border Margin="0,0,0,12">
   <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Diagnostic}">
    <Style.Triggers><DataTrigger Binding="{Binding HasStatusError}" Value="True">
     <Setter Property="Background" Value="{DynamicResource Status.ErrorBg}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource Brand.Red}"/>
    </DataTrigger></Style.Triggers>
   </Style></Border.Style>
   <TextBlock x:Name="ActionStatus" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
  </Border>


  <local:AdaptiveColumnsPanel x:Name="KeyWorkspaceLayout" MinColumnWidth="440" MinimumRowHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource KeyWorkspaceHeight}}">
   <Border Style="{StaticResource Card}" Margin="0,0,12,16">
    <Expander x:Name="LibrarySection" Header="{Binding [Library]}" IsExpanded="True" VerticalContentAlignment="Stretch"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

     <DataGrid Grid.Row="1" x:Name="KeyGrid" SelectionChanged="OpenKeySelectionChanged" MouseDoubleClick="OpenKeyDoubleClick" KeyDown="OpenKeyKeyDown" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,12,0,8">
      <DataGrid.RowStyle>
       <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers><DataTrigger Binding="{Binding IsInvalid}" Value="True">
         <Setter Property="Background" Value="{DynamicResource Status.ErrorBg}"/>
        </DataTrigger></Style.Triggers>
       </Style>
      </DataGrid.RowStyle>
     <DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Name}" Width="*" MinWidth="130"/>
       <DataGridTextColumn ElementStyle="{StaticResource KeyStateCell}" Binding="{Binding State}" Width="120" MinWidth="120"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="2"><Button Content="{Binding [NewKey]}" Command="{Binding NewKeyCommand}" x:Name="NewKeyButton" Click="FocusNewKey"/><Button Content="{Binding [NewVersion]}" Command="{Binding NewVersionCommand}" x:Name="NewVersionButton" ToolTip="{Binding [SecondaryRepairVersionHelp]}"/><Button Content="{Binding [DeleteKey]}" Command="{Binding DeleteKeyCommand}" x:Name="DeleteKeyButton" ToolTip="{Binding KeyDeleteHelp}"/><Button Content="{Binding [Refresh]}" Command="{Binding RefreshCommand}" x:Name="RefreshButton"/><Button Content="{Binding [OpenKey]}" Command="{Binding LoadKeyCommand}" x:Name="LoadKeyButton"/></WrapPanel>
     <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding KeyState}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding KeyDeleteHelp}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </Grid></Expander>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16">
    <Expander x:Name="DefinitionSection" Header="{Binding [Definition]}" IsExpanded="True" VerticalContentAlignment="Stretch"><Grid Margin="0,8,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEditKey}"><TextBlock Text="{Binding [Name]}"/><TextBox x:Name="KeyNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Name]}">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
         <Style.Triggers><DataTrigger Binding="{Binding KeyNameMissing}" Value="True">
          <Setter Property="Tag" Value="error"/>
          <Setter Property="Background" Value="{DynamicResource Status.ErrorBg}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Brand.Red}"/>
         </DataTrigger></Style.Triggers>
        </Style></TextBox.Style>
       </TextBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0" IsEnabled="{Binding CanEditComposition}"><TextBlock Text="{Binding [Criterion]}"/><ComboBox x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}" AutomationProperties.Name="{Binding [Criterion]}"/>
       <StackPanel Visibility="{Binding IsDriver, Converter={StaticResource Visible}}"><TextBlock Text="{Binding [Unit]}"/><ComboBox ItemsSource="{Binding Units}" SelectedValue="{Binding Unit}" AutomationProperties.Name="{Binding [Unit]}" x:Name="UnitBox"/></StackPanel>
      </StackPanel>

     </Grid>
     <TextBlock Grid.Row="1" Text="{Binding NumberFormatHelp}" Margin="0,4,0,8"/>
     <DataGrid Grid.Row="2" x:Name="LinesGrid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="200" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="76" MinWidth="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEditComposition, RelativeSource={RelativeSource AncestorType=DataGrid}}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Label}" IsReadOnly="True" Width="*" MinWidth="150"/>
       <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Unit}" IsReadOnly="True" Width="70" MinWidth="60"/>
       <DataGridTemplateColumn Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="{Binding Label}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"><EventSetter Event="GotKeyboardFocus" Handler="SelectNumber"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CanEditWeights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding [Total]}" Margin="0,0,8,0"/><TextBlock Text="{Binding Total}" FontWeight="Bold"/></WrapPanel>
     <TextBlock Grid.Row="4" Text="{Binding Validation}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Style.Triggers><DataTrigger Binding="{Binding KeyValidationHasError}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/>
        <Setter Property="Background" Value="{DynamicResource Status.ErrorBg}"/>
       </DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
           <Button Grid.Row="5" Style="{StaticResource Button.Primary}" Content="{Binding [SaveKey]}" Command="{Binding SaveKeyCommand}" x:Name="SaveKeyButton" HorizontalAlignment="Right" Margin="0,8,0,0"/>
     </Grid></Expander>
   </Border>
</local:AdaptiveColumnsPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="CompositionSection" Header="{Binding [CompositionTitle]}" IsExpanded="True">
    <StackPanel Margin="0,8,0,0">
     <TextBlock Text="{Binding [CompositionHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding CompositionSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <WrapPanel Margin="0,0,0,8">
      <StackPanel MinWidth="260" Margin="0,0,12,4">
       <TextBlock Text="{Binding [CompositionSearch]}"/>
       <TextBox Text="{Binding CompositionSearch, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{Binding [CompositionSearch]}"/>
      </StackPanel>
      <CheckBox Content="{Binding [CompositionOnlyExceptions]}" IsChecked="{Binding CompositionOnlyExceptions, Mode=TwoWay}"
                VerticalAlignment="Bottom" Margin="0,0,0,10"/>
     </WrapPanel>
     <DataGrid x:Name="CompositionGrid" ItemsSource="{Binding CompositionView}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" MinRowHeight="{DynamicResource Table.MinRowHeight}">
      <DataGrid.Columns>
       <DataGridTextColumn Binding="{Binding Account}" ElementStyle="{StaticResource Text.TableText}" Width="3*" MinWidth="200"/>
       <DataGridTextColumn Binding="{Binding Amount}" HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource Text.TableNumber}" Width="125"/>
       <DataGridTemplateColumn Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <ComboBox ItemsSource="{Binding DataContext.CompositionChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedValue="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Account}">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}"><Setter Property="DisplayMemberPath" Value="Label"/><Setter Property="SelectedValuePath" Value="Value"/>
          <Style.Triggers><DataTrigger Binding="{Binding CanBulk}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanEditClassification, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
         </Style></ComboBox.Style>
        </ComboBox>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBox IsReadOnly="True" Text="{Binding FixedPercentage, Mode=OneWay}" Visibility="{Binding IsMixed, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DataContext[CompositionFixedWeight], RelativeSource={RelativeSource AncestorType=DataGrid}}" TextAlignment="Right">
         <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"><Style.Triggers><DataTrigger Binding="{Binding CanBulk}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanEditClassification, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBox Text="{Binding VariablePercentage, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsMixed, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DataContext[CompositionVariableWeight], RelativeSource={RelativeSource AncestorType=DataGrid}}" TextAlignment="Right">
         <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"><Style.Triggers><DataTrigger Binding="{Binding CanBulk}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanEditClassification, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Binding="{Binding Review}" ElementStyle="{StaticResource Text.TableText}" Width="2*" MinWidth="130"/>
      </DataGrid.Columns>
     </DataGrid>
<Grid Background="{DynamicResource Surface.Subtle}" Margin="0,-4,0,12" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding [TableTotal]}" Margin="9,8" FontWeight="SemiBold"/>
<TextBlock Grid.Column="1" Text="{Binding PrimaryCompositionTotal}" TextAlignment="Right" Margin="6,8" FontWeight="SemiBold"/></Grid>

     <Button x:Name="SaveCompositionRowsButton" Content="{Binding [SaveCompositionRows]}" Command="{Binding SaveCompositionRowsCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding [CompositionCloseHelp]}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </Expander>
  </Border>
<Expander x:Name="RulesSection" Header="{Binding [RulesAndAssignments]}" IsExpanded="False" Margin="0,0,0,16"><TabControl x:Name="RuleTabs" SelectionChanged="RuleTabChanged" Margin="0,0,0,16">
   <TabItem Header="{Binding [Rules]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16">
     <TextBlock Text="{Binding [RuleHelp]}" Margin="0,0,0,12"/>
     <DataGrid x:Name="PrimaryGrid" ItemsSource="{Binding PrimaryRules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True" Height="150"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Account}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Binding="{Binding State}" Width="150" ElementStyle="{StaticResource Text.TableText}"/></DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,8,0,12"><Button Content="{Binding [EditRule]}" Command="{Binding LoadRuleCommand}" x:Name="LoadRuleButton"/><Button Content="{Binding [NewRule]}" Command="{Binding NewRuleCommand}" x:Name="NewRuleButton"/><Button Content="{Binding [RemoveRule]}" Command="{Binding RemoveRuleCommand}" x:Name="RemoveRuleButton"/></WrapPanel>
     <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,8">
      <StackPanel Width="175" Margin="0,0,8,0"><TextBlock Text="{Binding [SelectAccounts]}"/><ComboBox ItemsSource="{Binding Selectors}" SelectedValue="{Binding SelectorKind}" x:Name="SelectorKindBox"/></StackPanel>
      <StackPanel Width="280" Margin="0,0,8,0"><TextBlock Text="{Binding [Account]}"/><ComboBox x:Name="RuleAccountBox" ItemsSource="{Binding Accounts}" SelectedValue="{Binding RuleAccount}" Visibility="{Binding IsExact, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding [Account]}"/><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPrefix, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding [Prefix]}"/></StackPanel>
      <StackPanel Width="260"><TextBlock Text="{Binding [PublishedKey]}"/><ComboBox ItemsSource="{Binding PublishedPrimary}" SelectedValue="{Binding RuleKey}" AutomationProperties.Name="{Binding [PublishedKey]}" x:Name="RuleKeyBox"/></StackPanel>
     </WrapPanel>
     <WrapPanel><Button Content="{Binding [SaveRule]}" Command="{Binding SaveRuleCommand}" x:Name="SaveRuleButton"/><Button Style="{StaticResource Button.Primary}" Content="{Binding [ApplyRule]}" Command="{Binding ApplyRuleCommand}" x:Name="ApplyRuleButton"/></WrapPanel>
    </StackPanel>
   </TabItem>
       <TabItem Header="{Binding [SecondaryRules]}">
     <StackPanel Margin="16">
      <TextBlock Text="{Binding [SecondaryRouteHelp]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding [SecondaryNodeAssignmentsTitle]}" FontWeight="SemiBold" Margin="0,8,0,3"/>
      <TextBlock Text="{Binding [SecondaryNodeAssignmentsHelp]}" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding [SecondaryNoPublishedKeys]}" Foreground="{DynamicResource Brand.Red}" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPublishedSecondary}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <DataGrid x:Name="SecondaryNodeAssignmentsGrid" ItemsSource="{Binding SecondaryNodeAssignments}" IsReadOnly="True" AutoGenerateColumns="False" Height="190" CanUserAddRows="False" Margin="0,6,0,12">
       <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource Text.TableText}"/>
        <DataGridTemplateColumn Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel>
          <ComboBox ItemsSource="{Binding DataContext.PublishedSecondary, RelativeSource={RelativeSource AncestorType=DataGrid}}"
           DisplayMemberPath="Label" SelectedValuePath="Value"
           SelectedValue="{Binding SelectedKeyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
           IsEnabled="{Binding DataContext.CanShowSecondaryEditor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
           SelectionChanged="SecondaryAssignmentChanged" DropDownClosed="SecondaryAssignmentDropDownClosed"
           AutomationProperties.Name="{Binding Source}" ToolTip="{Binding AssignmentError}"/>
          <TextBlock Text="{Binding AssignmentError}" Foreground="{DynamicResource Brand.Red}"
           Visibility="{Binding HasAssignmentError, Converter={StaticResource Visible}}"
           TextWrapping="Wrap" Margin="6,3,3,4" AutomationProperties.LiveSetting="Polite"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="SecondaryRulesGrid" ItemsSource="{Binding SecondaryRules}" SelectedItem="{Binding SelectedSecondary}" IsReadOnly="True" AutoGenerateColumns="False" Height="155">
       <DataGrid.Columns>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="*"/>
        <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Key}" Width="2*"/>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel IsEnabled="{Binding CanShowSecondaryEditor}">
      <WrapPanel Margin="0,8,0,12">
       <Button x:Name="LoadSecondaryButton" Content="{Binding [EditRule]}" Command="{Binding LoadSecondaryCommand}"/>
       <Button x:Name="NewSecondaryButton" Content="{Binding [NewRule]}" Command="{Binding NewSecondaryCommand}"/>
       <Button x:Name="RemoveSecondaryButton" Content="{Binding [RemoveRule]}" Command="{Binding RemoveSecondaryCommand}"/>
      </WrapPanel>
      <TextBlock Text="{Binding [Auxiliary]}"/>
      <ComboBox ItemsSource="{Binding Auxiliaries}" SelectedValue="{Binding Auxiliary}" AutomationProperties.Name="{Binding [Auxiliary]}"/>
      <TextBlock Text="{Binding [PublishedKey]}" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{Binding PublishedSecondary}" SelectedValue="{Binding SecondaryKey}" AutomationProperties.Name="{Binding [PublishedKey]}"/>
      <TextBlock Text="{Binding [ReciprocalGroup]}" Margin="0,8,0,0"/>
      <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [ReciprocalGroup]}"/>
      <Button Style="{StaticResource Button.Primary}" x:Name="SaveSecondaryButton" Content="{Binding [SaveRule]}" Command="{Binding SaveSecondaryCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <Button x:Name="FillMissingSecondaryButton" Content="{Binding [SecondaryFillMissing]}" Command="{Binding AssignSecondaryKeyToMissingCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
              ToolTip="{Binding [SecondaryFillMissingHelp]}"/>
      </StackPanel>
      <Expander Header="{Binding [SecondarySourceGroupsTitle]}" Margin="0,16,0,0">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding [SecondarySourceGroupsHelp]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Content="{Binding [SecondaryClearObsoleteGroups]}" Command="{Binding ClearObsoleteSecondaryGroupsCommand}"
                Visibility="{Binding HasObsoleteSecondaryGroups, Converter={StaticResource Visible}}"
                HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <DataGrid x:Name="SecondaryGroupAssignmentsGrid" ItemsSource="{Binding SecondaryGroupAssignments}" AutoGenerateColumns="False" IsReadOnly="True" Height="135">
         <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Source}" Width="2*"/>
          <DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Group}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
        <StackPanel IsEnabled="{Binding CanEditSecondaryConfiguration}">
        <TextBlock Text="{Binding [SecondarySourcePart]}" Margin="0,8,0,0"/>
        <ComboBox ItemsSource="{Binding Parts}" SelectedValue="{Binding SecondaryGroupPart}" AutomationProperties.Name="{Binding [SecondarySourcePart]}"/>
        <TextBlock Text="{Binding [SecondarySelectedGroup]}" Margin="0,8,0,0"/>
        <ComboBox ItemsSource="{Binding SecondaryGroupChoices}" SelectedValue="{Binding SecondaryGroupName}" AutomationProperties.Name="{Binding [SecondarySelectedGroup]}"/>
        <Button Style="{StaticResource Button.Primary}" Content="{Binding [SecondaryAssignGroup]}" Command="{Binding SaveSecondaryGroupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
        </StackPanel>
       </StackPanel>
      </Expander>
     </StackPanel>
    </TabItem>
    <TabItem Header="{Binding [Exceptions]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16">
     <Button Content="{Binding [ClearObsolete]}" Command="{Binding ClearObsoleteCommand}" Visibility="{Binding HasObsolete, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding [ExceptionsHelp]}" Margin="0,0,0,12"/>
     <ComboBox x:Name="PartBox" ItemsSource="{Binding Parts}" SelectedValue="{Binding Part}" AutomationProperties.Name="{Binding [Part]}"/>
     <TextBlock Text="{Binding [PublishedKey]}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding PublishedPrimary}" SelectedValue="{Binding PartKey}" IsEnabled="{Binding CanEdit}" x:Name="PartKeyBox"/>
     <WrapPanel Margin="0,8,0,12"><Button Content="{Binding [Assign]}" Command="{Binding AssignCommand}" Style="{StaticResource Button.Primary}" x:Name="AssignButton"/><Button Content="{Binding [Automatic]}" Command="{Binding AutomaticCommand}" x:Name="AutomaticButton"/></WrapPanel>
     <Expander Header="{Binding [Absolute]}"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding [AbsoluteHelp]}"/><TextBlock Text="{Binding Currency}" FontWeight="Bold" Margin="0,4,0,8"/>
      <DataGrid x:Name="AbsoluteGrid" ItemsSource="{Binding AbsoluteLines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="220" IsEnabled="{Binding CanEdit}"><DataGrid.Columns><DataGridTemplateColumn Width="76" MinWidth="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource Text.TableText}" Binding="{Binding Label}" Width="*" MinWidth="180" IsReadOnly="True"/><DataGridTemplateColumn Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="{Binding Label}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Grid Background="{DynamicResource Surface.Subtle}" MinHeight="32" Margin="0,-4,0,8">
 <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
 <TextBlock Grid.Column="1" Text="{Binding [TableTotal]}" FontWeight="SemiBold" Margin="9,8"/>
 <TextBlock Grid.Column="2" Text="{Binding PrimaryAbsoluteTotal}" TextAlignment="Right" FontWeight="SemiBold" Margin="6,8"/>
 </Grid>
      <Button Content="{Binding [SaveAbsolute]}" Command="{Binding SaveAbsoluteCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" x:Name="SaveAbsoluteButton"/></StackPanel></Expander>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding [Names]}" IsEnabled="{Binding CanEditConfiguration}">
    <StackPanel Margin="16"><TextBlock Text="{Binding [NamesHelp]}" Margin="0,0,0,12"/><TextBlock Text="{Binding [Account]}"/><ComboBox x:Name="NameAccountBox" ItemsSource="{Binding Accounts}" SelectedValue="{Binding Account}" AutomationProperties.Name="{Binding [Account]}"/><TextBlock Text="{Binding [VisibleName]}" Margin="0,8,0,0"/><ComboBox x:Name="DescriptionBox" ItemsSource="{Binding DescriptionOptions}" SelectedItem="{Binding ChosenDescription}" DisplayMemberPath="" SelectedValuePath="" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [VisibleName]}"/><Button Content="{Binding [ChooseName]}" Command="{Binding ChooseDescriptionCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" x:Name="ChooseDescriptionButton"/><TextBlock Text="{Binding [Provenance]}" FontWeight="SemiBold"/><TextBlock Text="{Binding DescriptionProvenance}"/></StackPanel>
   </TabItem>
  </TabControl></Expander>
<Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <Expander x:Name="AccountsSection" Header="{Binding [Coverage]}" IsExpanded="True"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding CoverageSummary}" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding [BulkAssignHelp]}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <DataGrid x:Name="CoverageGrid" ItemsSource="{Binding Coverage}" CanUserSortColumns="True" IsReadOnly="True" AutoGenerateColumns="False" Height="420" MinRowHeight="{DynamicResource Table.MinRowHeight}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="BatchSelectionChanged">
