      <Button x:Name="CancelSecondaryButton" Content="{Binding [SecondaryCancel]}" Command="{Binding CancelSecondaryCommand}"/>
     </WrapPanel>
     <WrapPanel x:Name="PrimaryPhaseBar"><Button x:Name="TogglePrimaryButton" Content="{Binding PrimaryToggleLabel}" Command="{Binding TogglePrimaryCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel>
     <WrapPanel x:Name="SecondaryPhaseBar"><Button x:Name="ToggleSecondaryButton" Content="{Binding SecondaryToggleLabel}" Command="{Binding ToggleSecondaryCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel>
    </WrapPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
