<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Valdrio.Desktop.AuxiliaryCapacityWindow" Title="{Binding [Title]}" Width="1200" Height="850" MinWidth="720" MinHeight="550"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <Window.Resources><Style x:Key="AuxCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="8,6"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding [Title]}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Context}" Margin="0,8,0,4" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer x:Name="AuxScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="{Binding [Help]}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="CentersTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" MaxHeight="230">
     <DataGrid.Columns>
      <DataGridTextColumn x:Name="CenterColumn" Binding="{Binding Name}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource AuxCell}"/>
      <DataGridTextColumn x:Name="UnitColumn" Binding="{Binding Unit}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn x:Name="NormalColumn" Binding="{Binding Normal}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn x:Name="RealColumn" Binding="{Binding Real}" IsReadOnly="True" Width="*"/>
      <DataGridTemplateColumn x:Name="ModeColumn" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"
        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Name}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="{Binding SelectedRow.Name}" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding [ServicesHelp]}" TextWrapping="Wrap" Margin="0,8"/>
    <DataGrid x:Name="ServicesTable" ItemsSource="{Binding SelectedRow.Services}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="240">
     <DataGrid.Columns><DataGridTextColumn x:Name="GroupColumn" Binding="{Binding GroupLabel}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn x:Name="DestinationColumn" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
      <DataGridTemplateColumn x:Name="QuantityColumn" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Name}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Expander Header="{Binding [Import]}" Margin="0,8"><TextBlock Text="{Binding [ImportHelp]}" TextWrapping="Wrap"/></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,12,0,0"><DataGrid x:Name="AnswersTable" ItemsSource="{Binding Answers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn x:Name="QuestionColumn" Binding="{Binding Question}" Width="2*" ElementStyle="{StaticResource AuxCell}"/>
    <DataGridTextColumn x:Name="AnswerColumn" Binding="{Binding Answer}" Width="3*" ElementStyle="{StaticResource AuxCell}"/></DataGrid.Columns>
   </DataGrid></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel>
    <Button Content="{Binding [Save]}" Click="Save" IsEnabled="{Binding CanSave}" Style="{StaticResource Button.Primary}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Validate]}" Click="Validate" Margin="0,0,8,6"/>
    <Button Content="{Binding [Calculate]}" Click="Calculate" IsEnabled="{Binding CanCalculate}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Import]}" Click="Import" IsEnabled="{Binding CanEdit}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Activity]}" Click="Activity" Margin="0,0,8,6"/>
    <Button Content="{Binding [Rates]}" Click="Rates" Margin="0,0,8,6"/>
    <Button Content="{Binding [Reopen]}" Click="Reopen" IsEnabled="{Binding CanReopen}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Refresh]}" Click="Refresh" Margin="0,0,8,6"/>
    <Button Content="{Binding [Export]}" Click="Export" IsEnabled="{Binding CanExport}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Close]}" Click="CloseWindow" Margin="0,0,8,6"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
