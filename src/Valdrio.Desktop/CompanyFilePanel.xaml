<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.CompanyFilePanel">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="0,4,8,4"/>
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>

 <GroupBox Header="{Binding Title}" Padding="16" Margin="0,0,0,14">
  <StackPanel>
   <TextBlock Text="{Binding ProjectIntro}" Margin="0,0,0,14"/>

   <StackPanel Visibility="{Binding NoProject,Converter={StaticResource BoolVis}}">
    <Border Margin="0,0,0,12" Style="{StaticResource Card}"><StackPanel>
     <Button x:Name="ExampleButton" Content="{Binding ExampleLabel}" Command="{Binding OpenExampleCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{Binding ExampleHelp}" Margin="0,4,0,8"/>
     <Button x:Name="ImportStartButton" Content="{Binding ImportStartLabel}" Click="StartImportSetup" HorizontalAlignment="Left"/>
     <TextBlock Text="{Binding ImportStartHelp}" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <Border Margin="0,0,0,12" Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="{Binding OpenProjectTitle}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding OpenProjectHelp}" Margin="0,4,0,8" Foreground="{DynamicResource Text.Primary}"/>
      <Button x:Name="OpenButton" Content="{Binding OpenLabel}" Command="{Binding OpenCommand}" HorizontalAlignment="Left" FontWeight="SemiBold" TabIndex="13" Style="{StaticResource Button.Primary}"/>
     </StackPanel>
    </Border>

    <Border Margin="0,0,0,10" Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="{Binding NewProjectTitle}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding NewProjectHelp}" Margin="0,4,0,10" Foreground="{DynamicResource Text.Primary}"/>
      <StackPanel IsEnabled="{Binding IsIdle}">
       <TextBlock Text="{Binding NameLabel}" Margin="0,5,12,6"/>
       <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding CompanyName,UpdateSourceTrigger=PropertyChanged}" TabIndex="10" AutomationProperties.Name="{Binding NameLabel}" local:FieldHelp.Key="CompanyName"/>
       <TextBlock Grid.Row="1" Text="{Binding CurrencyLabel}" Margin="0,10,12,6"/>
       <ComboBox x:Name="CurrencyBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency,UpdateSourceTrigger=PropertyChanged}" TabIndex="11" AutomationProperties.Name="{Binding CurrencyLabel}" local:FieldHelp.Key="Currency"/>
      </StackPanel>
      <Button x:Name="CreateButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" HorizontalAlignment="Left" FontWeight="SemiBold" TabIndex="12" Margin="0,10,8,4" Style="{StaticResource Button.Primary}"/>
     </StackPanel>
    </Border>
   </StackPanel>

   <StackPanel Visibility="{Binding HasProject,Converter={StaticResource BoolVis}}">
    <TextBlock Text="{Binding ActiveCompanyLabel}" FontWeight="SemiBold"/>
    <TextBlock x:Name="ActiveCompanyNameText" Text="{Binding ActiveCompanyName}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
    <TextBlock Text="{Binding ProjectReadyHelp}" Margin="0,0,0,10"/>
    <Button x:Name="NewProjectButton" Content="{Binding NewProjectTitle}" Command="{Binding NewProjectCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" TabIndex="11" ToolTip="{Binding NewProjectHelp}"/>
   </StackPanel>

   <TextBlock Text="{Binding Status}" Margin="0,4,0,8" AutomationProperties.LiveSetting="Assertive"/>
   <Button x:Name="UpgradeSuggestionButton" Content="{Binding UpgradeLabel}" Command="{Binding UpgradeCommand}"
           Visibility="{Binding UpgradeSuggested, Converter={StaticResource BoolVis}}"
           HorizontalAlignment="Left" Margin="0,2,8,12" Style="{StaticResource Button.Primary}"/>

   <Expander Header="{Binding FileOperationsLabel}" Margin="0,6,0,10">
    <StackPanel Margin="8,6,0,0">
     <TextBlock Text="{Binding FileOperationsHelp}" Margin="0,0,0,8" Foreground="{DynamicResource Text.Primary}"/>
     <WrapPanel>
      <Button x:Name="CloseButton" Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" TabIndex="14"/>
      <Button x:Name="BackupButton" Content="{Binding BackupLabel}" Command="{Binding BackupCommand}" TabIndex="15"/>
      <Button x:Name="RestoreButton" Content="{Binding RestoreLabel}" Command="{Binding RestoreCommand}" TabIndex="16"/>
      <Button x:Name="UpgradeButton" Content="{Binding UpgradeLabel}" Command="{Binding UpgradeCommand}" TabIndex="60" AutomationProperties.Name="{Binding UpgradeLabel}"/>
      <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" TabIndex="17"/>
     </WrapPanel>
     <Expander Header="{Binding TechnicalDetailsLabel}" Margin="0,6,0,4">
      <TextBlock Text="{Binding Details}" FlowDirection="LeftToRight" Margin="8,6,0,0"/>
     </Expander>
    </StackPanel>
   </Expander>

   <TextBlock Text="{Binding Notes}" Margin="0,8,0,0" Foreground="{DynamicResource Text.Primary}"/>

   <StackPanel x:Name="UnitCreationPanel">
    <StackPanel.Resources>
     <!-- The unit form can be reparented into ModelWorkspacePanel; keep model-specific implicit styles out. -->
     <Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}"/>
     <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}"/>
    </StackPanel.Resources>
    <TextBlock Text="{Binding DefaultUnitsHelp}" Margin="0,4,0,4"/>
    <Button x:Name="InstallDefaultUnitsButton" Content="{Binding AddDefaultUnitsLabel}"
            Command="{Binding AddDefaultUnitsCommand}"
            Visibility="{Binding MissingDefaultUnits,Converter={StaticResource BoolVis}}"
            HorizontalAlignment="Left" TabIndex="18" Style="{StaticResource Button.Secondary}"/>
    <TextBlock Text="{Binding UnitCreationHelp}" Margin="0,4,0,4"/>
    <TextBlock Text="{Binding UnitRequiredHelp}" Foreground="{DynamicResource Text.Primary}" FontSize="11" Margin="0,0,0,8"/>
    <Grid IsEnabled="{Binding IsIdle}">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <TextBlock Text="{Binding UnitLabel}"/>
     <TextBox x:Name="UnitCodeBox" Grid.Column="1" Text="{Binding UnitCode,UpdateSourceTrigger=PropertyChanged}" TabIndex="18" AutomationProperties.Name="{Binding UnitLabel}" local:FieldHelp.Key="UnitCode"/>
     <TextBlock Grid.Row="1" Text="{Binding DimensionLabel}"/>
     <TextBox x:Name="DimensionBox" Grid.Row="1" Grid.Column="1" Text="{Binding UnitDimension,UpdateSourceTrigger=PropertyChanged}" TabIndex="19" AutomationProperties.Name="{Binding DimensionLabel}" local:FieldHelp.Key="UnitDimension"/>
    </Grid>
    <Expander Header="{Binding UnitAdvancedLabel}" Margin="0,6,0,4">
     <Grid IsEnabled="{Binding IsIdle}" Margin="8,4,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="220"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding SymbolLabel}"/>
      <TextBox x:Name="SymbolBox" Grid.Column="1" Text="{Binding UnitSymbol,UpdateSourceTrigger=PropertyChanged}" TabIndex="20" AutomationProperties.Name="{Binding SymbolLabel}" local:FieldHelp.Key="UnitSymbol"/>
      <TextBlock Grid.Row="1" Text="{Binding ScaleLabel}"/>
      <ComboBox x:Name="ScaleBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding UnitScale}" TabIndex="21" AutomationProperties.Name="{Binding ScaleLabel}" local:FieldHelp.Key="UnitScale"/>
      <CheckBox x:Name="DiscreteBox" Grid.Row="2" Grid.ColumnSpan="2" Content="{Binding DiscreteLabel}" IsChecked="{Binding UnitDiscrete}" Margin="0,8,0,8" TabIndex="22" local:FieldHelp.Key="UnitDiscrete"/>
     </Grid>
    </Expander>
    <Button x:Name="AddUnitButton" Content="{Binding AddUnitLabel}" Command="{Binding AddUnitCommand}" HorizontalAlignment="Left" TabIndex="23" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
    <TextBlock x:Name="UnitActionStatus" Text="{Binding Status}" AutomationProperties.LiveSetting="Assertive" Margin="0,6,0,8"/>
   </StackPanel>
  </StackPanel>
 </GroupBox>
</UserControl>
