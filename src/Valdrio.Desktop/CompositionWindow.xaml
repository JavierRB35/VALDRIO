<local:IntegratedWorkspaceWindow x:Class="Valdrio.Desktop.CompositionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Valdrio.Desktop" Title="{Binding [Title]}" Width="1250" Height="850" Background="{DynamicResource Surface.Canvas}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding [Title]}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Context}" Margin="0,4,0,4"/><TextBlock Text="{Binding [Scope]}" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl Grid.Row="1">
   <TabItem Header="{Binding [Catalog]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="{Binding [CatalogHelp]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <WrapPanel Margin="0,0,0,12"><Button Content="{Binding [AddItem]}" Click="AddItem" IsEnabled="{Binding Writable}"/><Button Content="{Binding [RemoveItem]}" Click="RemoveItem" IsEnabled="{Binding Writable}" Margin="8,0,0,0"/><Button Content="{Binding [Save]}" Click="Save" IsEnabled="{Binding Writable}" Margin="8,0,0,0"/></WrapPanel>
    <DataGrid x:Name="CatalogGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" BeginningEdit="CatalogBeginningEdit" MinHeight="200" MaxHeight="600"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{Binding [Recipe]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <Border Style="{StaticResource Card}"><StackPanel>
     <WrapPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [Product]}"/><ComboBox Width="250" ItemsSource="{Binding Products}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Product}"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [Version]}"/><ComboBox Width="180" ItemsSource="{Binding Versions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Version}"/></StackPanel>
      <Button Content="{Binding [Open]}" Click="Open" Margin="0,16,8,8"/><Button Content="{Binding [NewVersion]}" Click="NewVersion" IsEnabled="{Binding Writable}" Margin="0,16,0,8"/>
     </WrapPanel>
     <TextBlock Text="{Binding State}" FontWeight="SemiBold" Margin="0,4,0,8"/>
     <WrapPanel IsEnabled="{Binding Editable}"><StackPanel Margin="0,0,16,8"><TextBlock Text="{Binding [BatchSize]}"/><TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" Width="130"/></StackPanel>
      <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding [Note]}"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="450"/></StackPanel></WrapPanel>
     <TextBlock Text="{Binding [LineHelp]}" TextWrapping="Wrap" Margin="0,4,0,12"/>
     <WrapPanel IsEnabled="{Binding Editable}" Margin="0,0,0,8"><Button Content="{Binding [AddLine]}" Click="AddLine"/><Button Content="{Binding [RemoveLine]}" Click="RemoveLine" Margin="8,0,0,0"/></WrapPanel>
     <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" IsReadOnly="{Binding LinesReadOnly}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="160" MaxHeight="350"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="{Binding [SaveDraft]}" Click="Save" IsEnabled="{Binding Editable}"/><Button Content="{Binding [Publish]}" Click="Publish" IsEnabled="{Binding Editable}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
     <WrapPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [OutputQuantity]}"/><TextBox Text="{Binding OutputQuantity, UpdateSourceTrigger=PropertyChanged}" Width="150"/></StackPanel><Button Content="{Binding [Preview]}" Click="Preview" Margin="0,16,0,8"/></WrapPanel>
     <DataGrid x:Name="AnswersGrid" ItemsSource="{Binding Answers}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="280"/>
     <Expander Header="{Binding [Detail]}" Margin="0,12,0,0"><DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="400"/></Expander>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="{Binding [Close]}" Click="ClosePage"/><Button DockPanel.Dock="Right" Content="{Binding [Reload]}" Click="Reload" Margin="8,0"/><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</local:IntegratedWorkspaceWindow>
