 </StackPanel></WrapPanel></StackPanel></Expander>
<Button x:Name="ApplyPartButton" Content="{Binding [ApplyPart]}" Command="{Binding ApplyPartCommand}" local:FieldHelp.Key="Resource.ApplyPart" Margin="0,4,8,6" Padding="10,6" /></StackPanel></StackPanel>
 <StackPanel Visibility="{Binding ShowReview, Converter={StaticResource Visible}}">
<TextBlock Text="{Binding [ReviewStep]}" Margin="0,4,0,5" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding [ReviewHelp]}" Margin="0,4,0,5"  /><DataGrid x:Name="ReviewGrid" ItemsSource="{Binding Parts}" SelectedItem="{Binding PartChoice}" FlowDirection="LeftToRight" IsEnabled="{Binding CanNavigate}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" MinHeight="90" MaxHeight="240" Margin="0,6,0,8" local:FieldHelp.Key="Resource.Parts"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Amount}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Route}" Width="160" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Target}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Behavior}" Width="140" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Layer}" Width="120" /></DataGrid.Columns></DataGrid><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
