 AutomationProperties.Name="{Binding [Currency]}" ItemsSource="{Binding CurrencyOptions}" />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Type]}" Margin="0,4,0,5"  />
 <TextBox x:Name="AdjustmentForm_TypeBox" Text="{Binding AdjustmentForm[Type], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Type"
 AutomationProperties.Name="{Binding [Type]}"  />
 </StackPanel></WrapPanel>
<StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Reason]}" Margin="0,4,0,5"  />
 <TextBox x:Name="AdjustmentForm_ReasonBox" Text="{Binding AdjustmentForm[Reason], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Reason"
 AutomationProperties.Name="{Binding [Reason]}"  />
 </StackPanel>
 <StackPanel Visibility="{Binding ShowAdjustmentFx, Converter={StaticResource Visible}}"><TextBlock Text="{Binding [QuoteHelp]}" Margin="0,4,0,5"  /><WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Quote]}" Margin="0,4,0,5"  />
 <TextBox x:Name="AdjustmentForm_QuoteBox" Text="{Binding AdjustmentForm[Quote], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Quote"
 AutomationProperties.Name="{Binding [Quote]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [RateDate]}" Margin="0,4,0,5"  />
 <DatePicker x:Name="AdjustmentForm_RateDateBox" SelectedDate="{Binding AdjustmentForm.RateDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.RateDate"
 AutomationProperties.Name="{Binding [RateDate]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [RateSource]}" Margin="0,4,0,5"  />
 <TextBox x:Name="AdjustmentForm_RateSourceBox" Text="{Binding AdjustmentForm[RateSource], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.RateSource"
 AutomationProperties.Name="{Binding [RateSource]}"  />
 </StackPanel></WrapPanel></StackPanel>
 <WrapPanel><Button x:Name="AddAdjustmentButton" Content="{Binding [AddAdjustment]}" Command="{Binding AddAdjustmentCommand}" local:FieldHelp.Key="Resource.AddAdjustment" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="ReverseAdjustmentButton" Content="{Binding [ReverseSelected]}" Command="{Binding ReverseAdjustmentCommand}" local:FieldHelp.Key="Resource.ReverseSelected" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="ClearAdjustmentButton" Content="{Binding [ClearForm]}" Command="{Binding ClearAdjustmentCommand}" local:FieldHelp.Key="Resource.ClearForm" Margin="0,4,8,6" Padding="10,6" /></WrapPanel>
 </StackPanel><Expander Header="{Binding [SourceRows]}"><TextBlock Text="{Binding Sources}" /></Expander>
 </StackPanel>
 <StackPanel Visibility="{Binding ShowParts, Converter={StaticResource Visible}}">
<TextBlock Text="{Binding [PartsStep]}" Margin="0,4,0,5" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding [PartsHelp]}" Margin="0,4,0,5"  /><DataGrid x:Name="PartGrid" ItemsSource="{Binding Parts}" SelectedItem="{Binding PartChoice}" FlowDirection="LeftToRight" IsEnabled="{Binding CanNavigate}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" MinHeight="90" MaxHeight="240" Margin="0,6,0,8" local:FieldHelp.Key="Resource.Parts"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Amount}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Route}" Width="160" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Target}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Behavior}" Width="140" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Layer}" Width="120" /></DataGrid.Columns></DataGrid><WrapPanel><Button x:Name="LoadPartButton" Content="{Binding [EditPart]}" Command="{Binding LoadPartCommand}" local:FieldHelp.Key="Resource.EditPart" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="RemovePartButton" Content="{Binding [RemovePart]}" Command="{Binding RemovePartCommand}" local:FieldHelp.Key="Resource.RemovePart" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="ClearPartButton" Content="{Binding [NewPart]}" Command="{Binding ClearPartCommand}" local:FieldHelp.Key="Resource.NewPart" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="AddPendingButton" Content="{Binding [PendingRemainder]}" Command="{Binding AddPendingCommand}" local:FieldHelp.Key="Resource.PendingRemainder" Margin="0,4,8,6" Padding="10,6" /></WrapPanel>
 <StackPanel IsEnabled="{Binding CanEdit}"><WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [PartAmount]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_AmountBox" Text="{Binding PartForm[Amount], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.PartAmount"
 AutomationProperties.Name="{Binding [PartAmount]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Route]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_RouteBox" SelectedValue="{Binding PartForm.Route, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Route"
 AutomationProperties.Name="{Binding [Route]}" ItemsSource="{Binding Routes}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel></WrapPanel>
 <StackPanel Visibility="{Binding ShowDirect, Converter={StaticResource Visible}}"><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Object]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_ObjectIdBox" SelectedValue="{Binding PartForm.ObjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Object"
 AutomationProperties.Name="{Binding [Object]}" ItemsSource="{Binding Objects}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel><TextBlock Text="{Binding MultipleAssignmentDetails}" />
 <Expander Header="{Binding [CreateObject]}" IsEnabled="{Binding CanEditAdjustmentsAndObjects}"><StackPanel><TextBlock Text="{Binding [ObjectHelp]}" Margin="0,4,0,5"  /><WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ObjectCode]}" Margin="0,4,0,5"  />
 <TextBox x:Name="ObjectForm_CodeBox" Text="{Binding ObjectForm[Code], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ObjectCode"
 AutomationProperties.Name="{Binding [ObjectCode]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ObjectName]}" Margin="0,4,0,5"  />
 <TextBox x:Name="ObjectForm_NameBox" Text="{Binding ObjectForm[Name], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ObjectName"
 AutomationProperties.Name="{Binding [ObjectName]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ObjectKind]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="ObjectKindBox" SelectedValue="{Binding ObjectKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ObjectKind"
 AutomationProperties.Name="{Binding [ObjectKind]}" ItemsSource="{Binding ObjectKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel></WrapPanel><WrapPanel><Button x:Name="PutObjectButton" Content="{Binding [SaveObject]}" Command="{Binding PutObjectCommand}" local:FieldHelp.Key="Resource.SaveObject" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="ClearObjectButton" Content="{Binding [ClearForm]}" Command="{Binding ClearObjectCommand}" local:FieldHelp.Key="Resource.ClearForm" Margin="0,4,8,6" Padding="10,6" /></WrapPanel></StackPanel></Expander></StackPanel>
 <StackPanel Visibility="{Binding ShowPool, Converter={StaticResource Visible}}"><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Pool]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_PoolIdBox" SelectedValue="{Binding PartForm.PoolId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Pool"
 AutomationProperties.Name="{Binding [Pool]}" ItemsSource="{Binding Pools}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel></StackPanel>
 <StackPanel Visibility="{Binding ShowExclusion, Converter={StaticResource Visible}}"><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ExclusionReason]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_ExclusionBox" Text="{Binding PartForm[Exclusion], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ExclusionReason"
 AutomationProperties.Name="{Binding [ExclusionReason]}"  />
 </StackPanel></StackPanel>
 <WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Behavior]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_BehaviorBox" SelectedValue="{Binding PartForm.Behavior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Behavior"
 AutomationProperties.Name="{Binding [Behavior]}" ItemsSource="{Binding Behaviors}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Layer]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_LayerBox" SelectedValue="{Binding PartForm.Layer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Layer"
 AutomationProperties.Name="{Binding [Layer]}" ItemsSource="{Binding Layers}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel></WrapPanel>
 <StackPanel Visibility="{Binding ShowContext, Converter={StaticResource Visible}}"><TextBlock Text="{Binding [ContextHelp]}" Margin="0,4,0,5"  /><WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ActivityUnit]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_UnitIdBox" SelectedValue="{Binding PartForm.UnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ActivityUnit"
