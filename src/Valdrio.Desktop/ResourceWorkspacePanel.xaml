 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [HorizonStart]}" Margin="0,4,0,5"  />
 <DatePicker x:Name="PartForm_StartBox" SelectedDate="{Binding PartForm.Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.HorizonStart"
