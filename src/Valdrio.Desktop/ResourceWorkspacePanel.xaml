 <TextBlock Text="{Binding [HorizonEnd]}" Margin="0,4,0,5"  />
 <DatePicker x:Name="PartForm_EndBox" SelectedDate="{Binding PartForm.End, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.HorizonEnd"
 AutomationProperties.Name="{Binding [HorizonEnd]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Minimum]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_MinimumBox" Text="{Binding PartForm[Minimum], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Minimum"
 AutomationProperties.Name="{Binding [Minimum]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Maximum]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_MaximumBox" Text="{Binding PartForm[Maximum], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Maximum"
 AutomationProperties.Name="{Binding [Maximum]}"  />
 </StackPanel></WrapPanel></StackPanel>
 <Expander Header="{Binding [CapacityTitle]}"><StackPanel><TextBlock Text="{Binding [CapacityHelp]}" Margin="0,4,0,5"  /><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Capacity]}" Margin="0,4,0,5"  />
 <ComboBox x:Name="PartForm_CapacityBox" SelectedValue="{Binding PartForm.Capacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Capacity"
 AutomationProperties.Name="{Binding [Capacity]}" ItemsSource="{Binding Capacities}" DisplayMemberPath="Label" SelectedValuePath="Value" />
 </StackPanel><WrapPanel Visibility="{Binding ShowCapacity, Converter={StaticResource Visible}}"><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Theoretical]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_TheoreticalBox" Text="{Binding PartForm[Theoretical], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Theoretical"
