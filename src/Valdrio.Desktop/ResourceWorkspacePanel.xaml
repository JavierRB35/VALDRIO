 <TextBlock Text="{Binding SaveDestination}" FontWeight="SemiBold" />
 </StackPanel><WrapPanel><Button x:Name="DiscardButton" Content="{Binding [Discard]}" Command="{Binding DiscardCommand}" local:FieldHelp.Key="Resource.Discard" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="CancelButton" Content="{Binding [CancelOperation]}" Command="{Binding CancelCommand}" local:FieldHelp.Key="Resource.CancelOperation" Margin="0,4,8,6" Padding="10,6" /></WrapPanel>
