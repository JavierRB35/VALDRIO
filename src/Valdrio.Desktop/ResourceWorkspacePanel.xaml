<UserControl x:Class="Valdrio.Desktop.ResourceWorkspacePanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Valdrio.Desktop">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="ResourceCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="3,2" /></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="26" /></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="28" /></Style>
 </UserControl.Resources>
 <StackPanel>
<TextBlock Text="{Binding [Introduction]}" Margin="0,4,0,5"  />
 <TextBlock Text="{Binding CurrentAccount}" FontSize="20" FontWeight="SemiBold" />
 <TextBlock Text="{Binding CoverageText}" Margin="0,6,0,8" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
 <TextBlock x:Name="ActionStatus" Text="{Binding Status}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive" />
 <StackPanel Visibility="{Binding CultureChanged, Converter={StaticResource Visible}}">
 <TextBlock Text="{Binding CultureMessage}" />
<Button x:Name="AcknowledgeCultureButton" Content="{Binding [KeepCulture]}" Command="{Binding AcknowledgeCultureCommand}" local:FieldHelp.Key="Resource.KeepCulture" Margin="0,4,8,6" Padding="10,6" /></StackPanel>
 <StackPanel Visibility="{Binding ShowList, Converter={StaticResource Visible}}">
<DataGrid x:Name="ResourceGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding ResourceChoice}" FlowDirection="LeftToRight" IsEnabled="{Binding CanNavigate}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" MinHeight="90" MaxHeight="240" Margin="0,6,0,8" local:FieldHelp.Key="Resource.Rows"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Code}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Originals}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Converted}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Adjustments}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Effective}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Pending}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Difference}" Width="130" /></DataGrid.Columns></DataGrid><Button x:Name="RefreshButton" Content="{Binding [Refresh]}" Command="{Binding RefreshCommand}" local:FieldHelp.Key="Resource.Refresh" Margin="0,4,8,6" Padding="10,6" />
 <Expander Header="{Binding [Advanced]}" Margin="0,10,0,8">
 <StackPanel>
 <Expander Header="{Binding [History]}"><TextBlock Text="{Binding History}" Margin="0,6,0,8" /></Expander>
 <Expander Header="{Binding [RevalueTitle]}">
 <StackPanel><TextBlock Text="{Binding [RevalueHelp]}" Margin="0,4,0,5"  /><Button x:Name="StartRevalueButton" Content="{Binding [StartRevalue]}" Command="{Binding StartRevalueCommand}" local:FieldHelp.Key="Resource.StartRevalue" Margin="0,4,8,6" Padding="10,6" />
 <StackPanel Visibility="{Binding ShowRevalue, Converter={StaticResource Visible}}">
 <ItemsControl ItemsSource="{Binding RevalueRows}" IsEnabled="{Binding CanEditRates}">
 <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,12">
  <TextBlock Text="{Binding Account}" FontWeight="SemiBold" />
  <TextBlock><Run Text="{Binding Previous.OriginalMoney.Amount}" /><Run Text=" · " /><Run Text="{Binding Previous.OriginalMoney.Currency}" /></TextBlock>
  <WrapPanel>
  <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DataContext[Quote], RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <TextBox Width="150" local:FieldHelp.Key="Resource.Quote" Text="{Binding Form[Quote], UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext[QuoteHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext[Quote], RelativeSource={RelativeSource AncestorType=UserControl}}" /></StackPanel>
  <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DataContext[RateDate], RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <DatePicker local:FieldHelp.Key="Resource.RateDate" SelectedDate="{Binding Form.RateDate}" ToolTip="{Binding DataContext[RateDateHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext[RateDate], RelativeSource={RelativeSource AncestorType=UserControl}}" /></StackPanel>
  <StackPanel><TextBlock Text="{Binding DataContext[RateSource], RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <TextBox MinWidth="210" local:FieldHelp.Key="Resource.RateSource" Text="{Binding Form[Source], UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext[RateSourceHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext[RateSource], RelativeSource={RelativeSource AncestorType=UserControl}}" /></StackPanel>
  </WrapPanel>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button x:Name="PrepareRevalueButton" Content="{Binding [PreviewRevalue]}" Command="{Binding PrepareRevalueCommand}" local:FieldHelp.Key="Resource.PreviewRevalue" Margin="0,4,8,6" Padding="10,6" /><TextBlock Text="{Binding RevalueCoverage}" Margin="0,6,0,8" />
<StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ChangeReason]}" Margin="0,4,0,5"  />
 <TextBox x:Name="RevalueReasonBox" Text="{Binding RevalueReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ChangeReason"
 AutomationProperties.Name="{Binding [ChangeReason]}"  />
 </StackPanel><Button x:Name="CommitRevalueButton" Content="{Binding [SaveRevalue]}" Command="{Binding CommitRevalueCommand}" local:FieldHelp.Key="Resource.SaveRevalue" Margin="0,4,8,6" Padding="10,6" /><Button x:Name="CancelRevalueButton" Content="{Binding [CancelRevalue]}" Command="{Binding CancelRevalueCommand}" local:FieldHelp.Key="Resource.CancelRevalue" Margin="0,4,8,6" Padding="10,6" />
 </StackPanel></StackPanel></Expander>
 <Expander Header="{Binding [ResetTitle]}"><StackPanel><TextBlock Text="{Binding [ResetHelp]}" Margin="0,4,0,5"  /><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [ResetReason]}" Margin="0,4,0,5"  />
 <TextBox x:Name="ResetReasonBox" Text="{Binding ResetReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.ResetReason"
 AutomationProperties.Name="{Binding [ResetReason]}"  />
 </StackPanel>
 <CheckBox IsEnabled="{Binding CanEdit}" IsChecked="{Binding ResetAcknowledged}" local:FieldHelp.Key="Resource.ResetAcknowledged"><TextBlock Text="{Binding [ResetAcknowledged]}" /></CheckBox>
<Button x:Name="ResetButton" Content="{Binding [Reset]}" Command="{Binding ResetCommand}" local:FieldHelp.Key="Resource.Reset" Margin="0,4,8,6" Padding="10,6" /></StackPanel></Expander>
 </StackPanel></Expander></StackPanel>
 <StackPanel Visibility="{Binding ShowAdjustments, Converter={StaticResource Visible}}">
<TextBlock Text="{Binding [AdjustmentStep]}" Margin="0,4,0,5" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding [AdjustmentHelp]}" Margin="0,4,0,5"  /><DataGrid x:Name="AdjustmentGrid" ItemsSource="{Binding Adjustments}" SelectedItem="{Binding AdjustmentChoice}" FlowDirection="LeftToRight" IsEnabled="{Binding CanNavigate}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" MinHeight="90" MaxHeight="240" Margin="0,6,0,8" local:FieldHelp.Key="Resource.Adjustments"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Original}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Functional}" Width="130" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Type}" Width="120" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding Reason}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource ResourceCell}" Binding="{Binding State}" Width="100" /></DataGrid.Columns></DataGrid>
 <StackPanel IsEnabled="{Binding CanEditAdjustmentsAndObjects}">
 <WrapPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [SignedAmount]}" Margin="0,4,0,5"  />
 <TextBox x:Name="AdjustmentForm_AmountBox" Text="{Binding AdjustmentForm[Amount], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.SignedAmount"
 AutomationProperties.Name="{Binding [SignedAmount]}"  />
 </StackPanel><StackPanel Margin="0,0,12,10" MinWidth="205" MaxWidth="600">
 <TextBlock Text="{Binding [Currency]}" Margin="0,4,0,5"  />
