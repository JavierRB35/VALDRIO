 <TextBlock Text="{Binding [Actual]}" Margin="0,4,0,5"  />
 <TextBox x:Name="PartForm_ActualBox" Text="{Binding PartForm[Actual], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" local:FieldHelp.Key="Resource.Actual"
