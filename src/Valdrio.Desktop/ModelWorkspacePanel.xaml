<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.ModelWorkspacePanel">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
   <Setter Property="Margin" Value="0,4,8,4"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,4,8,3"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
   <Setter Property="IsEnabled" Value="{Binding InputsEnabled}"/>
   <Setter Property="MinWidth" Value="140"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Margin" Value="0,3,8,3"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
   <Setter Property="IsEnabled" Value="{Binding InputsEnabled}"/>
   <Setter Property="MinWidth" Value="160"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Margin" Value="0,3,8,3"/>
   <Setter Property="DisplayMemberPath" Value="Label"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,2,0,4"/>
  </Style>
  <Style x:Key="SectionHelp" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="4,2"/>
  </Style>
  <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,0,8,6"/>
  </Style>
  <Style x:Key="InlineStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Accent.ActiveGreen}"/>
   <Setter Property="Margin" Value="0,6,0,4"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasError}" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>

 <GroupBox Header="{Binding Title}" Padding="14">
  <StackPanel>
   <TextBlock Text="{Binding Notes}" Style="{StaticResource SectionHelp}"/>

   <Border Background="{DynamicResource Surface.Subtle}" Margin="0,0,0,8" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="{Binding NextRequirement}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Assertive">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Accent.ActiveGreen}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasError}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>

   <TabControl SelectionChanged="ModelStepChanged" x:Name="ModelSteps">
    <TabItem x:Name="ModelTab0">
     <StackPanel Margin="10">
      <TextBlock Text="{Binding ModelLabel}" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding ModelStepHelp}" Style="{StaticResource SectionHelp}"/>

      <TextBlock Text="{Binding ExistingModelHelp}" FontWeight="SemiBold"/>
      <DockPanel Margin="0,0,0,10">
       <Button x:Name="LoadModelButton" DockPanel.Dock="Right" Content="{Binding LoadLabel}" Command="{Binding LoadCommand}" TabIndex="31" AutomationProperties.HelpText="{Binding LoadSelectionHelp}">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding HasPendingModelSelection}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brand.DeepGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.White}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.DeepGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
       </Button>
       <ComboBox x:Name="ModelBox" ItemsSource="{Binding Models}" SelectedItem="{Binding ModelChoice}" TabIndex="30" AutomationProperties.Name="{Binding ModelLabel}" local:FieldHelp.Key="ModelChoice"/>
      </DockPanel>
      <TextBlock Text="{Binding LoadSelectionHelp}" Foreground="{DynamicResource Accent.ActiveGreen}" FontWeight="SemiBold"
                 AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"
                 Visibility="{Binding HasPendingModelSelection, Converter={StaticResource BooleanVisibility}}"/>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding NewModelHelp}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding DescriptionLabel}"/>
        <TextBox x:Name="DescriptionBox" IsReadOnly="{Binding DescriptionReadOnly}" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" TabIndex="32" AutomationProperties.Name="{Binding DescriptionLabel}" local:FieldHelp.Key="Description"/>
        <WrapPanel>
         <Button x:Name="NewDraftButton" Content="{Binding NewDraftLabel}" Command="{Binding NewDraftCommand}" TabIndex="33" Style="{StaticResource Button.Primary}"/>
         <Button x:Name="CloneModelButton" Content="{Binding CloneLabel}" Command="{Binding CloneCommand}" TabIndex="37"/>
         <Button x:Name="DeleteDraftModelButton" Content="{Binding DeleteDraftModelLabel}" Command="{Binding DeleteDraftModelCommand}" TabIndex="55"
                 Foreground="{DynamicResource Brand.Red}" ToolTip="{Binding DeleteDraftModelLabel}"/>
         <Button x:Name="ArchiveModelButton" Content="{Binding ArchiveModelLabel}" Command="{Binding ArchiveModelCommand}" TabIndex="56"
                 ToolTip="{Binding ArchiveModelLabel}"/>
         <Button ToolTip="{Binding RefreshHelp}" local:FieldHelp.Key="RefreshModel" x:Name="RefreshModelButton" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" TabIndex="39"/>
        </WrapPanel>
        <CheckBox IsChecked="{Binding ShowArchivedModels, Mode=TwoWay}" Content="{Binding ShowArchivedModelsLabel}"
                  Margin="0,8,0,0" AutomationProperties.Name="{Binding ShowArchivedModelsLabel}"/>
        <TextBlock Text="{Binding RefreshHelp}" Style="{StaticResource FieldHint}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab1">
     <StackPanel Margin="10">
      <TextBlock TextWrapping="Wrap" x:Name="MastersHelp" Style="{StaticResource SectionHelp}"/>

      <GroupBox Header="{Binding CenterLabel}" Padding="12" Margin="0,0,0,12">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="0.9*"/>
         <ColumnDefinition Width="16"/>
         <ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{Binding CenterSectionHelp}" Style="{StaticResource SectionHelp}"/>

        <Border Grid.Row="1" Grid.Column="0" IsEnabled="{Binding CanEditMasters}" Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="{Binding CenterFormTitle}" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{Binding CenterRequiredHelp}" Style="{StaticResource FieldHint}"/>

<StackPanel Visibility="{Binding NewCenterFormVisibility}">
          <TextBlock Text="{Binding CenterCodeLabel}"/>
          <TextBox x:Name="CenterCodeBox" Text="{Binding CenterCode,UpdateSourceTrigger=PropertyChanged}" TabIndex="25" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding CenterCodeLabel}" local:FieldHelp.Key="CenterCode"/>
          <TextBlock Text="{Binding CenterCodeValidation}" Style="{StaticResource InlineStatus}" AutomationProperties.LiveSetting="Assertive" Margin="0,2,0,6"/>

          <TextBlock Text="{Binding CenterNameLabel}"/>
          <TextBox x:Name="CenterNameBox" Text="{Binding CenterName,UpdateSourceTrigger=PropertyChanged}" TabIndex="26" AutomationProperties.Name="{Binding CenterNameLabel}" local:FieldHelp.Key="CenterName"/>

</StackPanel>
          <WrapPanel Margin="0,6,0,0">
           <Button local:FixedPageActions.Pin="True" x:Name="SaveCenterButton" Content="{Binding CenterPrimaryActionLabel}" Command="{Binding SaveCenterFormCommand}" TabIndex="27" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
           <Button x:Name="CreateCenterButton" Visibility="{Binding NewCenterVisibility}" Content="{Binding NewCenterLabel}" Command="{Binding NewCenterCommand}" TabIndex="28"/>
          </WrapPanel>
          <TextBlock Text="{Binding CenterFeedback}" Style="{StaticResource InlineStatus}" AutomationProperties.LiveSetting="Assertive"/>

          <Separator Margin="0,8,0,6"/>
          <TextBlock Text="{Binding CenterStateHelp}" Style="{StaticResource SectionHelp}"/>
          <Button Content="{Binding DeleteCenterLabel}" Command="{Binding DeleteCenterCommand}" HorizontalAlignment="Left"/>
          <Button x:Name="ToggleCenterButton" Content="{Binding CenterStateActionLabel}" Command="{Binding ToggleCenterCommand}" HorizontalAlignment="Left" TabIndex="29"/>
         </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="2">
         <TextBlock Text="{Binding CenterListTitle}" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="{Binding CenterListHelp}" Style="{StaticResource SectionHelp}"/><TextBlock Text="{Binding TableEditHelp}" Style="{StaticResource SectionHelp}"/>
         <ComboBox x:Name="MasterBox" ItemsSource="{Binding Centers}" SelectedItem="{Binding Master}" Visibility="Collapsed"/>
         <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="CenterGrid" ItemsSource="{Binding Centers}" SelectedItem="{Binding Master}" IsReadOnly="{Binding CentersReadOnly}" BeginningEdit="BeginStructureCellEdit" CellEditEnding="EndStructureCellEdit" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" MinHeight="170" HeadersVisibility="Column" local:FieldHelp.Key="Master">
          <DataGrid.Columns>
           <DataGridTemplateColumn Width="140" SortMemberPath="Value.Code">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding Value.Code}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.CenterCode, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DataContext.CenterCode, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" MinWidth="40"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
           <DataGridTemplateColumn Width="*" SortMemberPath="Value.Name">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding Value.Name}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.CenterName, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DataContext.CenterName, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" MinWidth="40"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
           <DataGridTextColumn ElementStyle="{StaticResource CellText}" IsReadOnly="True" Binding="{Binding StatusLabel}" Width="120"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel>
       </Grid>
      </GroupBox>

      <Expander Header="{Binding UnitCatalogTitle}" Margin="0,2,0,0">
       <StackPanel Margin="8,6,0,4">
        <TextBlock Text="{Binding UnitSectionHelp}" Style="{StaticResource SectionHelp}"/>
        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding UnitMaster}" TabIndex="51" AutomationProperties.Name="{Binding UnitLabel}" local:FieldHelp.Key="UnitMaster"/>
        <Button x:Name="ToggleUnitButton" Content="{Binding ToggleUnitLabel}" Command="{Binding ToggleUnitCommand}" HorizontalAlignment="Left" TabIndex="52"/>
        <ContentControl x:Name="UnitsCreationHost"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab2">
     <StackPanel Margin="10">
      <TextBlock TextWrapping="Wrap" x:Name="NodesHelp" Style="{StaticResource SectionHelp}"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"
              Visibility="{Binding HasNoModel, Converter={StaticResource Visible}}">
       <StackPanel>
        <TextBlock Text="{Binding NodeEditorMissingModelHelp}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="GoToModelSetupButton" Content="{Binding ModelLabel}"
                Click="OpenModelSetup" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"
              Visibility="{Binding ShowPublishedNodeLock, Converter={StaticResource Visible}}">
       <StackPanel>
        <TextBlock Text="{Binding NodeEditorPublishedHelp}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CloneToEditNodesButton" Content="{Binding CloneLabel}"
                Command="{Binding CloneCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Style="{StaticResource Button.Primary}"/>
       </StackPanel>
      </Border>
      <TextBlock Text="{Binding NodeClassificationHelp}" Style="{StaticResource SectionHelp}"/>

      <TextBlock Text="{Binding NodeListTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding NodeListHelp}" Style="{StaticResource SectionHelp}"/><TextBlock Text="{Binding TableEditHelp}" Style="{StaticResource SectionHelp}"/>

      <ComboBox x:Name="NodeBox" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Visibility="Collapsed"/>
      <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="NodeSummary" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" IsReadOnly="{Binding NodesReadOnly}" BeginningEdit="BeginStructureCellEdit" CellEditEnding="EndStructureCellEdit" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" MinHeight="180" IsEnabled="{Binding CanSelectNode}" local:FieldHelp.Key="SelectedNode">
       <DataGrid.Columns>
        <DataGridTemplateColumn Width="220" SortMemberPath="CenterLabel">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding CenterLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.Physical.Label, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Centers, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding DataContext.Physical, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" IsEnabled="True" MinWidth="60"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTemplateColumn Width="110" SortMemberPath="Node.Code">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding Node.Code}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.NodeCode, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DataContext.NodeCode, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" MinWidth="40"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTemplateColumn Width="115" SortMemberPath="RoleLabel">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding RoleLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.Role.Label, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding DataContext.Role, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" IsEnabled="True" MinWidth="60"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTemplateColumn Width="90" SortMemberPath="UnitLabel">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding UnitLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.DriverUnit.Label, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding DataContext.DriverUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" IsEnabled="True" MinWidth="60"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTemplateColumn Width="1.3*" MinWidth="180" MaxWidth="320" SortMemberPath="PoolLabel">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding PoolLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.PoolDescription, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DataContext.PoolDescription, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" MinWidth="40"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTemplateColumn Width="1.25*" MinWidth="210" MaxWidth="340" SortMemberPath="FunctionsLabel">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
 <Setter Property="Text" Value="{Binding FunctionsLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.FunctionTags, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding DataContext.AdditionalFunctionTags, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" MinWidth="40"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding EconomicFunctionDisplay}" Width="1.1*" MinWidth="190" MaxWidth="260" SortMemberPath="EconomicFunctionDisplay" IsReadOnly="True">
         <DataGridTextColumn.ElementStyle>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.TableText}">
           <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
           <Setter Property="ToolTip" Value="{Binding EconomicFunctionDisplay}"/>
          </Style>
         </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="{Binding StudyNodeCreationWarning}" Foreground="{DynamicResource Text.Secondary}"
                 TextWrapping="Wrap" Margin="4,4,4,8"
                 Visibility="{Binding HasStudyNodeCreationRestriction, Converter={StaticResource Visible}}"/>
      <GroupBox x:Name="NodeEditor" Header="{Binding NodeFormTitle}" IsEnabled="{Binding CanEdit}" Padding="12" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="{Binding NodeSectionHelp}" Style="{StaticResource SectionHelp}"/>
        <TextBlock Text="{Binding NodeRequiredHelp}" Style="{StaticResource FieldHint}"/>

<StackPanel Visibility="{Binding NewNodeFormVisibility}">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding NodeCodeLabel}"/>
          <TextBox x:Name="NodeCodeBox" Text="{Binding NodeCode,UpdateSourceTrigger=PropertyChanged}" TabIndex="39" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding NodeCodeLabel}" local:FieldHelp.Key="NodeCode"/>
          <TextBlock Text="{Binding PoolLabel}"/>
          <TextBox x:Name="PoolBox" Text="{Binding PoolDescription,UpdateSourceTrigger=PropertyChanged}" TabIndex="40" AutomationProperties.Name="{Binding PoolLabel}" local:FieldHelp.Key="PoolDescription"/>
         </StackPanel>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding PhysicalLabel}"/>
          <ComboBox x:Name="PhysicalBox" ItemsSource="{Binding Centers}" SelectedItem="{Binding Physical}" TabIndex="42" AutomationProperties.Name="{Binding PhysicalLabel}" local:FieldHelp.Key="Physical"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding RoleLabel}"/>
          <ComboBox x:Name="RoleBox" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" TabIndex="43" AutomationProperties.Name="{Binding RoleLabel}" local:FieldHelp.Key="Role"/>
          <TextBlock Text="{Binding RoleHelp}" Style="{StaticResource FieldHint}"/>
         </StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding UnitLabel}"/>
          <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" SelectedItem="{Binding DriverUnit}" TabIndex="45" AutomationProperties.Name="{Binding UnitLabel}" local:FieldHelp.Key="DriverUnit"/>
          <TextBlock Text="{Binding UnitHelp}" Style="{StaticResource FieldHint}"/>
         </StackPanel>

        </Grid>

</StackPanel>
        <StackPanel Margin="0,10,0,8">
         <TextBlock Text="{Binding EconomicClassificationHelp}" Style="{StaticResource SectionHelp}"/>
         <WrapPanel>
          <StackPanel Width="300" Margin="0,0,16,4">
           <TextBlock Text="{Binding EconomicFunctionLabel}"/>
           <ComboBox x:Name="EconomicFunctionBox" ItemsSource="{Binding EconomicFunctions}"
                     DisplayMemberPath="Label" SelectedValuePath="Value"
                     SelectedValue="{Binding EconomicFunctionChoice, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding EconomicFunctionLabel}" TabIndex="46"/>
          </StackPanel>
          <StackPanel Width="300" Margin="0,0,16,4">
           <TextBlock Text="{Binding TariffPurposeLabel}"/>
           <ComboBox x:Name="TariffPurposeBox" ItemsSource="{Binding TariffPurposes}"
                     DisplayMemberPath="Label" SelectedValuePath="Value"
                     SelectedValue="{Binding TariffPurposeChoice, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding TariffPurposeLabel}" TabIndex="47"/>
          </StackPanel>
         </WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding PoolHelp}" Style="{StaticResource FieldHint}"/>

        <Expander x:Name="NodeUnitCreator" Header="{Binding CreateUnitHereLabel}" Margin="0,4,0,8">
         <StackPanel Margin="8,4,0,4">
          <TextBlock Text="{Binding CreateUnitHereHelp}" Style="{StaticResource SectionHelp}"/>
          <ContentControl x:Name="NodeUnitsCreationHost"/>
         </StackPanel>
        </Expander>

        <Expander Visibility="{Binding NewNodeFormVisibility}" Header="{Binding OptionalNodeDataLabel}" Margin="0,6,0,4">
         <StackPanel>
          <TextBlock Text="{Binding FunctionHelp}" Style="{StaticResource SectionHelp}"/>
          <TextBlock Text="{Binding FunctionLabel}"/>
          <TextBox x:Name="FunctionBox" Text="{Binding AdditionalFunctionTags,UpdateSourceTrigger=PropertyChanged}" TabIndex="44" AutomationProperties.Name="{Binding FunctionLabel}" local:FieldHelp.Key="FunctionTags"/>
         </StackPanel>
        </Expander>

        <TextBlock Text="{Binding NodePersistenceHelp}" Style="{StaticResource SectionHelp}"/>
        <WrapPanel>
         <Button local:FixedPageActions.Pin="True" x:Name="ApplyNodeButton" Content="{Binding NodePrimaryActionLabel}" Command="{Binding SaveNodeCommand}" TabIndex="48" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
         <Button x:Name="NewNodeButton" Content="{Binding NewNodeLabel}" Command="{Binding NewNodeCommand}" TabIndex="49"/>
         <Button x:Name="RemoveNodeButton" Content="{Binding RemoveLabel}" Command="{Binding DeleteNodeCommand}" TabIndex="50" Foreground="{DynamicResource Brand.Red}"/>
        </WrapPanel>
        <TextBlock Text="{Binding NodeFeedback}" Style="{StaticResource InlineStatus}" AutomationProperties.LiveSetting="Assertive"/>
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab3">
     <StackPanel Margin="10">
      <TextBlock Text="{Binding ReviewModelHelp}" Style="{StaticResource SectionHelp}"/>

      <WrapPanel local:FixedPageActions.Pin="True">
       <Button x:Name="SaveModelButton" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" TabIndex="34"/>
       <Button x:Name="ValidateModelButton" Content="{Binding ValidateLabel}" Command="{Binding ValidateCommand}" TabIndex="35"/>
       <Button x:Name="PublishModelButton" Content="{Binding PublishLabel}" Command="{Binding PublishCommand}" TabIndex="36" Style="{StaticResource Button.Primary}"/>
      </WrapPanel>

      <TextBlock Text="{Binding Details}"/>
      <Border Style="{StaticResource Card}" Margin="0,8,0,12">
       <StackPanel>
        <TextBlock Text="{Binding ProcessMapTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding ProcessMapHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding ProcessMapSummary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,0,0,8">
         <CheckBox x:Name="MapConnectToggle" Content="{Binding ProcessMapConnectLabel}"
                   IsEnabled="{Binding CanEditProcessMap}" Checked="MapOptionsChanged" Unchecked="MapOptionsChanged"
                   Margin="4,4,14,4"/>
         <ComboBox x:Name="MapLinkKindBox" Width="205" SelectedIndex="0"
                   IsEnabled="{Binding CanEditProcessMap}" SelectionChanged="MapOptionsChanged"
                   Margin="4,2,14,2">
          <ComboBoxItem Content="{Binding ProcessMapSequenceLabel}" Tag="Sequence"/>
          <ComboBoxItem Content="{Binding ProcessMapServiceLabel}" Tag="AuxiliaryService"/>
         </ComboBox>
         <CheckBox x:Name="MapRemoveToggle" Content="{Binding ProcessMapRemoveLabel}"
                   IsEnabled="{Binding CanEditProcessMap}" Checked="MapOptionsChanged" Unchecked="MapOptionsChanged"
                   Margin="4,4,14,4"/>
         <TextBlock Text="{Binding ProcessMapZoomLabel}" Margin="6,8,4,0"/>
         <Slider x:Name="MapZoomSlider" Width="120" Minimum="0.5" Maximum="2" Value="1"
                 SmallChange="0.1" TickFrequency="0.25" IsSnapToTickEnabled="False"
                 ValueChanged="MapZoomChanged" Margin="4,0,12,0"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
         <Button Content="{Binding ProcessMapArrangeLabel}" IsEnabled="{Binding CanEditProcessMap}"
                 Click="AutoArrangeProcessMap"/>
         <Button Content="{Binding ProcessMapValidateLabel}" IsEnabled="{Binding CanEditProcessMap}"
                 Click="ValidateProcessMap" Style="{StaticResource Button.Primary}"/>
         <Button Content="{Binding ProcessMapExportLabel}" Click="ExportProcessMap"/>
        </WrapPanel>
        <TextBlock Text="{Binding ProcessMapFeedback}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
        <local:ProcessRouteCanvas x:Name="ProcessMapCanvas" MinHeight="400"/>
       </StackPanel>
      </Border>
      <Expander Header="{Binding ReviewTreeLabel}" Margin="0,0,0,8" IsExpanded="False">
       <StackPanel>
        <TextBlock Text="{Binding ProcessMapOriginalTreeHelp}" TextWrapping="Wrap" Margin="0,0,0,5"/>
        <TextBlock Text="{Binding ReviewTreeLabel}" FontWeight="SemiBold"/>
      <TreeView x:Name="StructureReviewTree" ItemsSource="{Binding ReviewTree}" AutomationProperties.Name="{Binding ReviewTreeLabel}">
       <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:CenterTreeRow}" ItemsSource="{Binding Children}">
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:NodeOption}">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Node.Code}" Margin="0,3,12,3"/>
          <TextBlock Text="{Binding RoleLabel}" Margin="0,3,12,3"/>
          <TextBlock Text="{Binding UnitLabel}" Margin="0,3,12,3"/>
          <TextBlock Text="{Binding FunctionsLabel}"/>
         </StackPanel>
        </DataTemplate>
        <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style>
       </TreeView.Resources>
      </TreeView>
       </StackPanel>
      </Expander>
      <Expander Header="{Binding TechnicalDetailsLabel}"><TextBlock Text="{Binding TechnicalDetails}"/></Expander>
      <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource Brand.Red}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>

      <Expander Header="{Binding OtherOperationsLabel}" Margin="0,10,0,0">
       <StackPanel>
        <Button x:Name="DiscardModelButton" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}" TabIndex="38"/>
        <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" TabIndex="54"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </TabItem>
   </TabControl>
  </StackPanel>
 </GroupBox>
</UserControl>
