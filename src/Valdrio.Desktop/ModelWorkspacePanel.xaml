<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="clr-namespace:Valdrio.Desktop"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Valdrio.Desktop.ModelWorkspacePanel">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="0,4,8,4" />
   <Setter Property="Padding" Value="12,7" />
   <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="Margin" Value="0,4,8,3" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="IsEnabled" Value="{Binding InputsEnabled}" />
   <Setter Property="MinWidth" Value="140" />
   <Setter Property="MinHeight" Value="32" />
   <Setter Property="Margin" Value="0,3,8,3" />
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="IsEnabled" Value="{Binding InputsEnabled}" />
   <Setter Property="MinWidth" Value="160" />
   <Setter Property="MinHeight" Value="32" />
   <Setter Property="Margin" Value="0,3,8,3" />
   <Setter Property="DisplayMemberPath" Value="Label" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="17" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Margin" Value="0,2,0,4" />
  </Style>
  <Style x:Key="SectionHelp" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#4F6072" />
   <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="Margin" Value="4,2" />
  </Style>
  <Style x:Key="FieldHint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#617286" />
   <Setter Property="FontSize" Value="11" />
   <Setter Property="Margin" Value="0,0,8,6" />
  </Style>
 </UserControl.Resources>

 <GroupBox Header="{Binding Title}" Padding="14">
  <StackPanel>
   <TextBlock Text="{Binding Notes}" Style="{StaticResource SectionHelp}" />

   <Border Background="#EEF5FF" BorderBrush="#BDD4F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
    <StackPanel>
     <TextBlock Text="{Binding NextRequirement}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Assertive">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="DarkSlateBlue" />
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasError}" Value="True">
          <Setter Property="Foreground" Value="DarkRed" />
          <Setter Property="FontWeight" Value="SemiBold" />
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>

   <TabControl SelectionChanged="ModelStepChanged" x:Name="ModelSteps">
    <TabItem x:Name="ModelTab0">
     <StackPanel Margin="10">
      <TextBlock Text="{Binding ModelLabel}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding ModelStepHelp}" Style="{StaticResource SectionHelp}" />

      <TextBlock Text="{Binding ExistingModelHelp}" FontWeight="SemiBold" />
      <DockPanel Margin="0,0,0,10">
       <Button x:Name="LoadModelButton" DockPanel.Dock="Right" Content="{Binding LoadLabel}" Command="{Binding LoadCommand}" TabIndex="31" />
       <ComboBox x:Name="ModelBox" ItemsSource="{Binding Models}" SelectedItem="{Binding ModelChoice}" TabIndex="30"
                 AutomationProperties.Name="{Binding ModelLabel}" local:FieldHelp.Key="ModelChoice" />
      </DockPanel>

      <Border BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="6" Padding="12">
       <StackPanel>
        <TextBlock Text="{Binding NewModelHelp}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DescriptionLabel}" />
        <TextBox x:Name="DescriptionBox" IsReadOnly="{Binding DescriptionReadOnly}"
                 Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" TabIndex="32"
                 AutomationProperties.Name="{Binding DescriptionLabel}" local:FieldHelp.Key="Description" />
        <WrapPanel>
         <Button x:Name="NewDraftButton" Content="{Binding NewDraftLabel}" Command="{Binding NewDraftCommand}" TabIndex="33" />
         <Button x:Name="CloneModelButton" Content="{Binding CloneLabel}" Command="{Binding CloneCommand}" TabIndex="37" />
         <Button x:Name="RefreshModelButton" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" TabIndex="39" />
        </WrapPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab1">
     <StackPanel Margin="10">
      <TextBlock TextWrapping="Wrap" x:Name="MastersHelp" Style="{StaticResource SectionHelp}" />

      <GroupBox Header="{Binding CenterLabel}" Padding="12" Margin="0,0,0,12">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="0.9*" />
         <ColumnDefinition Width="16" />
         <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{Binding CenterSectionHelp}" Style="{StaticResource SectionHelp}" />

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="6" Padding="12" IsEnabled="{Binding CanEditMasters}">
         <StackPanel>
          <TextBlock Text="{Binding CenterFormTitle}" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="{Binding CenterCodeLabel}" />
          <TextBox x:Name="CenterCodeBox" Text="{Binding CenterCode,UpdateSourceTrigger=PropertyChanged}"
                   TabIndex="25" FlowDirection="LeftToRight"
                   AutomationProperties.Name="{Binding CenterCodeLabel}" local:FieldHelp.Key="CenterCode" />

          <TextBlock Text="{Binding CenterNameLabel}" />
          <TextBox x:Name="CenterNameBox" Text="{Binding CenterName,UpdateSourceTrigger=PropertyChanged}"
                   TabIndex="26" AutomationProperties.Name="{Binding CenterNameLabel}" local:FieldHelp.Key="CenterName" />

          <WrapPanel Margin="0,6,0,0">
           <Button x:Name="SaveCenterButton" Content="{Binding CenterPrimaryActionLabel}"
                   Command="{Binding SaveCenterFormCommand}" TabIndex="27" />
           <Button x:Name="CreateCenterButton" Content="{Binding NewCenterLabel}"
                   Command="{Binding NewCenterCommand}" TabIndex="28" />
          </WrapPanel>

          <Separator Margin="0,8,0,6" />
          <TextBlock Text="{Binding CenterStateHelp}" Style="{StaticResource SectionHelp}" />
          <Button x:Name="ToggleCenterButton" Content="{Binding CenterStateActionLabel}"
                  Command="{Binding ToggleCenterCommand}" HorizontalAlignment="Left" TabIndex="29" />
         </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="2">
         <TextBlock Text="{Binding CenterListTitle}" Style="{StaticResource SectionTitle}" />
         <TextBlock Text="{Binding CenterListHelp}" Style="{StaticResource SectionHelp}" />
         <ComboBox x:Name="MasterBox" ItemsSource="{Binding Centers}" SelectedItem="{Binding Master}" Visibility="Collapsed" />
         <DataGrid x:Name="CenterGrid" ItemsSource="{Binding Centers}" SelectedItem="{Binding Master}"
                   IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                   CanUserAddRows="False" MinHeight="170" MaxHeight="320" HeadersVisibility="Column"
                   local:FieldHelp.Key="Master">
          <DataGrid.Columns>
           <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding Value.Code}" Width="140" />
           <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding Value.Name}" Width="*" />
           <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding StatusLabel}" Width="120" />
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel>
       </Grid>
      </GroupBox>

      <GroupBox Header="{Binding UnitLabel}" Padding="12">
       <StackPanel>
        <TextBlock Text="{Binding UnitSectionHelp}" Style="{StaticResource SectionHelp}" />
        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding UnitMaster}" TabIndex="51"
                  AutomationProperties.Name="{Binding UnitLabel}" local:FieldHelp.Key="UnitMaster" />
        <Button x:Name="ToggleUnitButton" Content="{Binding ToggleUnitLabel}" Command="{Binding ToggleUnitCommand}"
                HorizontalAlignment="Left" TabIndex="52" />
        <ContentControl x:Name="UnitsCreationHost" />
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab2">
     <StackPanel Margin="10">
      <TextBlock TextWrapping="Wrap" x:Name="NodesHelp" Style="{StaticResource SectionHelp}" />

      <TextBlock Text="{Binding NodeListTitle}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding NodeListHelp}" Style="{StaticResource SectionHelp}" />

      <ComboBox x:Name="NodeBox" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Visibility="Collapsed" />
      <DataGrid x:Name="NodeSummary" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                CanUserAddRows="False" MinHeight="180" MaxHeight="330" IsEnabled="{Binding CanSelectNode}"
                local:FieldHelp.Key="SelectedNode">
       <DataGrid.Columns>
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding Node.Code}" Width="110" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding CenterLabel}" Width="120" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding RoleLabel}" Width="115" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding UnitLabel}" Width="90" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding LayerLabel}" Width="110" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding PoolLabel}" Width="*" />
        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Binding="{Binding FunctionsLabel}" Width="160" />
       </DataGrid.Columns>
      </DataGrid>

      <GroupBox x:Name="NodeEditor" Header="{Binding NodeFormTitle}" IsEnabled="{Binding CanEdit}" Padding="12" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="{Binding NodeSectionHelp}" Style="{StaticResource SectionHelp}" />

        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding NodeCodeLabel}" />
          <TextBox x:Name="NodeCodeBox" Text="{Binding NodeCode,UpdateSourceTrigger=PropertyChanged}"
                   TabIndex="41" FlowDirection="LeftToRight"
                   AutomationProperties.Name="{Binding NodeCodeLabel}" local:FieldHelp.Key="NodeCode" />
         </StackPanel>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding PhysicalLabel}" />
          <ComboBox x:Name="PhysicalBox" ItemsSource="{Binding Centers}" SelectedItem="{Binding Physical}"
                    TabIndex="42" AutomationProperties.Name="{Binding PhysicalLabel}" local:FieldHelp.Key="Physical" />
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding RoleLabel}" />
          <ComboBox x:Name="RoleBox" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                    TabIndex="43" AutomationProperties.Name="{Binding RoleLabel}" local:FieldHelp.Key="Role" />
          <TextBlock Text="{Binding RoleHelp}" Style="{StaticResource FieldHint}" />
         </StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding UnitLabel}" />
          <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" SelectedItem="{Binding DriverUnit}"
                    TabIndex="45" AutomationProperties.Name="{Binding UnitLabel}" local:FieldHelp.Key="DriverUnit" />
          <TextBlock Text="{Binding UnitHelp}" Style="{StaticResource FieldHint}" />
         </StackPanel>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding LayerLabel}" />
          <ComboBox x:Name="LayerBox" ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}"
                    TabIndex="46" AutomationProperties.Name="{Binding LayerLabel}" local:FieldHelp.Key="Layer" />
          <TextBlock Text="{Binding LayerHelp}" Style="{StaticResource FieldHint}" />
         </StackPanel>
        </Grid>

        <TextBlock Text="{Binding PoolLabel}" />
        <TextBlock Text="{Binding PoolHelp}" Style="{StaticResource FieldHint}" />
        <TextBox x:Name="PoolBox" Text="{Binding PoolDescription,UpdateSourceTrigger=PropertyChanged}"
                 TabIndex="47" AutomationProperties.Name="{Binding PoolLabel}" local:FieldHelp.Key="PoolDescription" />

        <Expander Header="{Binding OptionalNodeDataLabel}" Margin="0,6,0,4">
         <StackPanel>
          <TextBlock Text="{Binding FunctionHelp}" Style="{StaticResource SectionHelp}" />
          <TextBlock Text="{Binding FunctionLabel}" />
          <TextBox x:Name="FunctionBox" Text="{Binding FunctionTags,UpdateSourceTrigger=PropertyChanged}"
                   TabIndex="44" AutomationProperties.Name="{Binding FunctionLabel}" local:FieldHelp.Key="FunctionTags" />
         </StackPanel>
        </Expander>

        <TextBlock Text="{Binding NodePersistenceHelp}" Style="{StaticResource SectionHelp}" />
        <WrapPanel>
         <Button x:Name="ApplyNodeButton" Content="{Binding NodePrimaryActionLabel}"
                 Command="{Binding SaveNodeCommand}" TabIndex="48" />
         <Button x:Name="NewNodeButton" Content="{Binding NewNodeLabel}" Command="{Binding NewNodeCommand}" TabIndex="49" />
         <Button x:Name="RemoveNodeButton" Content="{Binding RemoveLabel}" Command="{Binding DeleteNodeCommand}" TabIndex="50" />
        </WrapPanel>
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </TabItem>

    <TabItem x:Name="ModelTab3">
     <StackPanel Margin="10">
      <TextBlock Text="{Binding ReviewModelHelp}" Style="{StaticResource SectionHelp}" />

      <WrapPanel>
       <Button x:Name="SaveModelButton" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" TabIndex="34" />
       <Button x:Name="ValidateModelButton" Content="{Binding ValidateLabel}" Command="{Binding ValidateCommand}" TabIndex="35" />
       <Button x:Name="PublishModelButton" Content="{Binding PublishLabel}" Command="{Binding PublishCommand}" TabIndex="36" />
      </WrapPanel>

      <TextBlock Text="{Binding Details}" />
      <TextBlock Text="{Binding HistoricalDefinitions}" />
      <TextBlock Text="{Binding ValidationText}" Foreground="DarkRed" FontWeight="SemiBold"
                 AutomationProperties.LiveSetting="Assertive" />

      <Expander Header="{Binding OtherOperationsLabel}" Margin="0,10,0,0">
       <StackPanel>
        <Button x:Name="DiscardModelButton" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}" TabIndex="38" />
        <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" TabIndex="54" />
       </StackPanel>
      </Expander>
     </StackPanel>
    </TabItem>
   </TabControl>
  </StackPanel>
 </GroupBox>
</UserControl>