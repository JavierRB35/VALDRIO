<UserControl x:Class="Valdrio.Desktop.CostFlowPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding ReportContext}" TextWrapping="Wrap"/><TextBlock Text="{Binding CurrentState}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
  <Border x:Name="ExecutionCard"  Style="{StaticResource Card}" Margin="0,0,0,16"><Expander Header="{Binding [ExecutionOptions]}"><StackPanel>
   <TextBlock Text="{Binding [ReportTitle]}" Style="{StaticResource Text.Section}" /><TextBlock Text="{Binding [Help]}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding [CurrentInputs]}" FontWeight="SemiBold" Margin="0,12,0,0"/>
   <WrapPanel Margin="0,12,0,8"><Button Content="{Binding [Refresh]}" Command="{Binding RefreshCommand}" /></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Text="{Binding [ConsultSaved]}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,4" /><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding [Execution]}" />
   <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,8"><TextBlock Text="{Binding CurrentState}" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /><TextBlock Text="{Binding ExecutionDuration}" Margin="0,6,0,0"/>
   <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brand.Red}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel></Expander></Border>
  <TextBlock Text="{Binding [ReconcileHelp]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel x:Name="TotalsPanel" Margin="0,0,0,12">
   <Border Style="{StaticResource Card}" MinWidth="220" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding [Effective]}" /><TextBlock Text="{Binding EffectiveTotal}" Style="{StaticResource Text.Kpi}" /></StackPanel></Border>
   <Border Style="{StaticResource Card}" MinWidth="220" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding [FinalBalance]}" /><TextBlock Text="{Binding FinalTotal}" Style="{StaticResource Text.Kpi}" /></StackPanel></Border>
   <Border Style="{StaticResource Card}" MinWidth="220"><StackPanel><TextBlock Text="{Binding [Reconciliation]}" /><TextBlock Text="{Binding ReconciliationState}" Style="{StaticResource Text.Kpi}" /></StackPanel></Border>
  </WrapPanel>



  <WrapPanel Margin="0,0,0,8"><Button Content="{Binding [ExportCsv]}" Click="ExportCsv"/><Button Content="{Binding [PrintPdf]}" Click="PrintPdf"/></WrapPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="ExpandedAnalysis" Content="{Binding [ExpandGraph]}" Click="ToggleAnalysis" Margin="0,0,16,0"/><TextBlock Text="{Binding [Zoom]}" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="FlowZoom" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.1" LargeChange="0.25" Width="180" AutomationProperties.Name="{Binding [Zoom]}"/></StackPanel>


 <TabControl x:Name="AnalysisTabs"><TabItem Header="{Binding [SummaryTab]}"><StackPanel Margin="12">
 <CheckBox Content="{Binding [CurrentPrimary]}" IsChecked="{Binding UseCurrentPrimary}"/>
 <CheckBox Content="{Binding [GroupByCenter]}" IsChecked="{Binding GroupByCenter}" Margin="0,8"/>
 <CheckBox Content="{Binding [UseSecondary]}" IsChecked="{Binding SecondaryPhase}" Margin="0,8"/>
 <TextBlock Text="{Binding ExecutiveSummary}" TextWrapping="Wrap" Margin="0,8"/>
 <TextBlock Text="{Binding ConcentrationThresholdHelp}" TextWrapping="Wrap"/><TextBox Text="{Binding ConcentrationThreshold,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="90" HorizontalAlignment="Left"/>
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8"><Canvas x:Name="ConcentrationCanvas" Height="245"/></ScrollViewer>
 <TextBlock Text="{Binding [Filter]}"/><TextBox Text="{Binding ReportFilter,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
 <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="ConcentrationGrid" ItemsSource="{Binding Concentration}" SelectionChanged="SelectConcentration" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="200">
 <DataGrid.Columns><DataGridTextColumn Binding="{Binding Node}" Width="2*"/><DataGridTextColumn Binding="{Binding Role}" Width="*"/><DataGridTextColumn Binding="{Binding Amount,StringFormat=N2}" Width="*"/><DataGridTextColumn Binding="{Binding Share}" Width="*"/><DataGridTextColumn Binding="{Binding Cumulative}" Width="*"/><DataGridTextColumn Binding="{Binding Behavior}" Width="2*"/></DataGrid.Columns>
 </DataGrid></StackPanel></TabItem><TabItem Header="{Binding [PrimaryGraph]}"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <CheckBox Content="{Binding [ShowAllFlowLabels]}" IsChecked="{Binding ShowAllFlowLabels}" Margin="0,0,0,8" />
   <TextBlock Text="{Binding [GraphTraceHelp]}" TextWrapping="Wrap" Margin="0,2,0,12" />
   <Expander Header="{Binding [PrimaryGraph]}" IsExpanded="True">
    <ScrollViewer x:Name="PrimaryGraphViewport" SizeChanged="ResizeGraph" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
     <Canvas x:Name="PrimaryGraphCanvas" Width="860" Height="360" Background="{DynamicResource Surface.Canvas}" ><Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Value,ElementName=FlowZoom}" ScaleY="{Binding Value,ElementName=FlowZoom}"/></Canvas.LayoutTransform></Canvas>
    </ScrollViewer>
   </Expander>
  </StackPanel></Border></TabItem><TabItem Header="{Binding [SecondaryGraph]}"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <Expander Header="{Binding [SecondaryGraph]}" IsExpanded="True">
    <StackPanel>
     <TextBlock Text="{Binding [GrossGraphHelp]}" TextWrapping="Wrap" Margin="0,4,0,12" />
     <ScrollViewer x:Name="SecondaryGraphViewport" SizeChanged="ResizeGraph" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
      <Canvas x:Name="SecondaryGraphCanvas" Width="860" Height="430" Background="{DynamicResource Surface.Canvas}" ><Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Value,ElementName=FlowZoom}" ScaleY="{Binding Value,ElementName=FlowZoom}"/></Canvas.LayoutTransform></Canvas>
     </ScrollViewer>
    </StackPanel>
   </Expander>
  </StackPanel></Border></TabItem><TabItem Header="{Binding [CenterBalances]}"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="{Binding [CenterBalances]}" Style="{StaticResource Text.Section}" />
   <TextBlock Text="{Binding [BalanceHelp]}" Margin="0,0,0,12" />
   <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="CenterBalanceGrid" ItemsSource="{Binding CenterBalances}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="90" AutomationProperties.Name="{Binding [CenterBalances]}">
    <DataGrid.Columns>
     <DataGridTextColumn Binding="{Binding Label}" Width="*" MinWidth="220" ElementStyle="{StaticResource Text.TableText}" />
     <DataGridTextColumn Binding="{Binding Primary}" SortMemberPath="PrimaryValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
     <DataGridTextColumn Binding="{Binding SecondaryNet}" SortMemberPath="SecondaryNetValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
     <DataGridTextColumn Binding="{Binding Final}" SortMemberPath="FinalValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
    </DataGrid.Columns>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Exact}" /></Style></DataGrid.RowStyle>
   </DataGrid>
   <TextBlock Text="{Binding [BalanceEmpty]}" Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CenterBalances.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock Text="{Binding [BalancePrecision]}" Margin="0,8" />
   <Expander Header="{Binding [NodeBalances]}" IsExpanded="False" Margin="0,8,0,0"><StackPanel>
    <TextBlock Text="{Binding [BalanceTraceHelp]}" Margin="0,8" />
    <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="NodeBalanceGrid" ItemsSource="{Binding NodeBalances}" SelectedItem="{Binding SelectedBalance}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="90" AutomationProperties.Name="{Binding [NodeBalances]}">
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding Label}" Width="*" MinWidth="250" ElementStyle="{StaticResource Text.TableText}" />
      <DataGridTextColumn Binding="{Binding Role}" Width="115" />
      <DataGridTextColumn Binding="{Binding Primary}" SortMemberPath="PrimaryValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
      <DataGridTextColumn Binding="{Binding SecondaryNet}" SortMemberPath="SecondaryNetValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
      <DataGridTextColumn Binding="{Binding Final}" SortMemberPath="FinalValue" Width="180" ElementStyle="{StaticResource Text.TableNumber}" />
     </DataGrid.Columns>
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Exact}" /></Style></DataGrid.RowStyle>
    </DataGrid>
   </StackPanel></Expander>
  </StackPanel></Border></TabItem><TabItem Header="{Binding [Details]}"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="{Binding [ClearSelection]}" Command="{Binding ClearSelectionCommand}" /><TextBlock Text="{Binding [Details]}" FontWeight="SemiBold" /></DockPanel>
   <TextBlock Text="{Binding Selection}" TextWrapping="Wrap" Margin="0,8" />
   <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="DetailsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTextColumn Binding="{Binding Stage}" Width="135" /><DataGridTextColumn Binding="{Binding Resource}" Width="200" />
     <DataGridTextColumn Binding="{Binding Source}" Width="240" /><DataGridTextColumn Binding="{Binding Destination}" Width="240" />
     <DataGridTextColumn Binding="{Binding Rule}" Width="180" /><DataGridTextColumn Binding="{Binding Assigned}" ElementStyle="{StaticResource Text.TableNumber}" Width="170" />
     <DataGridTextColumn Binding="{Binding Received}" ElementStyle="{StaticResource Text.TableNumber}" Width="170" /><DataGridTextColumn Binding="{Binding Terminal}" Width="240" />
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel></Border></TabItem><TabItem Header="{Binding [Reconciliation]}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding [Reconciliation]}" FontWeight="SemiBold" /><TextBlock Text="{Binding [ReconcileHelp]}" TextWrapping="Wrap" Margin="0,8" />
   <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="ReconciliationGrid" ItemsSource="{Binding Reconciliation}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="100" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Binding="{Binding Resource}" Width="230" /><DataGridTextColumn Binding="{Binding Source}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /><DataGridTextColumn Binding="{Binding Destination}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /><DataGridTextColumn Binding="{Binding Rule}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /><DataGridTextColumn Binding="{Binding Assigned}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /><DataGridTextColumn Binding="{Binding Received}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /><DataGridTextColumn Binding="{Binding Terminal}" Width="160" ElementStyle="{StaticResource Text.TableNumber}" /></DataGrid.Columns>
   </DataGrid>
  </StackPanel></Border></TabItem><TabItem Header="{Binding [Aux.Title]}" IsSelected="{Binding ShowAuxiliaryReport,Mode=TwoWay}"><StackPanel Margin="12">
<TextBlock Text="{Binding [Aux.Help]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="AuxiliaryReportGrid" ItemsSource="{Binding AuxiliaryReportRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
<DataGrid.Columns><DataGridTextColumn Binding="{Binding CenterSummary}" MinWidth="60" Width="2*" ElementStyle="{StaticResource Text.TableText}"/><DataGridTextColumn Binding="{Binding Normal}" MinWidth="60" Width="*" ElementStyle="{StaticResource Text.TableText}"/><DataGridTextColumn Binding="{Binding Real}" MinWidth="60" Width="*" ElementStyle="{StaticResource Text.TableText}"/><DataGridTextColumn Binding="{Binding Distributed}" MinWidth="60" Width="*" ElementStyle="{StaticResource Text.TableText}"/><DataGridTextColumn Binding="{Binding Unassigned}" MinWidth="60" Width="*" ElementStyle="{StaticResource Text.TableText}"/><DataGridTextColumn Binding="{Binding Idle}" MinWidth="60" Width="*" ElementStyle="{StaticResource Text.TableText}"/></DataGrid.Columns></DataGrid>
<ItemsControl ItemsSource="{Binding AuxiliaryReportRows}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Center}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem></TabControl></StackPanel>
</UserControl>
