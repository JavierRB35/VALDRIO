<UserControl x:Class="Valdrio.Desktop.CostFlowPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="{Binding [Help]}" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,12,0,8"><Button Content="{Binding [Calculate]}" Command="{Binding CalculateCommand}" Style="{StaticResource Button.Primary}"/><Button Content="{Binding [Cancel]}" Command="{Binding CancelCommand}"/><Button Content="{Binding [Refresh]}" Command="{Binding RefreshCommand}"/></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding [Execution]}" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding [Execution]}"/>
   <TextBlock Text="{Binding CurrentState}" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Expander Header="{Binding [Graph]}" IsExpanded="True"><StackPanel>
   <TextBlock Text="{Binding [GrossHelp]}" TextWrapping="Wrap" Margin="0,8"/>
   <ScrollBar Orientation="Horizontal" Maximum="{Binding ScrollableWidth, ElementName=GraphViewport}" ViewportSize="{Binding ViewportWidth, ElementName=GraphViewport}" SmallChange="80" LargeChange="300" ValueChanged="PanGraph" AutomationProperties.Name="{Binding [PanGraph]}"/>
   <ScrollViewer x:Name="GraphViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><Canvas x:Name="GraphCanvas" Width="1100" Height="1350" Background="{DynamicResource Surface.Canvas}"/></ScrollViewer>
  </StackPanel></Expander></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="{Binding [ClearSelection]}" Command="{Binding ClearSelectionCommand}"/><TextBlock Text="{Binding [Details]}" FontWeight="SemiBold"/></DockPanel>
   <TextBlock Text="{Binding Selection}" TextWrapping="Wrap" Margin="0,8"/>
   <DataGrid x:Name="DetailsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" Height="350" CanUserAddRows="False" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTextColumn Binding="{Binding Stage}" Width="135"/><DataGridTextColumn Binding="{Binding Resource}" Width="200"/>
     <DataGridTextColumn Binding="{Binding Source}" Width="240"/><DataGridTextColumn Binding="{Binding Destination}" Width="240"/>
     <DataGridTextColumn Binding="{Binding Rule}" Width="180"/><DataGridTextColumn Binding="{Binding Assigned}" ElementStyle="{StaticResource Text.TableNumber}" Width="170"/>
     <DataGridTextColumn Binding="{Binding Received}" ElementStyle="{StaticResource Text.TableNumber}" Width="170"/><DataGridTextColumn Binding="{Binding Terminal}" Width="240"/>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding [Reconciliation]}" FontWeight="SemiBold"/><TextBlock Text="{Binding [ReconcileHelp]}" TextWrapping="Wrap" Margin="0,8"/>
   <DataGrid x:Name="ReconciliationGrid" ItemsSource="{Binding Reconciliation}" IsReadOnly="True" AutoGenerateColumns="False" Height="220" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Binding="{Binding Resource}" Width="230"/><DataGridTextColumn Binding="{Binding Source}" Width="160"/><DataGridTextColumn Binding="{Binding Destination}" Width="160"/><DataGridTextColumn Binding="{Binding Rule}" Width="160"/><DataGridTextColumn Binding="{Binding Assigned}" Width="160"/><DataGridTextColumn Binding="{Binding Received}" Width="160"/><DataGridTextColumn Binding="{Binding Terminal}" Width="160"/></DataGrid.Columns>
   </DataGrid>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
