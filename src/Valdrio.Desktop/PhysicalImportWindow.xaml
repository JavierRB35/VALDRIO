<local:IntegratedWorkspaceWindow xmlns:local="clr-namespace:Valdrio.Desktop" x:Class="Valdrio.Desktop.PhysicalImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="1100" Height="740" MinWidth="840" MinHeight="550"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
              Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10">
   <Button Content="{Binding TemplateLabel}" Click="SaveTemplate" Margin="0,0,8,0"/>
   <Button Content="{Binding BrowseLabel}" Click="Browse" Margin="0,0,8,0"/>
   <TextBlock Text="{Binding Path}" MaxWidth="280" TextTrimming="CharacterEllipsis"
              VerticalAlignment="Center" Margin="0,0,12,0"/>
   <TextBlock Text="{Binding SheetLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
   <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet,Mode=TwoWay}"
             Width="140" Margin="0,0,12,0"/>
   <TextBlock Text="{Binding DelimiterLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
   <ComboBox ItemsSource="{Binding SeparatorOptions}" SelectedItem="{Binding SelectedSeparator,Mode=TwoWay}"
             Width="65" Margin="0,0,12,0"/>
   <Button Content="{Binding PreviewLabel}" Click="Preview" Margin="0,0,8,0"/>
  </WrapPanel>
  <DataGrid x:Name="PreviewTable" Grid.Row="2" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
            CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
            SelectionMode="Single" HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Auto">
   <DataGrid.Columns>
    <DataGridCheckBoxColumn Binding="{Binding Replace,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                            Width="75" x:Name="ChoiceColumn"/>
    <DataGridTextColumn Binding="{Binding Source.RecordNumber}" IsReadOnly="True" Width="60" Header="#"/>
    <DataGridTextColumn Binding="{Binding Node}" IsReadOnly="True" Width="2*" x:Name="NodeColumn"/>
    <DataGridTextColumn Binding="{Binding Unit}" IsReadOnly="True" Width="*" x:Name="UnitColumn"/>
    <DataGridTextColumn Binding="{Binding Normal}" IsReadOnly="True" Width="*" x:Name="NormalColumn"/>
    <DataGridTextColumn Binding="{Binding Real}" IsReadOnly="True" Width="*" x:Name="RealColumn"/>
    <DataGridTextColumn Binding="{Binding Existing}" IsReadOnly="True" Width="*" x:Name="ExistingColumn"/>
    <DataGridTextColumn Binding="{Binding Warning}" IsReadOnly="True" Width="2*" x:Name="WarningColumn"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,8">
   <TextBlock Text="{Binding CorrectionLabel}"/>
   <TextBox Text="{Binding CorrectionReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Margin="0,2,0,6"/>
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,14,0">
     <TextBlock Text="{Binding ZeroLabel}"/>
     <TextBox Text="{Binding NormalZeroReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="{Binding ExceptionLabel}"/>
     <TextBox Text="{Binding ExceptionReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
   </UniformGrid>
  </StackPanel>
  <StackPanel Grid.Row="4">
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap"
              Foreground="{DynamicResource Brand.Red}" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,8,0,0">
    <Button Content="{Binding ApplyLabel}" Click="Apply" Style="{StaticResource Button.Primary}"
            IsEnabled="{Binding CanApply}" Margin="0,0,10,0"/>
    <Button Content="{Binding CloseLabel}" Click="CloseWindow" IsCancel="True"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</local:IntegratedWorkspaceWindow>
