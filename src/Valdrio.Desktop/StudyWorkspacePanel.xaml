<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.StudyWorkspacePanel">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,6" />
   <Setter Property="Margin" Value="0,4,8,4" />
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="Margin" Value="0,4,8,3" />
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinWidth" Value="160" />
   <Setter Property="Margin" Value="0,3,8,3" />
   <Setter Property="DisplayMemberPath" Value="Label" />
  </Style>
 </UserControl.Resources>
 <GroupBox Header="{Binding Title}" Padding="14">
  <StackPanel>
   <TextBlock Text="{Binding StudyListHelp}" />
   <DockPanel>
    <WrapPanel DockPanel.Dock="Right">
     <Button x:Name="RefreshStudyButton" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" TabIndex="60" />
     <Button x:Name="LoadStudyButton" Content="{Binding LoadLabel}" Command="{Binding LoadCommand}" TabIndex="62" />
    </WrapPanel>
    <ComboBox x:Name="StudyBox" ItemsSource="{Binding Studies}" SelectedItem="{Binding StudyChoice}" IsEnabled="{Binding HasStudies}" TabIndex="61" AutomationProperties.Name="{Binding Title}" local:FieldHelp.Key="StudyChoice" />
   </DockPanel>
   <Button Content="{Binding GoToModelsLabel}" Click="GoToModels" HorizontalAlignment="Left" />
   <Grid IsEnabled="{Binding CanEdit}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{Binding NameLabel}" />
     <TextBox x:Name="StudyNameBox" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,3" TabIndex="63" AutomationProperties.Name="{Binding NameLabel}" local:FieldHelp.Key="Name" />
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="{Binding ModelLabel}" />
     <ComboBox x:Name="StudyModelBox" ItemsSource="{Binding PublishedModels}" IsEnabled="{Binding HasPublishedModels}" SelectedItem="{Binding ModelChoice}" TabIndex="64" AutomationProperties.Name="{Binding ModelLabel}" local:FieldHelp.Key="ModelChoice" />
    </StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="{Binding StartLabel}" />
     <local:CalendarDatePicker x:Name="StartPicker" SelectedDate="{Binding PeriodStart,Mode=TwoWay}" Language="{Binding DateLanguage}" TabIndex="65" AutomationProperties.Name="{Binding StartLabel}" Margin="0,3,8,3" local:FieldHelp.Key="PeriodStart" />
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1">
     <TextBlock Text="{Binding EndLabel}" />
     <local:CalendarDatePicker x:Name="EndPicker" SelectedDate="{Binding PeriodEnd,Mode=TwoWay}" Language="{Binding DateLanguage}" TabIndex="66" AutomationProperties.Name="{Binding EndLabel}" Margin="0,3,8,3" local:FieldHelp.Key="PeriodEnd" />
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock Text="{Binding CurrencyLabel}" />
     <ComboBox x:Name="StudyCurrencyBox" DisplayMemberPath="" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" TabIndex="67" AutomationProperties.Name="{Binding CurrencyLabel}" local:FieldHelp.Key="Currency" />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="1">
     <TextBlock Text="{Binding ScenarioLabel}" />
     <ComboBox x:Name="ScenarioBox" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" TabIndex="68" AutomationProperties.Name="{Binding ScenarioLabel}" local:FieldHelp.Key="Scenario" />
    </StackPanel>
   </Grid>
   <WrapPanel>
    <Button x:Name="CreateStudyButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" TabIndex="70" Visibility="{Binding CreateVisibility}" />
    <Button x:Name="SaveStudyButton" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" TabIndex="71" Visibility="{Binding SaveVisibility}" />
   </WrapPanel>
   <TextBlock Text="{Binding Details}" />
   <TextBlock x:Name="ActionStatus" Text="{Binding Status}" Foreground="DarkSlateBlue" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
   <TextBlock Text="{Binding ImportHelp}" />
   <Button x:Name="ImportColumnsButton" Content="{Binding ImportContinueLabel}" Click="ContinueToImport" IsEnabled="{Binding ImportColumns.IsIdle}" HorizontalAlignment="Left" TabIndex="77" />
   <Button Content="{Binding InspectFileLabel}" Click="OpenImportColumns" HorizontalAlignment="Left" x:Name="InspectFileButton" />
   <TextBlock x:Name="ImportHistoryText" Text="{Binding ImportedAmounts}" />
   <Expander Header="{Binding OtherOperationsLabel}" Margin="0,10,0,0">
    <StackPanel>
     <Button x:Name="NewStudyButton" Content="{Binding NewLabel}" Command="{Binding NewCommand}" TabIndex="69" />
     <Button x:Name="CaptureStudyButton" Content="{Binding CaptureLabel}" Command="{Binding CaptureCommand}" TabIndex="72" />
     <Button x:Name="ToggleStudyButton" Content="{Binding ToggleLabel}" Command="{Binding ToggleStateCommand}" TabIndex="73" />
     <Button x:Name="DiscardStudyButton" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}" TabIndex="74" />
     <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" TabIndex="75" />
     <TextBlock Text="{Binding RunHistory}" FontWeight="SemiBold" />
     <TextBlock x:Name="SnapshotHeader" Text="{Binding SnapshotLabel}" FontWeight="SemiBold" />
     <ComboBox x:Name="SnapshotBox" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotChoice}" IsEnabled="{Binding Ready}" TabIndex="76" AutomationProperties.Name="{Binding SnapshotLabel}" local:FieldHelp.Key="SnapshotChoice" />
     <TextBlock Text="{Binding SnapshotDetails}" FlowDirection="LeftToRight" />
     <TextBlock Text="{Binding Preparation}" Foreground="DarkRed" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Text="{Binding HistoricalDefinitions}" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </GroupBox>
</UserControl>