<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.StudyWorkspacePanel">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
   <Setter Property="Padding" Value="11,7"/>
   <Setter Property="Margin" Value="0,4,8,4"/>
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,4,8,3"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
   <Setter Property="MinWidth" Value="160"/>
   <Setter Property="Margin" Value="0,3,8,3"/>
   <Setter Property="DisplayMemberPath" Value="Label"/>
  </Style>
 </UserControl.Resources>

 <GroupBox Header="{Binding Title}" Padding="14">
  <StackPanel>
   <TextBlock Text="{Binding Notes}" Margin="0,0,0,12"/>

   <GroupBox Header="{Binding OpenSectionTitle}" Style="{StaticResource GroupBox.Section}" Padding="0" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="{Binding OpenSectionHelp}" Foreground="{DynamicResource Text.Primary}"/>
     <TextBlock Text="{Binding StudyListHelp}"/>
     <DockPanel>
      <WrapPanel DockPanel.Dock="Right">
       
       <Button x:Name="LoadStudyButton" Content="{Binding LoadLabel}" Command="{Binding LoadCommand}" TabIndex="62" FontWeight="SemiBold" AutomationProperties.HelpText="{Binding LoadSelectionHelp}">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding HasPendingStudySelection}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brand.DeepGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.White}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.DeepGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
       </Button>
      </WrapPanel>
      <ComboBox x:Name="StudyBox" DropDownOpened="RefreshStudiesOnDropDownOpened" ItemsSource="{Binding Studies}" SelectedItem="{Binding StudyChoice}" IsEnabled="{Binding HasStudies}" TabIndex="61" AutomationProperties.Name="{Binding Title}" local:FieldHelp.Key="StudyChoice"/>
     </DockPanel>
     <TextBlock Text="{Binding LoadSelectionHelp}" Foreground="{DynamicResource Accent.ActiveGreen}" FontWeight="SemiBold"
                AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"
                Visibility="{Binding HasPendingStudySelection, Converter={StaticResource Visible}}"/>
    </StackPanel>
   </GroupBox>

   <Button Content="{Binding GoToModelsLabel}" Click="GoToModels" HorizontalAlignment="Left" Visibility="{Binding ModelRemedyVisibility}"/>

   <GroupBox Header="{Binding FormTitle}" Style="{StaticResource GroupBox.Section}" Padding="0" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="{Binding FormHelp}" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8"/>
     <local:AdaptiveColumnsPanel x:Name="AnalysisForm" IsEnabled="{Binding CanEdit}" MinColumnWidth="300">
      <StackPanel>
       <TextBlock Text="{Binding NameLabel}"/>
       <TextBox x:Name="StudyNameBox" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,8,3" TabIndex="63" AutomationProperties.Name="{Binding NameLabel}" local:FieldHelp.Key="Name"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
       <TextBlock Text="{Binding ModelLabel}"/>
       <ComboBox x:Name="StudyModelBox" ItemsSource="{Binding PublishedModels}" IsEnabled="{Binding HasPublishedModels}" SelectedItem="{Binding ModelChoice}" TabIndex="64" AutomationProperties.Name="{Binding ModelLabel}" local:FieldHelp.Key="StudyModelChoice"/>
      </StackPanel>
      <StackPanel Grid.Row="1">
       <TextBlock Text="{Binding StartLabel}"/>
       <local:CalendarDatePicker x:Name="StartPicker" SelectedDate="{Binding PeriodStart,Mode=TwoWay}" Language="{Binding DateLanguage}" TabIndex="65" AutomationProperties.Name="{Binding StartLabel}" Margin="0,3,8,3" local:FieldHelp.Key="PeriodStart"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1">
       <TextBlock Text="{Binding EndLabel}"/>
       <local:CalendarDatePicker x:Name="EndPicker" SelectedDate="{Binding PeriodEnd,Mode=TwoWay}" Language="{Binding DateLanguage}" TabIndex="66" AutomationProperties.Name="{Binding EndLabel}" Margin="0,3,8,3" local:FieldHelp.Key="PeriodEnd"/>
      </StackPanel>
      <StackPanel Grid.Row="2">
       <TextBlock Text="{Binding CurrencyLabel}"/>
       <ComboBox x:Name="StudyCurrencyBox" DisplayMemberPath="" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" TabIndex="67" AutomationProperties.Name="{Binding CurrencyLabel}" local:FieldHelp.Key="Currency"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1">
       <TextBlock Text="{Binding ScenarioLabel}"/>
       <ComboBox x:Name="ScenarioBox" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" TabIndex="68" AutomationProperties.Name="{Binding ScenarioLabel}" local:FieldHelp.Key="Scenario"/>
      </StackPanel>
     </local:AdaptiveColumnsPanel>

     <WrapPanel Margin="0,6,0,0">
      <Button x:Name="CreateStudyButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" TabIndex="70" Visibility="{Binding CreateVisibility}" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
      <Button local:FixedPageActions.Pin="True" x:Name="SaveStudyButton" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" TabIndex="71" Visibility="{Binding SaveVisibility}" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
      <Button x:Name="NewStudyButton" Content="{Binding NewLabel}" Command="{Binding NewCommand}" TabIndex="69"/>
     </WrapPanel>
     <Button x:Name="PhysicalActivityButton" Content="{Binding PhysicalOpenLabel}" IsEnabled="{Binding CanOpenPhysical}" Click="OpenPhysicalActivity" HorizontalAlignment="Left" TabIndex="72"/>
     <TextBlock Text="{Binding Details}" FontWeight="SemiBold"/>
     <TextBlock x:Name="ActionStatus" Text="{Binding Status}" Style="{StaticResource Text.ContextualStatus}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
   </GroupBox>

   <GroupBox Header="{Binding ImportHistoryTitle}" Padding="12">
    <StackPanel>
     <TextBlock Text="{Binding ImportHistoryHelp}" Foreground="{DynamicResource Text.Primary}"/>
     <TextBlock Text="{Binding ImportHelp}"/>
     <TextBlock x:Name="ImportHistoryText" Text="{Binding ImportedAmounts}" Margin="0,6,0,0"/>
    </StackPanel>
   </GroupBox>

   <Expander Header="{Binding OtherOperationsLabel}" Margin="0,10,0,0">
    <StackPanel Margin="8,6,0,0">
     <TextBlock Text="{Binding AdvancedHelp}" Foreground="{DynamicResource Text.Primary}"/>
     <Button Content="{Binding InspectFileLabel}" Click="OpenImportColumns" HorizontalAlignment="Left" x:Name="InspectFileButton" Style="{StaticResource Button.Primary}"/>
     <Button x:Name="CaptureStudyButton" Content="{Binding CaptureLabel}" Command="{Binding CaptureCommand}" TabIndex="72"/>
     <Button x:Name="ToggleStudyButton" Content="{Binding ToggleLabel}" Command="{Binding ToggleStateCommand}" TabIndex="73"/>
     <Button x:Name="DiscardStudyButton" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}" TabIndex="74"/>
     <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" TabIndex="75"/>
     <TextBlock Text="{Binding RunHistory}" FontWeight="SemiBold"/>
     <Button Content="{Binding ResultsLabel}" Click="OpenResults" HorizontalAlignment="Left"/>
     <TextBlock x:Name="SnapshotHeader" Text="{Binding SnapshotLabel}" FontWeight="SemiBold"/>
     <ComboBox x:Name="SnapshotBox" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotChoice}" IsEnabled="{Binding Ready}" TabIndex="76" AutomationProperties.Name="{Binding SnapshotLabel}" local:FieldHelp.Key="SnapshotChoice"/>
     <TextBlock Text="{Binding SnapshotDetails}" FlowDirection="LeftToRight"/>
     <TextBlock Text="{Binding Preparation}" Foreground="{DynamicResource Brand.Red}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding HistoricalDefinitions}"/>
    </StackPanel>
   </Expander>
  </StackPanel>
 </GroupBox>
</UserControl>
