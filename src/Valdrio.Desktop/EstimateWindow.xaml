<local:IntegratedWorkspaceWindow x:Class="Valdrio.Desktop.EstimateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Valdrio.Desktop" Title="{Binding [Title]}" Width="1200" Height="850" Background="{DynamicResource Surface.Canvas}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="{Binding [Title]}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Context}" Margin="0,4"/>
   <TextBlock Text="{Binding [Scope]}" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [Code]}"/><TextBox x:Name="OrderCode" Width="180" IsEnabled="{Binding CodeEditable}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [Recipe]}"/><ComboBox Width="280" ItemsSource="{Binding Recipes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Recipe}"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding [Quantity]}"/><TextBox Width="120" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding [Run]}"/><ComboBox ItemsSource="{Binding Runs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Run}" HorizontalAlignment="Stretch"/>
    <WrapPanel Margin="0,12,0,0">
     <Button Content="{Binding [New]}" Click="New"/>
     <Button Content="{Binding [Preview]}" Click="Preview" Margin="8,0"/>
     <Button Content="{Binding [Accept]}" Click="Accept" IsEnabled="{Binding CanAccept}" Style="{StaticResource Button.Primary}"/>
    </WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="{Binding [History]}" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding [HistoryHelp]}" TextWrapping="Wrap" Margin="0,6"/>
    <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"/>
    <WrapPanel Margin="0,8"><Button Content="{Binding [Show]}" Click="ShowHistory"/><Button Content="{Binding [Revise]}" Click="Revise" IsEnabled="{Binding Writable}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="{Binding [CompareWith]}"/><ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding Comparison}" DisplayMemberPath="Label"/>
    <Button Content="{Binding [Compare]}" Click="Compare" HorizontalAlignment="Left" Margin="0,8"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="AnswersGrid" ItemsSource="{Binding Answers}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="350"/>
    <Expander Header="{Binding [Detail]}" IsExpanded="True" Margin="0,12,0,0"><DataGrid x:Name="DetailsGrid" ItemsSource="{Binding Details}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="350"/></Expander>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="{Binding [Close]}" Click="ClosePage"/><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</local:IntegratedWorkspaceWindow>
