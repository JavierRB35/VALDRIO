<Window x:Class="Valdrio.Desktop.PhysicalCapacityAssistantWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="780" Height="690" MinWidth="620" MinHeight="510"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visibility"/></Window.Resources>
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock Text="{Binding Proposed}" FontSize="19" FontWeight="SemiBold"
              Foreground="{DynamicResource Accent.ActiveGreen}"/>
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap"
              Foreground="{DynamicResource Brand.Red}" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,10,0,0">
    <Button Content="{Binding PreviewLabel}" Click="Preview" Margin="0,0,8,0"/>
    <Button Content="{Binding AdoptLabel}" Click="Adopt" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="{Binding CancelLabel}" IsCancel="True" Click="Cancel"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"
             Foreground="{DynamicResource Brand.DeepGreen}" Margin="0,0,0,10"/>
  <ComboBox DockPanel.Dock="Top" SelectedValuePath="Tag" SelectedValue="{Binding Method,Mode=TwoWay}"
            AutomationProperties.Name="{Binding Title}" Margin="0,0,0,14">
   <ComboBoxItem Content="{Binding CalendarLabel}" Tag="Calendar"/>
   <ComboBoxItem Content="{Binding HistoryLabel}" Tag="Historical"/>
   <ComboBoxItem Content="{Binding DeclaredLabel}" Tag="Declared"/>
  </ComboBox>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <StackPanel Visibility="{Binding CalendarVisible,Converter={StaticResource Visibility}}">
     <TextBlock Text="{Binding CalendarLabel}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
     <UniformGrid Columns="2">
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding DaysLabel}"/>
       <TextBox Text="{Binding OperatingDays,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding ShiftsLabel}"/>
       <TextBox Text="{Binding ShiftsPerDay,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding HoursLabel}"/>
       <TextBox Text="{Binding HoursPerShift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding ResourcesLabel}"/>
       <TextBox Text="{Binding EquivalentResources,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding StoppagesLabel}"/>
       <TextBox Text="{Binding Stoppages,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,12,9"><TextBlock Text="{Binding FactorLabel}"/>
       <TextBox Text="{Binding NormalFactor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </UniformGrid>
     <TextBlock Text="{Binding FactorReasonLabel}"/>
     <TextBox Text="{Binding FactorReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
    </StackPanel>
    <StackPanel Visibility="{Binding HistoryVisible,Converter={StaticResource Visibility}}">
     <TextBlock Text="{Binding HistoryHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ItemsControl ItemsSource="{Binding Historical}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1" Padding="0,9">
         <StackPanel>
          <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
          <WrapPanel>
           <CheckBox Content="{Binding DataContext.IncludeLabel,RelativeSource={RelativeSource AncestorType=Window}}"
                     IsChecked="{Binding Include,Mode=TwoWay}" Margin="0,4,16,4"/>
           <CheckBox Content="{Binding DataContext.ReviewLabel,RelativeSource={RelativeSource AncestorType=Window}}"
                     IsChecked="{Binding Exceptional,Mode=TwoWay}" Margin="0,4,0,4"/>
          </WrapPanel>
          <TextBox Text="{Binding ReviewReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{Binding DataContext.ReviewLabel,RelativeSource={RelativeSource AncestorType=Window}}"/>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <StackPanel Visibility="{Binding DeclaredVisible,Converter={StaticResource Visibility}}">
     <TextBlock Text="{Binding NormalLabel}"/>
     <TextBox Text="{Binding DeclaredQuantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
     <TextBlock Text="{Binding SourceLabel}"/>
     <TextBox Text="{Binding DeclaredSource,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
     <TextBlock Text="{Binding FactorReasonLabel}"/>
     <TextBox Text="{Binding DeclaredDescription,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              TextWrapping="Wrap" AcceptsReturn="True" MinHeight="75"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
