<local:IntegratedWorkspaceWindow xmlns:local="clr-namespace:Valdrio.Desktop" x:Class="Valdrio.Desktop.PhysicalCapacityAssistantWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="1040" Height="860" MinWidth="620" MinHeight="510"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <local:IntegratedWorkspaceWindow.Resources>
  <BooleanToVisibilityConverter x:Key="Visibility"/>
  <Style x:Key="SummaryText" TargetType="TextBlock">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="Background" Value="{DynamicResource Status.WarningBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brand.Yellow}"/>
   </Trigger></Style.Triggers>
  </Style>
 </local:IntegratedWorkspaceWindow.Resources>
 <DockPanel Margin="16,12">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Context}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
   <TextBlock Text="{Binding ExistingCost}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
   <TextBlock Text="{Binding ProposalHelp}" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">

   <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Host.Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,8,0,0">
    <Button Content="{Binding SaveLabel}" Click="SaveActivityDraft" IsEnabled="{Binding CanSave}" Margin="0,0,8,0"/>
    <Button Content="{Binding ConfirmLabel}" Click="ConfirmActivity" IsEnabled="{Binding CanConfirm}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="{Binding CancelLabel}" Click="Cancel"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
   <Border x:Name="CalculationSummary" Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
    <StackPanel>
     <DockPanel>
     <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource SummaryText}" Text="{Binding Proposed}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent.ActiveGreen}"/>
     <TextBlock Text="{Binding ResultLabel}" FontWeight="SemiBold"/>
     </DockPanel>
     <TextBlock Style="{StaticResource SummaryText}" Text="{Binding CalculationSteps}" TextWrapping="Wrap" Margin="0,4,0,4"/>
     <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Border>
    <local:ResponsivePairPanel>
    <Border x:Name="CalculationPanel">
     <Border Background="{DynamicResource Brand.White}" Padding="16"><StackPanel IsEnabled="{Binding Host.IsWritable}">
      <TextBlock Text="{Binding MethodLabel}" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding Method,Mode=TwoWay}" AutomationProperties.Name="{Binding MethodLabel}" AutomationProperties.HelpText="{Binding MethodHelp}" Margin="0,4,0,4"/>
      <TextBlock Text="{Binding MethodHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Style="{StaticResource SummaryText}" Text="{Binding InferenceSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel Visibility="{Binding CalendarVisible,Converter={StaticResource Visibility}}">
     <TextBlock Text="{Binding CalendarLabel}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding CalendarHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DaysLabel}"/>
       <TextBox x:Name="DaysInput" Text="{Binding OperatingDays,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding DaysLabel}"/>
       <TextBlock Text="{Binding DaysHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding DaysError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ShiftsLabel}"/>
       <TextBox x:Name="ShiftsPerDayInput" Text="{Binding ShiftsPerDay,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ShiftsLabel}"/>
       <TextBlock Text="{Binding ShiftsHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding ShiftsError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding HoursLabel}"/>
       <TextBox x:Name="HoursPerShiftInput" Text="{Binding HoursPerShift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding HoursLabel}"/>
       <TextBlock Text="{Binding HoursHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding HoursError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ResourcesLabel}"/>
       <TextBox x:Name="EquivalentResourcesInput" Text="{Binding EquivalentResources,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResourcesLabel}"/>
       <TextBlock Text="{Binding ResourcesHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding ResourcesError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StoppagesLabel}"/>
       <TextBlock Text="{Binding StoppageBasisLabel}" Margin="0,4,0,2"/>
       <ComboBox ItemsSource="{Binding StoppageOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                 SelectedValue="{Binding StoppageBasis,Mode=TwoWay}" AutomationProperties.Name="{Binding StoppageBasisLabel}"/>
       <TextBox x:Name="StoppagesInput" Text="{Binding Stoppages,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding StoppagesLabel}"/>
       <TextBlock Text="{Binding StoppagesHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding StoppagesError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,16,14"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding FactorLabel}"/>
       <TextBox x:Name="NormalFactorInput" Text="{Binding NormalFactor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding FactorLabel}"/>
       <TextBlock Text="{Binding FactorHelp}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Style="{StaticResource SummaryText}" Text="{Binding FactorError}" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Red}"/></StackPanel>
     </Grid>
     <Expander Header="{Binding FactorReasonLabel}"><StackPanel>
     <TextBlock Text="{Binding NotesHelp}" TextWrapping="Wrap"/>
     <TextBox x:Name="FactorReasonInput" Text="{Binding FactorReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding FactorReasonLabel}"
              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/></StackPanel></Expander>
    </StackPanel>
    <StackPanel Visibility="{Binding HistoryVisible,Converter={StaticResource Visibility}}">
     <TextBlock Text="{Binding HistoryHelp}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ItemsControl ItemsSource="{Binding Historical}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1" Padding="0,9">
         <StackPanel>
          <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
          <WrapPanel>
           <CheckBox Content="{Binding DataContext.IncludeLabel,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     IsChecked="{Binding Include,Mode=TwoWay}" Margin="0,4,16,4"/>
           <CheckBox Content="{Binding DataContext.ReviewLabel,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     IsChecked="{Binding Exceptional,Mode=TwoWay}" Margin="0,4,0,4"/>
          </WrapPanel>
          <Expander Header="{Binding DataContext.NotesLabel,RelativeSource={RelativeSource AncestorType=ItemsControl}}"><TextBox Text="{Binding ReviewReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{Binding DataContext.NotesHelp,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></Expander>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>

      <CheckBox Content="{Binding UseProposalLabel}" IsChecked="{Binding UseProposal}" IsEnabled="{Binding CanAdopt}" Visibility="{Binding CalendarVisible,Converter={StaticResource Visibility}}" Margin="0,12,0,4"/>
      <CheckBox Content="{Binding UseProposalLabel}" IsChecked="{Binding UseProposal}" IsEnabled="{Binding CanAdopt}" Visibility="{Binding HistoryVisible,Converter={StaticResource Visibility}}" Margin="0,12,0,4"/>
     </StackPanel></Border>
    </Border>
    <Border Background="{DynamicResource Brand.White}" BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1" CornerRadius="6" Padding="16">
     <StackPanel>
      <TextBlock Text="{Binding NormalFieldLabel}" FontSize="16" FontWeight="SemiBold"/>
      <TextBox x:Name="NormalInput" Text="{Binding NormalValue,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}"
               AutomationProperties.Name="{Binding NormalFieldLabel}" AutomationProperties.HelpText="{Binding NormalHelp}" ToolTip="{Binding NormalHelp}" Margin="0,6,0,4"/>
      <TextBlock Text="{Binding NormalHelp}" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource SummaryText}" Text="{Binding NormalError}" Foreground="{DynamicResource Brand.Red}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ProvenanceSummary}" Foreground="{DynamicResource Accent.ActiveGreen}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding RealFieldLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0"/>
      <TextBox x:Name="RealInput" Text="{Binding RealValue,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}"
               AutomationProperties.Name="{Binding RealFieldLabel}" AutomationProperties.HelpText="{Binding RealHelp}" ToolTip="{Binding RealHelp}" Margin="0,6,0,4"/>
      <TextBlock Text="{Binding RealHelp}" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource SummaryText}" Text="{Binding RealError}" Foreground="{DynamicResource Brand.Red}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding RealProvenance}" Foreground="{DynamicResource Accent.ActiveGreen}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Style="{StaticResource SummaryText}" Text="{Binding ReviewWarning}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding UtilizationSummary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <Border Background="{DynamicResource Surface.Subtle}" Padding="12" Margin="0,16,0,0" CornerRadius="4">
       <TextBlock Text="{Binding Readiness}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
     </StackPanel>
    </Border>
    </local:ResponsivePairPanel>
    <Expander Header="{Binding DetailsLabel}" IsExpanded="{Binding DetailsExpanded}" Margin="0,12,0,0">
     <Border Background="{DynamicResource Brand.White}" Padding="16"><StackPanel>
      <TextBlock Text="{Binding NormalSourceLabel}" FontWeight="SemiBold"/>
      <TextBox x:Name="DeclaredSourceInput" Text="{Binding Host.SelectedRow.NormalSource,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding NormalSourceLabel}"/>
      <TextBlock Text="{Binding SourceHelp}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding NormalKind}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding RealSourceLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBox Text="{Binding Host.SelectedRow.RealSource,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding RealSourceLabel}"/>
      <TextBlock Text="{Binding SourceHelp}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding RealKind}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding NotesLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock Text="{Binding NotesHelp}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding NormalNotesLabel}" Margin="0,8,0,2"/>
      <TextBox Text="{Binding NormalNotes,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding NormalNotesLabel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
      <TextBlock Text="{Binding RealNotesLabel}" Margin="0,8,0,2"/>
      <TextBox Text="{Binding Host.SelectedRow.RealDescription,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding RealNotesLabel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
      <StackPanel Visibility="{Binding ShowZeroNote,Converter={StaticResource Visibility}}" Margin="0,12,0,0">
       <TextBlock Text="{Binding Host.ZeroReasonLabel}"/>
       <TextBox Text="{Binding Host.SelectedRow.NormalZeroReason,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding Host.ZeroReasonLabel}" ToolTip="{Binding NotesHelp}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowExceptionNote,Converter={StaticResource Visibility}}" Margin="0,12,0,0">
       <TextBlock Text="{Binding Host.ExceptionLabel}"/>
       <TextBox Text="{Binding Host.SelectedRow.ExceptionReason,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding Host.ExceptionLabel}" ToolTip="{Binding NotesHelp}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowCorrectionNote,Converter={StaticResource Visibility}}" Margin="0,12,0,0">
       <TextBlock Text="{Binding Host.CorrectionLabel}"/>
       <TextBox Text="{Binding Host.SelectedRow.CorrectionReason,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Host.IsReadOnly}" AutomationProperties.Name="{Binding Host.CorrectionLabel}" ToolTip="{Binding NotesHelp}"/>
      </StackPanel>
      <Expander Header="{Binding Host.AdvancedCapacityLabel}" Visibility="{Binding ManualAuxiliaryVisible,Converter={StaticResource Visibility}}" Margin="0,12,0,0">
       <StackPanel IsEnabled="{Binding Host.IsWritable}">
        <TextBlock Text="{Binding Host.TheoreticalLabel}"/>
        <TextBox Text="{Binding Host.SelectedRow.TheoreticalText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Host.TheoreticalLabel}"/>
        <TextBlock Text="{Binding Host.PracticalLabel}" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Host.SelectedRow.PracticalText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Host.PracticalLabel}"/>
        <TextBlock Text="{Binding NotesHelp}" TextWrapping="Wrap"/>
       </StackPanel>
      </Expander>
      <TextBlock Text="{Binding Host.HistoryLabel}" FontWeight="SemiBold" Margin="0,16,0,4"/>
      <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap"/>
     </StackPanel></Border>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</local:IntegratedWorkspaceWindow>
