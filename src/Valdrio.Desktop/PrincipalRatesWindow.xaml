<local:IntegratedWorkspaceWindow xmlns:local="clr-namespace:Valdrio.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Valdrio.Desktop.PrincipalRatesWindow" Title="{Binding [Title]}" Width="1200" Height="850" MinWidth="720" MinHeight="550"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <local:IntegratedWorkspaceWindow.Resources>
  <Style x:Key="RateCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="8,6"/></Style>
 </local:IntegratedWorkspaceWindow.Resources>
 <Grid Margin="16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding [Title]}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding Context}" Margin="0,8,0,4" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding [Policy]}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding [ScopeHelp]}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="RatesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TabControl x:Name="RateCategoryTabs" Margin="0,0,0,12"
                SelectedIndex="{Binding SelectedRateTabIndex, Mode=TwoWay}">
     <TabItem Header="{Binding [TabCenters]}">
      <TextBlock Text="{Binding [Centers]}" Margin="10,8" TextWrapping="Wrap"/>
     </TabItem>
     <TabItem Header="{Binding [TabFactors]}">
      <TextBlock Text="{Binding [TabFactors]}" Margin="10,8" TextWrapping="Wrap"/>
     </TabItem>
    </TabControl>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding [Centers]}" FontSize="17" FontWeight="SemiBold"/>
       <CheckBox Content="{Binding [Attention]}" IsChecked="{Binding AttentionOnly}" Margin="20,0,0,0"/></DockPanel>
      <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="CentersTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" MinHeight="90" SelectionMode="Single" AutomationProperties.Name="{Binding [Centers]}">
       <DataGrid.Columns>
        <DataGridTextColumn x:Name="CenterColumn" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="UnitColumn" Binding="{Binding Unit}" Width="*" MinWidth="75" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="CostColumn" Binding="{Binding Cost}" Width="*" MinWidth="110" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="NumeratorColumn" Binding="{Binding Numerator}" Width="2*" MinWidth="130" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="DenominatorColumn" Binding="{Binding Denominator}" Width="2*" MinWidth="135" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="RateColumn" Binding="{Binding Rate}" Width="*" MinWidth="100" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Status}" Width="2*" MinWidth="125" ElementStyle="{StaticResource RateCell}"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
     <StackPanel>
      <TextBlock Text="{Binding SelectedRow.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="AnswersTable" ItemsSource="{Binding Answers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
       HeadersVisibility="Column" RowHeaderWidth="0" AutomationProperties.Name="{Binding [Answers]}">
       <DataGrid.Columns>
        <DataGridTextColumn x:Name="QuestionColumn" Binding="{Binding Question}" Width="2*" ElementStyle="{StaticResource RateCell}"/>
        <DataGridTextColumn x:Name="AnswerColumn" Binding="{Binding Answer}" Width="3*" ElementStyle="{StaticResource RateCell}"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
    <Expander Header="{Binding [Detail]}" Margin="0,14,0,8">
     <StackPanel>
      <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="DetailTable" ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding Source}" Width="*"/>
        <DataGridTextColumn x:Name="ComponentColumn" Binding="{Binding Component}" Width="*"/>
        <DataGridTextColumn x:Name="BehaviorColumn" Binding="{Binding Behavior}" Width="*"/>
        <DataGridTextColumn x:Name="AmountColumn" Binding="{Binding Cost}" Width="*"/>
        <DataGridTextColumn x:Name="BaseColumn" Binding="{Binding Base}" Width="*"/>
        <DataGridTextColumn x:Name="ComponentRateColumn" Binding="{Binding Rate}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding Provenance}" TextWrapping="Wrap" Margin="8"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel>

    <Button Content="{Binding [EditActivity]}" Click="EditActivity" Margin="0,0,8,6"/>
    <Button Content="{Binding [ViewCosts]}" Click="ViewCosts" Margin="0,0,8,6"/>
    <Button Content="{Binding [Export]}" Click="Export" IsEnabled="{Binding CanExport}" Margin="0,0,8,6"/>
    <Button Content="{Binding [Close]}" IsCancel="True" Click="CloseWindow" Margin="0,0,8,6"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</local:IntegratedWorkspaceWindow>
