<Window x:Class="Valdrio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="450"
        Width="760"
        MinHeight="380"
        MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding AppTitle}"
                   FontSize="34"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="{Binding HeaderSubtitle}"
                   FontSize="16" />

        <TextBlock Grid.Row="2"
                   Margin="0,4,0,0"
                   Text="{Binding SpecificationVersion}" />

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelStatus}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelSample}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SampleName}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LabelPurpose}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SamplePurpose}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding LabelSource}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SourcePath}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,18,0,0"
                   Text="{Binding FooterDevelopmentOnly}"
                   TextWrapping="Wrap"
                   FontStyle="Italic" />
    </Grid>
</Window>
