<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Height="860" Width="1280" MinHeight="620" MinWidth="760" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </Window.Resources>
 <Grid x:Name="ShellLayout">
  <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Sidebar.Width}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{DynamicResource Brand.DeepGreen}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel Margin="24,24,16,24">
      <TextBlock Text="{Binding AppTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brand.White}" />
      <TextBlock Text="{Binding HeaderSubtitle}" Margin="0,8,0,0" Foreground="{DynamicResource Brand.White}" FontSize="12" />
     </StackPanel>
     <TextBlock x:Name="NavigationGroupLabel" Margin="24,0,16,8" Foreground="{DynamicResource Brand.White}" FontSize="12" FontWeight="SemiBold" />
     <Expander x:Name="ProjectPhase" Foreground="{DynamicResource Brand.White}" Expanded="OnPhaseExpanded" Margin="8,0,8,4">
      <StackPanel>
       <Button x:Name="CompanyStep" Click="ChooseCompany" Style="{StaticResource Sidebar.Button}" />
       <Button x:Name="ModelStep" Click="ChooseModel" Style="{StaticResource Sidebar.Button}" />
      </StackPanel>
     </Expander>
     <Expander x:Name="AnalysisPhase" Foreground="{DynamicResource Brand.White}" Expanded="OnPhaseExpanded" Margin="8,0,8,4">
      <StackPanel>
       <Button x:Name="StudyStep" Click="ChooseStudy" Style="{StaticResource Sidebar.Button}" />
       <Button x:Name="ImportStep" Click="ChooseImport" Style="{StaticResource Sidebar.Button}" />
       <Button x:Name="ResourcesStep" Click="ChooseResources" Style="{StaticResource Sidebar.Button}" />
      </StackPanel>
     </Expander>
     <Expander x:Name="AllocationPhase" Foreground="{DynamicResource Brand.White}" Expanded="OnPhaseExpanded" Margin="8,0,8,4">
      <StackPanel>
       <Button x:Name="AllocationsStep" Click="ChooseAllocations" Style="{StaticResource Sidebar.Button}" />
       <Button x:Name="SecondaryStep" Click="ChooseSecondary" Style="{StaticResource Sidebar.Button}" />
      </StackPanel>
     </Expander>
     <Border BorderBrush="{DynamicResource Accent.ActiveGreen}" BorderThickness="0,1,0,0" Margin="16,16,16,8" />
     <Button x:Name="SettingsStep" Click="ChooseSettings" Style="{StaticResource Sidebar.Button}" />
    </StackPanel>
   </ScrollViewer>
  </Border>
  <DockPanel Grid.Column="1" LastChildFill="True">
   <Border DockPanel.Dock="Top" Background="{DynamicResource Brand.White}" BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1" Padding="{StaticResource Space.Page}">
    <StackPanel>
     <TextBlock x:Name="ProjectContextText" FontWeight="SemiBold" />
     <TextBlock x:Name="SaveLocation" Margin="0,4,0,0" FontSize="12" />
    </StackPanel>
   </Border>
   <!-- Fixed in the application shell: visible on every page while any
        company/workspace process reports busy. Unlike a page-local bar, it
        stays on screen while the central content scrolls. -->
   <ProgressBar x:Name="GlobalActivityBar" DockPanel.Dock="Top" Height="5"
                IsIndeterminate="True"
                Background="{DynamicResource Surface.Subtle}"
                Foreground="{DynamicResource Accent.ActiveGreen}"
                Visibility="{Binding Company.IsProcessing, Converter={StaticResource BooleanVisibility}}"
                AutomationProperties.Name="{Binding Company.WorkingLabel}"/>
  <StackPanel x:Name="ActionFooter" Margin="{StaticResource Space.Page}" DockPanel.Dock="Bottom">
   <TextBlock TextWrapping="Wrap" Height="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" x:Name="FieldHelpText" />
   <WrapPanel>
    <Button Click="PreviousStep" Padding="14,7" Margin="0,4,8,0" ContentTemplate="{StaticResource Button.WrappedText}" MaxWidth="{Binding ActualWidth, ElementName=ActionFooter}" x:Name="WorkflowBack" />
    <Button Style="{StaticResource Button.Primary}" Click="ContinueWorkflow" Padding="14,7" Margin="0,4,8,0" ContentTemplate="{StaticResource Button.WrappedText}" MaxWidth="{Binding ActualWidth, ElementName=ActionFooter}" x:Name="WorkflowNext" />
   </WrapPanel>
  </StackPanel>
  <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <Border Width="{Binding ViewportWidth, ElementName=RootScrollViewer}" MinWidth="648" Padding="{StaticResource Space.Page}">
   <Grid x:Name="MainContent">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
     <TextBlock x:Name="WorkflowTitle" Style="{StaticResource Text.Title}" />
     <TextBlock x:Name="WorkflowRequirement" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   <Border x:Name="ProjectTaskPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
    <StackPanel>
     <TextBlock x:Name="ProjectTaskTitle" FontSize="17" FontWeight="SemiBold" />
     <TextBlock x:Name="ProjectTaskHelp" Margin="0,4,0,8" Foreground="{DynamicResource Text.Primary}" />
     <WrapPanel>
      <Button x:Name="TaskStructureButton" Click="ChooseProjectStructure" Padding="12,7" Margin="0,4,8,4" />
      <Button x:Name="TaskAnalysisButton" Click="ChooseProjectAnalysis" Padding="12,7" Margin="0,4,8,4" />
      <Button x:Name="TaskContinueButton" Click="ContinueProjectWork" Padding="12,7" Margin="0,4,8,4" FontWeight="SemiBold" />
     </WrapPanel>
    </StackPanel>
   </Border>
    <local:CompanyFilePanel x:Name="CompanyPanel" Grid.Row="4" DataContext="{Binding Company}" />
    <local:ModelWorkspacePanel x:Name="ModelPanel" Grid.Row="6" DataContext="{Binding Models}" />
    <local:StudyWorkspacePanel x:Name="StudyPanel" Grid.Row="8" DataContext="{Binding Studies}" />
    <local:ResourceWorkspacePanel x:Name="ResourcePanel" Grid.Row="8" DataContext="{Binding Resources}" ShowDistributionTools="False" />
    <local:AllocationWorkspacePanel x:Name="AllocationPanel" Grid.Row="8" DataContext="{Binding Allocations}" />
    <local:SecondaryWorkspacePanel x:Name="SecondaryPanel" Grid.Row="8" DataContext="{Binding Allocations}" Visibility="Collapsed" />
    <Expander x:Name="DistributionDetails" Grid.Row="9" Header="{Binding Allocations[AccountDetails]}" Expanded="OpenDistributionDetails" Collapsed="CloseDistributionDetails">
     <StackPanel>
      <TextBlock Text="{Binding Allocations[AccountDetailsHelp]}" Margin="0,8,0,12"/>
      <Button x:Name="BackToAllocationKeysButton" Content="{Binding Allocations[BackToKeys]}"
              Click="BackToAllocationKeys" HorizontalAlignment="Left" Margin="0,0,0,10"/>
      <local:ResourceWorkspacePanel x:Name="DistributionResourcePanel" DataContext="{Binding Resources}"/>
      <Button x:Name="SaveDistributionButton" Content="{Binding Resources.NextAction}" Click="SaveDistributionDetails" Visibility="{Binding Resources.ShowParts, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding Resources.CanEdit}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Expander>
    <GroupBox Grid.Row="10" Header="{Binding PreferencesTitle}" Padding="16" x:Name="PreferencesPanel">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="220" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="10" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="10" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="10" />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelUiLanguage}" TextWrapping="Wrap" />
      <ComboBox local:FieldHelp.Key="SelectedUiLanguageTag" x:Name="UiLanguageSelector" Grid.Row="0" Grid.Column="1" MinWidth="200" ItemsSource="{Binding UiLanguageOptions}" SelectedItem="{Binding SelectedUiLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="0" AutomationProperties.Name="{Binding LabelUiLanguage}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFormatCulture}" TextWrapping="Wrap" />
      <ComboBox local:FieldHelp.Key="SelectedFormatCultureTag" x:Name="FormatCultureSelector" Grid.Row="2" Grid.Column="1" MinWidth="200" ItemsSource="{Binding FormatCultureOptions}" SelectedItem="{Binding SelectedFormatCultureTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" AutomationProperties.Name="{Binding LabelFormatCulture}" />
      <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelTimeZone}" TextWrapping="Wrap" />
      <ComboBox local:FieldHelp.Key="SelectedTimeZoneId" x:Name="TimeZoneSelector" Grid.Row="4" Grid.Column="1" MinWidth="280" ItemsSource="{Binding TimeZoneOptions}" SelectedItem="{Binding SelectedTimeZoneId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" AutomationProperties.Name="{Binding LabelTimeZone}" />
      <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Visibility="{Binding ShowPreferencesSaveWarning, Converter={StaticResource BooleanVisibility}}">
       <TextBlock Text="{Binding PreferencesSaveWarning}" Foreground="{DynamicResource Brand.Red}" AutomationProperties.LiveSetting="Polite" />
       <Button Content="{Binding RetrySavePreferencesLabel}" Command="{Binding RetrySavePreferencesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
      </StackPanel>
     </Grid>
    </GroupBox>
    <Expander x:Name="DevelopmentTools" Grid.Row="12" Header="{Binding DevelopmentToolsTitle}" TabIndex="100">
     <Grid Margin="0,12,0,0">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="14" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="14" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="14" />
       <RowDefinition Height="Auto" />
       <RowDefinition Height="14" />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox Grid.Row="0" Header="{Binding PreviewTitle}" Padding="16">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="220" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelMoneyPreview}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewMoney}" FontFamily="Consolas" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelDatePreview}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewDate}" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelInstantPreview}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewInstant}" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelCanonicalBusinessDate}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CanonicalBusinessDate}" FontFamily="Consolas" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelCanonicalUtcInstant}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CanonicalUtcInstant}" FontFamily="Consolas" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelResolvedLocalInstant}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ResolvedLocalInstant}" FontFamily="Consolas" FlowDirection="LeftToRight" />
       </Grid>
      </GroupBox>
      <GroupBox Grid.Row="2" Header="{Binding FxEditorTitle}" Padding="16">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxOriginal}" />
         <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FxOriginal}" FontFamily="Consolas" FlowDirection="LeftToRight" />
         <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxOrientation}" />
         <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FxOrientation}" FontFamily="Consolas" FlowDirection="LeftToRight" />
         <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxQuote}" />
         <TextBox x:Name="FxQuoteBox" Grid.Row="4" Grid.Column="1" Text="{Binding FxQuoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="OnFxQuoteGotKeyboardFocus" TabIndex="3" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding LabelFxQuote}" />
         <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxRateDate}" />
         <TextBox x:Name="FxRateDateBox" Grid.Row="6" Grid.Column="1" Text="{Binding FxRateDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="4" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding LabelFxRateDate}" />
         <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxRateSource}" />
         <TextBox x:Name="FxRateSourceBox" Grid.Row="8" Grid.Column="1" Text="{Binding FxRateSourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="5" AutomationProperties.Name="{Binding LabelFxRateSource}" />
         <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxFunctional}" />
         <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding FxFunctional}" FontFamily="Consolas" FlowDirection="LeftToRight" />
         <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxRounding}" />
         <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding FxRounding}" FontFamily="Consolas" FlowDirection="LeftToRight" />
         <TextBlock Grid.Row="14" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelFxRateSet}" />
         <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding FxRateSetVersion}" FontFamily="Consolas" FlowDirection="LeftToRight" />
         <Button x:Name="ApplyFxRateButton" Grid.Row="16" Grid.ColumnSpan="2" HorizontalAlignment="Left" Padding="14,7" Content="{Binding ActionApplyFxRate}" Command="{Binding ApplyFxRateCommand}" TabIndex="6" />
        </Grid>
        <TextBlock Margin="0,10,0,0" Text="{Binding FxStatus}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" Text="{Binding FxEditorExplanation}" TextWrapping="Wrap" />
       </StackPanel>
      </GroupBox>
      <GroupBox x:Name="T02RoundingGroup" Grid.Row="4" Header="{Binding RoundingTitle}" Padding="16">
       <StackPanel>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="{Binding LabelRoundingReference}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="1" Text="{Binding RoundingReferenceCase}" FlowDirection="LeftToRight" />
         <TextBlock Grid.Column="2" Text="{Binding LabelRoundingSource}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="3" Text="{Binding RoundingSourceTotal}" FlowDirection="LeftToRight" FontFamily="Consolas" />
         <TextBlock Grid.Column="4" Text="{Binding LabelRoundingQuantum}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="5" Text="{Binding RoundingQuantum}" FlowDirection="LeftToRight" FontFamily="Consolas" />
        </Grid>
        <Grid Margin="0,0,0,4">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="140" />
         </Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="{Binding LabelRoundingId}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="1" Text="{Binding LabelRoundingRaw}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="2" Text="{Binding LabelRoundingAdjustment}" FontWeight="SemiBold" />
         <TextBlock Grid.Column="3" Text="{Binding LabelRoundingPosted}" FontWeight="SemiBold" />
        </Grid>
        <ItemsControl ItemsSource="{Binding RoundingRows}">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="70" />
             <ColumnDefinition Width="280" />
             <ColumnDefinition Width="280" />
             <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding DestinationId}" FlowDirection="LeftToRight" />
            <TextBlock Grid.Column="1" Text="{Binding RawAmount}" FontFamily="Consolas" FlowDirection="LeftToRight" />
            <TextBlock Grid.Column="2" Text="{Binding RoundingAdjustment}" FontFamily="Consolas" FlowDirection="LeftToRight" />
            <TextBlock Grid.Column="3" Text="{Binding PostedAmount}" FontFamily="Consolas" FlowDirection="LeftToRight" />
           </Grid>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,10,0,0" Text="{Binding RoundingExplanation}" TextWrapping="Wrap" />
        <GroupBox Margin="0,14,0,0" Header="{Binding CurrencyMetadataTitle}" Padding="12">
         <StackPanel>
          <Grid Margin="0,0,0,4">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
           </Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="{Binding LabelCurrencyCode}" FontWeight="SemiBold" />
           <TextBlock Grid.Column="1" Text="{Binding LabelNumericCode}" FontWeight="SemiBold" />
           <TextBlock Grid.Column="2" Text="{Binding LabelMinorUnitDigits}" FontWeight="SemiBold" />
           <TextBlock Grid.Column="3" Text="{Binding LabelCurrencyQuantum}" FontWeight="SemiBold" />
           <TextBlock Grid.Column="4" Text="{Binding LabelCurrencyProjection}" FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding CurrencyMetadataRows}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
               <ColumnDefinition Width="90" />
               <ColumnDefinition Width="120" />
               <ColumnDefinition Width="160" />
               <ColumnDefinition Width="140" />
               <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding AlphaCode}" FontFamily="Consolas" FlowDirection="LeftToRight" />
              <TextBlock Grid.Column="1" Text="{Binding NumericCode}" FontFamily="Consolas" FlowDirection="LeftToRight" />
              <TextBlock Grid.Column="2" Text="{Binding MinorUnitDigits}" FlowDirection="LeftToRight" />
              <TextBlock Grid.Column="3" Text="{Binding Quantum}" FontFamily="Consolas" FlowDirection="LeftToRight" />
              <TextBlock Grid.Column="4" Text="{Binding ProjectedDistribution}" FontFamily="Consolas" FlowDirection="LeftToRight" />
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,8,0,0" Text="{Binding CurrencyMetadataExplanation}" TextWrapping="Wrap" />
         </StackPanel>
        </GroupBox>
       </StackPanel>
      </GroupBox>
      <GroupBox Grid.Row="6" Header="{Binding EditTitle}" Padding="16">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="220" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="8" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="10" />
         <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,16,0" Text="{Binding LabelPendingValue}" TextWrapping="Wrap" />
        <TextBox x:Name="PendingEditBox" Grid.Row="0" Grid.Column="1" Text="{Binding PendingEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="7" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding LabelPendingValue}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelCapturedCulture}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CapturedEditCulture}" FlowDirection="LeftToRight" />
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,16,0" Text="{Binding LabelEditStatus}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EditStatus}" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="6" Grid.ColumnSpan="2">
         <Button x:Name="StartEditButton" Margin="0,0,10,0" Padding="14,7" Content="{Binding ActionStartEdit}" Command="{Binding StartEditCommand}" TabIndex="8" />
         <Button x:Name="CommitEditButton" Padding="14,7" Content="{Binding ActionCommitEdit}" Command="{Binding CommitEditCommand}" TabIndex="9" />
        </WrapPanel>
       </Grid>
      </GroupBox>
      <Border Grid.Row="8" BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1" CornerRadius="6" Padding="14">
       <StackPanel>
        <TextBlock Text="{Binding FooterDevelopmentOnly}" TextWrapping="Wrap" FontStyle="Italic" />
        <TextBlock Margin="0,8,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Text="{Binding SampleName}" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
     </Grid>
    </Expander>
    <StackPanel Visibility="Collapsed" Grid.Row="8" x:Name="ImportHome">
     <TextBlock Text="{Binding Studies.Details}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Studies.ImportedAmounts}" TextWrapping="Wrap" Margin="0,8,0,8" />
     <Button Click="OpenAnotherImport" Content="{Binding AnotherImportLabel}" HorizontalAlignment="Left" Padding="12,7" Margin="0,6,0,8" />
    </StackPanel>
   </Grid>
   </Border>
  </ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
