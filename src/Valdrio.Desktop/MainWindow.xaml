<Window x:Class="Valdrio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VALDRIO - development shell"
        Height="430"
        Width="760"
        MinHeight="360"
        MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="VALDRIO"
                   FontSize="34"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="T01 · Windows/WPF development smoke"
                   FontSize="16" />

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SampleName}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Purpose" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SamplePurpose}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Source" FontWeight="SemiBold" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SourcePath}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,18,0,0"
                   Text="Development fixture only. No economic calculation or production persistence schema is implemented in T01."
                   TextWrapping="Wrap"
                   FontStyle="Italic" />
    </Grid>
</Window>
