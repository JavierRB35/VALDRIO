<Window x:Class="Valdrio.Desktop.AllocationReuseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="960" Height="650" MinWidth="640" MinHeight="470"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface.Canvas}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brand.DeepGreen}"/>
   <TextBlock Text="{Binding TargetLabel}" Margin="0,6" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding SourceLabel}"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="{Binding PreviewLabel}" Click="Preview" Margin="12,0,0,0"/>
    <ComboBox ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedItem="{Binding Source}" AutomationProperties.Name="{Binding SourceLabel}"/>
   </DockPanel>
  </StackPanel>
  <DataGrid x:Name="Table" Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Selector}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn x:Name="SelectorColumn" Binding="{Binding Selector}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn x:Name="KeyColumn" Binding="{Binding Item.KeyName}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Status}" IsReadOnly="True" Width="2*">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <CheckBox Content="{Binding ReplaceLabel}" IsChecked="{Binding ReplaceConflicts}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
   <WrapPanel><Button Content="{Binding AdoptLabel}" Click="Adopt" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="{Binding CancelLabel}" IsCancel="True"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
