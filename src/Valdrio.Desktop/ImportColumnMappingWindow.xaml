<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Valdrio.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Valdrio.Desktop.ImportColumnMappingWindow" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="1040" Height="780" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="WrappedHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="ContentTemplate">
    <Setter.Value>
     <DataTemplate>
      <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Margin="4"/>
     </DataTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WrappedCell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="3"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,4,8,4"/>
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,3,8,3"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
   <Setter Property="MinWidth" Value="145"/>
   <Setter Property="Margin" Value="0,3,12,3"/>
  </Style>
  <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,2,0,4"/>
  </Style>
  <Style x:Key="StepHelp" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="Requirement" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="Margin" Value="0,4,0,10"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="14">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{Binding Target}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding CurrencyImportNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,6"/>
   <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" AutomationProperties.LiveSetting="Polite" x:Name="ImportStepHelp"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock Text="{Binding UserStatus}" AutomationProperties.LiveSetting="Polite">
    <TextBlock.Style>
     <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="Foreground" Value="{DynamicResource Accent.ActiveGreen}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasUserError}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Red}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <TextBlock TextWrapping="Wrap" MinHeight="36" x:Name="ImportFieldHelp"/>
   <WrapPanel>
    <Button Click="PreviousImportStep" x:Name="ImportBack"/>
    <Button Click="NextImportStep" x:Name="ImportNext"/>
    <Button x:Name="ConfirmImportButton" Content="{Binding [ConfirmImport]}" Command="{Binding ConfirmCommand}" Style="{StaticResource Button.Primary}"/>
    <Button Content="{Binding [Cancel]}" Command="{Binding CancelCommand}"/>
    <Button x:Name="CloseMappingButton" Content="{Binding [Close]}" Click="CloseMapping" IsEnabled="{Binding IsIdle}"/>
   </WrapPanel>
  </StackPanel>
  <TabControl SelectionChanged="ImportStepChanged" x:Name="ImportSteps" IsEnabled="{Binding IsIdle}">
   <TabItem x:Name="ImportTab0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4,8,4,8">
      <TextBlock Text="{Binding [FileStepTitle]}" Style="{StaticResource StepTitle}"/>
      <TextBlock Text="{Binding [FileStepHelp]}" Style="{StaticResource StepHelp}"/>
      <WrapPanel>
       <Button x:Name="OpenSourceButton" Content="{Binding [Open]}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding [Open]}" FontWeight="SemiBold" Style="{StaticResource Button.Primary}"/>
       <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </WrapPanel>

      <StackPanel Visibility="{Binding IsXlsx,Converter={StaticResource Visible}}" IsEnabled="{Binding HasFile}">
       <TextBlock Text="{Binding [Worksheet]}"/>
       <ComboBox x:Name="WorksheetBox" ItemsSource="{Binding Worksheets}" SelectedItem="{Binding Worksheet}" AutomationProperties.Name="{Binding [Worksheet]}" MinWidth="260" HorizontalAlignment="Left" local:FieldHelp.Key="Worksheet"/>
      </StackPanel>

      <StackPanel IsEnabled="{Binding HasFile}">
       <TextBlock Text="{Binding [AmountMode]}" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <TextBlock Text="{Binding [AmountModeChoiceHint]}" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
        <ComboBox x:Name="AmountModeBox" ItemsSource="{Binding AmountModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AmountMeaningSelection,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [AmountMode]}" local:FieldHelp.Key="AmountMode" SelectionChanged="AmountMeaningChanged" MinWidth="300" HorizontalAlignment="Left"/>
      </StackPanel>

      <Expander Header="{Binding [FileAdvanced]}" IsEnabled="{Binding HasFile}" Margin="0,8,0,4">
       <StackPanel Margin="8,4,0,0">
        <TextBlock Text="{Binding [FileAdvancedHelp]}" Style="{StaticResource StepHelp}"/>
        <WrapPanel>
         <StackPanel>
          <TextBlock Text="{Binding [HeaderRow]}"/>
          <TextBox x:Name="HeaderRowBox" Width="120" HorizontalAlignment="Left" Text="{Binding HeaderRow,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [HeaderRow]}" Margin="0,3,12,3" local:FieldHelp.Key="HeaderRow"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="{Binding [FirstDataRow]}"/>
          <TextBox x:Name="FirstDataRowBox" Width="140" HorizontalAlignment="Left" Text="{Binding FirstDataRow,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [FirstDataRow]}" Margin="0,3,12,3" local:FieldHelp.Key="FirstDataRow"/>
         </StackPanel>
        </WrapPanel>
        <WrapPanel Visibility="{Binding IsCsv,Converter={StaticResource Visible}}">
         <StackPanel>
          <TextBlock Text="{Binding [Delimiter]}"/>
          <ComboBox x:Name="DelimiterBox" ItemsSource="{Binding Delimiters}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Delimiter}" AutomationProperties.Name="{Binding [Delimiter]}" local:FieldHelp.Key="Delimiter"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="{Binding [Encoding]}"/>
          <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding Encoding}" AutomationProperties.Name="{Binding [Encoding]}" local:FieldHelp.Key="Encoding"/>
         </StackPanel>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <Expander x:Name="ImportAdvancedOptions" Header="{Binding [AdvancedOptions]}" IsEnabled="{Binding HasFile}" Margin="0,8,0,4">
       <StackPanel Margin="8,4,0,0">
      <Expander Header="{Binding [ReplaceAdvancedTitle]}" Margin="0,6,0,8">
       <StackPanel Margin="8,4,0,0">
        <CheckBox x:Name="ReplaceBatchBox" Content="{Binding [ReplaceBatch]}" IsChecked="{Binding ReplaceBatch}" local:FieldHelp.Key="ReplaceBatch"/>
        <ComboBox x:Name="ReplacementBox" ItemsSource="{Binding ExistingBatches}" DisplayMemberPath="Label" SelectedItem="{Binding Replacement}" IsEnabled="{Binding ReplaceBatch}" AutomationProperties.Name="{Binding [ReplaceBatch]}" local:FieldHelp.Key="Replacement"/>
        <TextBlock Text="{Binding [ReplacementHelp]}"/>
       </StackPanel>
      </Expander>


      <TextBlock Text="{Binding AmountBasis}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <Expander x:Name="ComparisonPanel" Header="{Binding [ComparisonTitle]}" Visibility="{Binding IsCumulativeMode,Converter={StaticResource Visible}}">
       <StackPanel>
        <TextBlock Text="{Binding [ComparisonHelp]}"/>
        <TextBlock Text="{Binding [FiscalStart]}"/>
        <local:CalendarDatePicker x:Name="FiscalStartPicker" SelectedDate="{Binding FiscalStart}" Language="{Binding DateLanguageTag,ConverterCulture=en-US}" local:FieldHelp.Key="FiscalStart"/>
        <TextBlock Text="{Binding [FiscalEnd]}"/>
        <local:CalendarDatePicker x:Name="FiscalEndPicker" SelectedDate="{Binding FiscalEnd}" Language="{Binding DateLanguageTag,ConverterCulture=en-US}" local:FieldHelp.Key="FiscalEnd"/>
        <TextBlock Text="{Binding [PreviousEnd]}"/>
        <local:CalendarDatePicker x:Name="PreviousEndPicker" SelectedDate="{Binding PreviousEnd}" Language="{Binding DateLanguageTag,ConverterCulture=en-US}" local:FieldHelp.Key="PreviousEnd"/>
        <TextBlock Text="{Binding [ComparisonScope]}"/>
        <TextBox x:Name="ComparisonScopeBox" Text="{Binding ComparisonScope,UpdateSourceTrigger=PropertyChanged}" local:FieldHelp.Key="ComparisonScope"/>
        <WrapPanel>
         <Button x:Name="FreezeComparisonButton" Content="{Binding [FreezeComparison]}" Command="{Binding FreezeComparisonCommand}"/>
         <Button Content="{Binding [ClearComparison]}" Command="{Binding ClearComparisonCommand}"/>
        </WrapPanel>
        <TextBlock Text="{Binding ComparisonStatus}" FontWeight="SemiBold"/>
       </StackPanel>
      </Expander>
       </StackPanel>
      </Expander>

      <TextBlock Text="{Binding FileStepRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="ReadSourceButton" Content="{Binding [Read]}" Command="{Binding ReadCommand}" Visibility="Collapsed"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="ImportTab1" IsEnabled="{Binding HasColumns}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4,8,4,8">
      <TextBlock Text="{Binding [ColumnsStepTitle]}" Style="{StaticResource StepTitle}"/>
      <TextBlock Text="{Binding [ColumnsStepHelp]}" Style="{StaticResource StepHelp}"/>

      <StackPanel IsEnabled="{Binding HasColumns}">
       <TextBlock Text="{Binding [AmountLayout]}"/>
       <ComboBox x:Name="AmountLayoutBox" ItemsSource="{Binding AmountLayouts}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AmountLayout}" AutomationProperties.Name="{Binding [AmountLayout]}" HorizontalAlignment="Left" MinWidth="300" local:FieldHelp.Key="AmountLayout"/>
      </StackPanel>

      <WrapPanel IsEnabled="{Binding HasColumns}">
       <StackPanel Width="360">
        <TextBlock Text="{Binding [AccountColumn]}"/>
        <ComboBox x:Name="AccountColumnBox" ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding AccountColumn}" AutomationProperties.Name="{Binding [AccountColumn]}" local:FieldHelp.Key="AccountColumn">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
          <Style.Triggers><DataTrigger Binding="{Binding MissingAccountColumn}" Value="True">
           <Setter Property="Tag" Value="error"/>
          </DataTrigger></Style.Triggers>
         </Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
       <StackPanel Width="360">
        <TextBlock Text="{Binding [DescriptionColumn]}"/>
        <ComboBox x:Name="DescriptionColumnBox" ItemsSource="{Binding DescriptionColumns}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding DescriptionColumn}" AutomationProperties.Name="{Binding [DescriptionColumn]}" local:FieldHelp.Key="DescriptionColumn"/>
       </StackPanel>
       <StackPanel Width="360" Visibility="{Binding IsSignedAmount,Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding [AmountColumn]}"/>
        <ComboBox x:Name="AmountColumnBox" ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding AmountColumn}" AutomationProperties.Name="{Binding [AmountColumn]}" local:FieldHelp.Key="AmountColumn">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
          <Style.Triggers><DataTrigger Binding="{Binding MissingAmountColumn}" Value="True">
           <Setter Property="Tag" Value="error"/>
          </DataTrigger></Style.Triggers>
         </Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
       <StackPanel Width="290" Visibility="{Binding IsDebitCredit,Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding [DebitColumn]}"/>
        <ComboBox x:Name="DebitColumnBox" ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding DebitColumn}" AutomationProperties.Name="{Binding [DebitColumn]}" local:FieldHelp.Key="DebitColumn">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
          <Style.Triggers><DataTrigger Binding="{Binding MissingDebitColumn}" Value="True">
           <Setter Property="Tag" Value="error"/>
          </DataTrigger></Style.Triggers>
         </Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
       <StackPanel Width="290" Visibility="{Binding IsDebitCredit,Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding [CreditColumn]}"/>
        <ComboBox x:Name="CreditColumnBox" ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding CreditColumn}" AutomationProperties.Name="{Binding [CreditColumn]}" local:FieldHelp.Key="CreditColumn">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Input.Combo}">
          <Style.Triggers><DataTrigger Binding="{Binding MissingCreditColumn}" Value="True">
           <Setter Property="Tag" Value="error"/>
          </DataTrigger></Style.Triggers>
         </Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding [DebitCreditHelp]}" Visibility="{Binding IsDebitCredit,Converter={StaticResource Visible}}"/>

      <Expander x:Name="NumberFormatPanel" IsExpanded="True" Header="{Binding [NumberAdvanced]}" IsEnabled="{Binding HasColumns}" Margin="0,6,0,4">
       <StackPanel Margin="8,4,0,0">
        <TextBlock Text="{Binding [NumberAdvancedHelp]}" Style="{StaticResource StepHelp}"/>
        <WrapPanel>
         <StackPanel>
          <TextBlock Text="{Binding [Decimal]}"/>
          <ComboBox ItemsSource="{Binding DecimalSeparators}" SelectedItem="{Binding DecimalSeparator}" AutomationProperties.Name="{Binding [Decimal]}" local:FieldHelp.Key="DecimalSeparator"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="{Binding [Grouping]}"/>
          <ComboBox ItemsSource="{Binding GroupSeparators}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GroupSeparator}" AutomationProperties.Name="{Binding [Grouping]}" local:FieldHelp.Key="GroupSeparator"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="{Binding [Negative]}"/>
          <ComboBox ItemsSource="{Binding NegativeSyntaxes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NegativeSyntax}" AutomationProperties.Name="{Binding [Negative]}" local:FieldHelp.Key="NegativeSyntax"/>
         </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding [NumberHelp]}"/>
        <CheckBox x:Name="NumericAccountsBox" Content="{Binding [NumericAccounts]}" IsChecked="{Binding AllowNumericAccounts}" Visibility="{Binding IsXlsx,Converter={StaticResource Visible}}" Margin="0,6,0,6" local:FieldHelp.Key="AllowNumericAccounts"/>
        <TextBlock Text="{Binding [NumericWarning]}" Visibility="{Binding IsXlsx,Converter={StaticResource Visible}}"/>
       </StackPanel>
      </Expander>

      <TextBlock Text="{Binding ColumnStepRequirement}" Style="{StaticResource Requirement}" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="ValidateMappingButton" Content="{Binding [Validate]}" Command="{Binding ValidateCommand}" Visibility="Collapsed"/>

      <TextBlock Text="{Binding FriendlySummary}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding [PreviewHelp]}"/>
      <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="Auto" MinHeight="280" MaxHeight="590" FlowDirection="LeftToRight" EnableRowVirtualization="True">
       <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Setter Property="ContentTemplate">
          <Setter.Value>
           <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3"/>
           </DataTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </DataGrid.ColumnHeaderStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Row}" Width="65"/>
        <DataGridTextColumn Binding="{Binding Account}" Width="155"/>
        <DataGridTextColumn Binding="{Binding OriginalAmount}" Width="155"/>
        <DataGridTextColumn Binding="{Binding OriginalDebit}" Width="155" Visibility="Collapsed"/>
        <DataGridTextColumn Binding="{Binding OriginalCredit}" Width="155" Visibility="Collapsed"/>
        <DataGridTextColumn Binding="{Binding ParsedAmount}" Width="155"/>
        <DataGridTextColumn Binding="{Binding Issues}" Width="*"/>
        <DataGridTextColumn Binding="{Binding Description}" Width="230" DisplayIndex="2"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding FriendlyGlobalIssues}" Foreground="{DynamicResource Brand.Red}" FontWeight="SemiBold"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="ImportTab2" IsEnabled="{Binding IsReady}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4,8,4,8">
      <TextBlock Text="{Binding [RecordsStepTitle]}" Style="{StaticResource StepTitle}"/>
      <TextBlock Text="{Binding [RecordsStepHelp]}" Style="{StaticResource StepHelp}"/>
      <StackPanel Visibility="{Binding HasAccountChoices,Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding [SelectAccounts]}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding [AccountSelectionHelp]}"/>
       <WrapPanel>
        <Button x:Name="SelectAllRecordsButton" Content="{Binding [SelectAllRecords]}" Command="{Binding SelectAllRecordsCommand}"/>
        <Button x:Name="DeselectAllRecordsButton" Content="{Binding [DeselectAllRecords]}" Command="{Binding DeselectAllRecordsCommand}"/>
       </WrapPanel>
       <DataGrid local:FieldHelp.Key="Records" x:Name="AccountSelectionGrid" ItemsSource="{Binding AccountChoices}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="230" FlowDirection="LeftToRight" EnableRowVirtualization="True" AutomationProperties.Name="{Binding [SelectAccounts]}">
        <DataGrid.Columns>
         <DataGridTemplateColumn Width="95">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <CheckBox IsChecked="{Binding Included,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Account}"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Binding="{Binding RecordNumber}" IsReadOnly="True" Width="70"/>
         <DataGridTextColumn Binding="{Binding Account}" IsReadOnly="True" Width="135"/>
         <DataGridTextColumn Binding="{Binding Description}" IsReadOnly="True" Width="2*"/>
         <DataGridTextColumn Binding="{Binding FormattedAmount}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource Text.TableNumber}" SortMemberPath="Amount"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="{Binding AccountSelectionSummary}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding [SelectionPreviewTitle]}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding [SelectionPreviewHelp]}"/>
       <TextBlock x:Name="SelectionReconciliationText" Text="{Binding SelectionReconciliation}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
       <DataGrid x:Name="SelectionPreviewGrid" ColumnHeaderStyle="{StaticResource WrappedHeader}" CanUserSortColumns="True" GridLinesVisibility="Vertical" VerticalGridLinesBrush="{DynamicResource Border.Soft}" ItemsSource="{Binding SelectionPreview}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="170" FlowDirection="LeftToRight" EnableRowVirtualization="True" AutomationProperties.Name="{Binding [SelectionPreviewTitle]}">
        <DataGrid.Columns>
         <DataGridTextColumn Binding="{Binding Code}" Width="135"/>
         <DataGridTextColumn Binding="{Binding Description}" Width="2*"/>
          <DataGridTextColumn Binding="{Binding Records}" Width="*"/>
         <DataGridTextColumn Binding="{Binding Amount}" SortMemberPath="NumericAmount" Width="*" ElementStyle="{StaticResource Text.TableNumber}"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="ImportTab3" IsEnabled="{Binding CanOpenReview}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4,8,4,8">
      <TextBlock Text="{Binding [ReviewStepTitle]}" Style="{StaticResource StepTitle}"/>
      <TextBlock Text="{Binding [ReviewStepHelp]}" Style="{StaticResource StepHelp}"/>
      <TextBlock Text="{Binding ReviewSaveRequirement}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel x:Name="ConversionPreviewPanel" Visibility="{Binding HasConversion,Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding [ConversionPreview]}" FontWeight="SemiBold"/>
       <DataGrid x:Name="ConversionGrid" ItemsSource="{Binding ConversionRows}" AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource WrappedHeader}" IsReadOnly="True" CanUserAddRows="False" Height="220" FlowDirection="LeftToRight">
        <DataGrid.Columns>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding Record}" Width="100"/>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding DocumentDate}" Width="110"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Original}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource Text.TableNumber}" Binding="{Binding Converted}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding Rate}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding RateDate}" Width="110"/>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding Source}" Width="*"/>
         <DataGridTextColumn ElementStyle="{StaticResource WrappedCell}" Binding="{Binding Adjustment}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="{Binding ConversionTotals}" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="ConfirmationSummaryText" Text="{Binding ConfirmationSummary}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding PreparationIssues}" Foreground="{DynamicResource Brand.Red}"/>
      <DataGrid x:Name="ComparisonGrid" ColumnHeaderStyle="{StaticResource WrappedHeader}" CanUserSortColumns="True" GridLinesVisibility="Vertical" VerticalGridLinesBrush="{DynamicResource Border.Soft}" ItemsSource="{Binding ComparisonRows}" Visibility="{Binding HasComparisonRows,Converter={StaticResource Visible}}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" FlowDirection="LeftToRight">
       <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Code}" Width="*"/>
        <DataGridTextColumn Binding="{Binding Description}" Width="2*"/>
         <DataGridTextColumn Binding="{Binding Earlier}" Width="*"/>
        <DataGridTextColumn Binding="{Binding Current}" Width="*" ElementStyle="{StaticResource Text.TableNumber}"/>
        <DataGridTextColumn Binding="{Binding Difference}" Width="*" ElementStyle="{StaticResource Text.TableNumber}"/>
        <DataGridTextColumn Binding="{Binding EarlierRecords}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Visibility="{Binding HasPreparedGroups,Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding [GroupedPreview]}" FontWeight="SemiBold"/>
       <DataGrid x:Name="GroupedPreviewGrid" ColumnHeaderStyle="{StaticResource WrappedHeader}" CanUserSortColumns="True" GridLinesVisibility="Vertical" VerticalGridLinesBrush="{DynamicResource Border.Soft}" ItemsSource="{Binding PreparedGroups}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="170" FlowDirection="LeftToRight" EnableRowVirtualization="True">
        <DataGrid.Columns>
         <DataGridTextColumn Binding="{Binding Code}" Width="135"/>
         <DataGridTextColumn Binding="{Binding Description}" Width="2*"/>
         <DataGridTextColumn Binding="{Binding Records}" Width="*"/>
         <DataGridTextColumn Binding="{Binding Amount}" SortMemberPath="NumericAmount" Width="*" ElementStyle="{StaticResource Text.TableNumber}"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>

            <Expander Header="{Binding [ApprovalReference]}"><StackPanel><TextBlock Text="{Binding [ApprovalReference]}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding [ApprovalReferenceHelp]}" Style="{StaticResource StepHelp}"/>
      <TextBox x:Name="ApprovalReferenceBox" Text="{Binding ApprovalReference,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="{Binding [ApprovalReference]}" local:FieldHelp.Key="ApprovalReference"/>
      </StackPanel></Expander><CheckBox Visibility="{Binding ShowReviewApproval,Converter={StaticResource Visible}}" x:Name="ApproveInterpretationBox" IsChecked="{Binding InterpretationApproved}" Margin="0,8,0,8" local:FieldHelp.Key="InterpretationApproved">
       <TextBlock Text="{Binding InterpretationPrompt}" TextWrapping="Wrap"/>
      </CheckBox>

     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
